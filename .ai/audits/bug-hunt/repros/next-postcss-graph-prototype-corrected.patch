+import { createRequire } from 'node:module'
+
+interface Context {
+  getOptions(): { loader: string, options: object }
+  callback(error: Error | null, css?: string, map?: object | string, meta?: object): void
+}
+
+/** Preserve the host's options closure and avoid reprocessing published wrappers. */
+export default function postcssDispatcher(this: Context, css: string, map?: object | string, meta?: { masterPostCSSProcessed?: boolean }) {
+  if (meta?.masterPostCSSProcessed) return this.callback(null, css, map, meta)
+  const options = this.getOptions()
+  const host = Object.create(this) as Context
+  host.getOptions = () => options.options as ReturnType<Context['getOptions']>
+  const implementation = createRequire(import.meta.url)(options.loader)
+  return (implementation.default ?? implementation).call(host, css, map, meta)
+}
