      "text": "{\"version\":3,\"sources\":[\"webpack://_N_E/file:/Users/aron/master/css/.ai/audits/bug-hunt/tmp/master-next-copy-3z8i_q4c/packages/preset/src/base.css\",\"webpack://_N_E/eec42f315592621e450fd727eb5f4f99e329cc3d794bc044f3c9f5325deada5b-bd49b92ca4f12d72424e2b5689ea228d8d6412a299c94edf9932b9b8ae026de9.css\"],\"names\":[],\"mappings\":\"AAAA,YAAA,CAAA,YAIE,ECAE,iCACF,CDIA,KCDE,6BAA8B,CAC9B,0BAA2B,CAC3B,yBAA0B,CAC1B,qBAAsB,CACtB,iCAAkC,CAClC,kCAAmC,CACnC,eACF,CDKA,SCFE,yBACF,CDMA,2CCHE,wBAAyB,CACzB,gBACF,CDQA,iBCLE,qBACF,CDSA,KCNE,eAAgB,CAChB,UACF,CDUA,+CCPE,cAAe,CACf,aACF,CDaA,UCVE,qBACF,CDgBA,YCbE,gCACF,CDiBA,SCdE,kBACF,CDkBA,kBCfE,aACF,CDsBA,mBCnBE,iBAAkB,CAClB,SACF,CDuBA,iBCpBE,eACF,CDwBA,SCrBE,uBACF,CDyBA,cCtBE,oBAAqB,CACrB,mBACF,CD0BA,wDCvBE,WACF,CD2BA,4BCxBE,uBACF,CD4BA,6BCzBE,yBAA0B,CAC1B,YACF,CD6BA,GC1BE,QAAS,CACT,aACF,CD8BA,MC3BE,aACF,CD+BA,QC5BE,uBAAwB,CACxB,aAAc,CACd,aAAc,CACd,iBACF,CDgCA,IC7BE,aACF,CDiCA,IC9BE,SACF,CDkCA,MC/BE,aAAc,CACd,oBACF,CDmCA,WChCE,mCAAoC,CACpC,qDACF,CDoCA,kBCjCE,mCAAoC,CACpC,qDACF,CDuCA,ECpCE,aAAc,CACd,oBACF,CDwCA,sCCrCE,YAAa,CACb,6BAA8B,CAC9B,+BAAgC,CAChC,aAAc,CACd,sBAAuB,CACvB,QAAS,CACT,SAAU,CACV,cACF,CDyCA,iBCtCE,kBAAmB,CACnB,cACF,CD0CA,wDCvCE,QACF,CDgDA,yBC7CE,SAMF,CDuCA,MCzCE,QAEF,CD6CA,KC1CE,uCACF,CD8CA,GC3CE,eACF,CD+CA,kBC5CE,iBAAkB,CAClB,mBACF,CDgDA,SC7CE,YACF,CACF,CDhLA,sCAAA\",\"file\":\"static/css/master/a2b14bdbaf673b1888a5c5c1cc52e3d02fc48d74df300bb6a9d14ffdfecd36ab/maps/eec42f315592621e450fd727eb5f4f99e329cc3d794bc044f3c9f5325deada5b-bd49b92ca4f12d72424e2b5689ea228d8d6412a299c94edf9932b9b8ae026de9.css\",\"sourcesContent\":[\"@layer theme, base, defaults, components, utilities;\\n\\n@layer base {\\n  /* Improve text rendering precision across browsers. */\\n  * {\\n    text-rendering: geometricPrecision;\\n  }\\n\\n  /* Normalize body text metrics and font smoothing. */\\n  body {\\n    line-height: 1.2;\\n    text-size-adjust: 100%;\\n    -webkit-text-size-adjust: 100%;\\n    -moz-text-size-adjust: 100%;\\n    -ms-text-size-adjust: 100%;\\n    -moz-osx-font-smoothing: grayscale;\\n    -webkit-font-smoothing: antialiased;\\n  }\\n\\n  /* Remove touch delay from common interactive elements. */\\n  a, button {\\n    touch-action: manipulation;\\n  }\\n\\n  /* Prevent accidental text selection on button-like controls. */\\n  [role=button], summary,\\n  button, [type=button] {\\n    -webkit-user-select: none;\\n    user-select: none;\\n  }\\n\\n  /* Use border-box sizing for all elements and pseudo-elements. */\\n  *, ::before, ::after {\\n    box-sizing: border-box;\\n  }\\n\\n  /* Normalize tab width for readable preformatted text. */\\n  body {\\n    -moz-tab-size: 2;\\n    tab-size: 2;\\n  }\\n\\n  /* Make embedded media responsive and block-level by default. */\\n  img, svg, video, canvas, audio, iframe, embed, object {\\n    max-width: 100%;\\n    display: block;\\n  }\\n\\n  /* consistent */\\n\\n  /* Keep the root viewport height consistent on modern and WebKit browsers. */\\n  html, body {\\n    height: 100dvh;\\n    height: -webkit-fill-available;\\n    height: -moz-available;\\n  }\\n\\n  /* Ensure abbreviated text with titles has a consistent underline style. */\\n  abbr[title] {\\n    text-decoration: underline dotted;\\n  }\\n\\n  /* Keep bold text semantically stronger than surrounding text. */\\n  b, strong {\\n    font-weight: bolder;\\n  }\\n\\n  /* Normalize monospace-related element sizing. */\\n  pre,\\n  code,\\n  kbd,\\n  samp {\\n    font-size: 1em;\\n  }\\n\\n  /* Remove Firefox inner focus padding and border from controls. */\\n  ::-moz-focus-inner {\\n    border-style: none;\\n    padding: 0;\\n  }\\n\\n  /* Remove Firefox invalid field shadows. */\\n  :-moz-ui-invalid {\\n    box-shadow: none;\\n  }\\n\\n  /* Align progress elements consistently with surrounding text. */\\n  progress {\\n    vertical-align: baseline;\\n  }\\n\\n  /* Normalize search input appearance and outline offset. */\\n  [type=\\\"search\\\"] {\\n    appearance: textfield;\\n    outline-offset: -2px;\\n  }\\n\\n  /* Keep WebKit number input spin buttons at their native height. */\\n  ::-webkit-inner-spin-button, ::-webkit-outer-spin-button {\\n    height: auto;\\n  }\\n\\n  /* Remove WebKit search input decoration. */\\n  ::-webkit-search-decoration {\\n    -webkit-appearance: none;\\n  }\\n\\n  /* Normalize WebKit file upload button appearance and font. */\\n  ::-webkit-file-upload-button {\\n    -webkit-appearance: button;\\n    font: inherit;\\n  }\\n\\n  /* Normalize horizontal rule size and color inheritance. */\\n  hr {\\n    height: 0;\\n    color: inherit;\\n  }\\n\\n  /* Normalize small text sizing. */\\n  small {\\n    font-size: 80%;\\n  }\\n\\n  /* Normalize superscript and subscript sizing and positioning context. */\\n  sub, sup {\\n    font-size: 75%;\\n    line-height: 0;\\n    position: relative;\\n    vertical-align: baseline;\\n  }\\n\\n  /* Position subscripts consistently below the baseline. */\\n  sub {\\n    bottom: -0.25em;\\n  }\\n\\n  /* Position superscripts consistently above the baseline. */\\n  sup {\\n    top: -0.5em;\\n  }\\n\\n  /* Normalize table indentation and border color inheritance. */\\n  table {\\n    text-indent: 0;\\n    border-color: inherit;\\n  }\\n\\n  /* Apply the default sans font stack to documents and shadow hosts. */\\n  body, :host {\\n    font-family: var(--font-family-sans);\\n    font-feature-settings: var(--font-feature-sans, normal);\\n  }\\n\\n  /* Apply the default monospace font stack to code-related elements. */\\n  code, kbd, samp, pre {\\n    font-family: var(--font-family-mono);\\n    font-feature-settings: var(--font-feature-mono, normal);\\n  }\\n\\n  /* remove */\\n\\n  /* Remove default link color and underline styles. */\\n  a {\\n    color: inherit;\\n    text-decoration: none;\\n  }\\n\\n  /* Reset form control typography, spacing, color, and background. */\\n  button, input, optgroup, select, textarea {\\n    font: inherit;\\n    font-feature-settings: inherit;