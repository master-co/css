---
import Document from '../layouts/Document.astro'
import RouteLayers from '~/site/docs-shell/components/RouteLayers.astro'
import NotFound from '~/site/docs-shell/components/NotFound.astro'
import { withSection } from '~/site/routes'
import i18n from '~/site/docs-shell/common/i18n.config.js'

const route = await withSection('brand', { robots: 'noindex' }, [NotFound], { params: { locale: i18n.defaultLocale } }, [], false)
---

<Document metadata={route.metadata} assets={route.assets} bodyClass={route.bodyClass} locales={route.locales}>
  <RouteLayers layers={route.layers} props={route.props} />
</Document>
