---
import '@master/css-language-service/shiki.css'
import Layout from '@master/internal-site/layouts/Doc.astro'
import { footerProps } from '~/site/navigation'

type Props = import('astro/types').ComponentProps<typeof Layout>

const { class: className, ...props } = Astro.props
---

<Layout {...props} class={props.metadata.pathname?.startsWith('/reference') ? 'reference-document' : className} footerProps={footerProps}><slot /></Layout>
