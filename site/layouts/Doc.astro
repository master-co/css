---
import '@master/css-language-service/shiki.css'
import Layout from '@master/internal-site/layouts/Doc.astro'
import { siteOf } from '@master/internal-site/astro/site-context'
import { localizePathname } from '@master/internal-site/utils/i18n-pathname.ts'
import { footerProps } from '~/site/navigation'

type Props = import('astro/types').ComponentProps<typeof Layout>

const { class: className, ...props } = Astro.props
const { pathname, locale, i18n } = siteOf(Astro)
const referencePathname = localizePathname('/reference', { ...i18n, locale })
const isReference = pathname === referencePathname || pathname.startsWith(referencePathname + '/')
---

<Layout {...props} class:list={[className, { 'reference-document': isReference }]} footerProps={footerProps}><slot /></Layout>
