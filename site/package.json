{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-app": "tsx ./prepare",
    "resolve-public-env": "tsx scripts/resolve-public-env.ts --fetch-tags --write .generated/public-env.json",
    "clean:next": "rm -rf .next",
    "dev": "pnpm clean:next && pnpm prepare-app && pnpm build:play-compiler && next dev --turbo",
    "build": "pnpm resolve-public-env && pnpm prepare-app && pnpm build:llms && pnpm build:play-compiler && pnpm build:next && pnpm postbuild:static",
    "build:cloudflare-pages": "pnpm build",
    "build:next": "cross-env NODE_OPTIONS=--max-old-space-size=16384 MASTER_CSS_PUBLIC_ENV_FILE=.generated/public-env.json next build --turbo",
    "build:llms": "tsx scripts/generate-llms-txt.ts",
    "build:play-compiler": "tsx scripts/build-play-compiler.ts",
    "postbuild:static": "tsx scripts/postbuild-static.tsx",
    "translate:site": "tsx scripts/translate-site.ts",
    "audit:i18n": "tsx scripts/audit-i18n.ts",
    "preview:cloudflare-pages": "pnpm build:cloudflare-pages && wrangler pages dev site/out --cwd .. --kv PLAY_SHARES",
    "cf-typegen": "wrangler types site/cloudflare-env.d.ts --cwd .. --env-interface CloudflareEnv",
    "test:image-loader": "tsx --test utils/cloudflare-image-loader.test.ts",
    "test:public-env": "tsx --test utils/public-env.test.ts",
    "test:play": "tsx --test app/api/play/_lib/route-handlers.test.ts app/api/play/_lib/compile-play-css.test.ts app/api/play/_lib/preview-script.test.ts",
    "test:llms": "tsx --test scripts/generate-llms-txt.test.ts",
    "test:docs-examples": "tsx --test scripts/validate-doc-examples.test.ts",
    "test:css-contract": "tsx --test scripts/css-variable-references.test.ts && tsx scripts/verify-css-contract.ts",
    "update:css-contract": "tsx scripts/verify-css-contract.ts --update",
    "test:dogfood": "playwright test --config tests/dogfood/playwright.config.ts",
    "test:dogfood:dev": "playwright test --config tests/dogfood/playwright.dev.config.ts",
    "test:syntax": "tsx --test components/SyntaxTr.test.ts",
    "start": "wrangler pages dev site/out --cwd .. --kv PLAY_SHARES",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@master/css": "workspace:^",
    "@master/css-compiler": "workspace:^",
    "@master/css-tooling": "workspace:^",
    "@master/css-preset": "workspace:^",
    "@master/css-schema": "workspace:^",
    "@master/theme-mode.react": "^1.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@next/mdx": "^16.2.10",
    "@tabler/icons-react": "^3.44.0",
    "acorn": "^8.17.0",
    "class-variant": "^2.0.6",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdxjs-esm": "^3.0.0",
    "nanoid": "^5.1.15",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.2.0",
    "theme-mode": "^1.1.1",
    "ts-dedent": "^2.3.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/config-helpers": "^0.6.0",
    "@master/css-build-internal": "workspace:^",
    "@master/css-next": "workspace:^",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
    "internal": "workspace:^",
    "tsdown": "^0.22.4",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "wrangler": "4.103.0"
  }
}
