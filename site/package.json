{
    "name": "site",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare-app": "tsx --env-file=.env ./prepare",
        "dev": "rm -rf .next && pnpm build:next-adapter && pnpm prepare-app && next dev --turbo",
        "build": "pnpm prepare-app && pnpm build:llms && pnpm build:repo && pnpm build:next",
        "build:cloudflare-next": "pnpm prepare-app && pnpm build:llms && pnpm build:repo && pnpm build:next",
        "build:cloudflare-workers": "opennextjs-cloudflare build --skipWranglerConfigCheck",
        "build:repo": "cd ../ && pnpm build && cd site",
        "build:next-adapter": "cd ../ && pnpm --filter @master/css.next... build && cd site",
        "build:next": "cross-env NODE_OPTIONS=--max-old-space-size=16384 next build --turbo",
        "build:llms": "tsx scripts/generate-llms-txt.ts",
        "preview:cloudflare-workers": "pnpm build:cloudflare-workers && opennextjs-cloudflare preview",
        "deploy:cloudflare-workers": "pnpm build:cloudflare-workers && opennextjs-cloudflare deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "test:play": "tsx --test app/api/play/_lib/route-handlers.test.ts app/api/play/_lib/compile-play-css.test.ts",
        "test:llms": "tsx --test scripts/generate-llms-txt.test.ts",
        "test:syntax": "tsx --test components/SyntaxTr.test.ts",
        "start": "next start",
        "lint": "eslint .",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-compiler": "workspace:^",
        "@master/css-engine": "workspace:^",
        "@master/css-language": "workspace:^",
        "@master/css-preset": "workspace:^",
        "@master/css-validator": "workspace:^",
        "@master/theme-mode.react": "^1.1.1",
        "@monaco-editor/react": "^4.7.0",
        "@next/mdx": "^16.2.9",
        "@shikijs/langs": "^4.2.0",
        "@shikijs/themes": "^4.2.0",
        "@tabler/icons-react": "^3.44.0",
        "acorn": "^8.17.0",
        "class-variant": "^2.0.6",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "hast-util-to-jsx-runtime": "^2.3.6",
        "mdast-util-from-markdown": "^2.0.3",
        "mdast-util-mdx-jsx": "^3.2.0",
        "mdast-util-mdxjs-esm": "^2.0.1",
        "micromark-extension-mdx-jsx": "^3.0.2",
        "micromark-extension-mdxjs-esm": "^3.0.0",
        "monaco-editor": "^0.55.1",
        "nanoid": "^5.1.15",
        "next": "^16.2.9",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "shiki": "^4.2.0",
        "theme-mode": "^1.1.1",
        "ts-dedent": "^2.3.0",
        "use-debounce": "^10.1.1"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@master/css-integration": "workspace:^",
        "@master/css.next": "workspace:^",
        "@opennextjs/cloudflare": "1.19.11",
        "@shikijs/monaco": "^4.2.0",
        "@types/mdx": "^2.0.14",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.5.0",
        "internal": "workspace:^",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "wrangler": "4.103.0"
    }
}
