{
    "name": "site",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24"
    },
    "scripts": {
        "prepare-app": "node --import tsx ./prepare.ts",
        "resolve-public-env": "bun scripts/resolve-public-env.ts --fetch-tags --write .generated/public-env.json",
        "clean": "rm -rf out .astro node_modules/.vite",
        "dev": "bun run prepare-app && astro dev --ignore-lock",
        "build": "bun run resolve-public-env && bun run prepare-app && bun run build:llms && bun run build:astro && bun run postbuild:static",
        "build:cloudflare-pages": "bun run build",
        "build:astro": "cross-env NODE_OPTIONS=--max-old-space-size=16384 MASTER_CSS_PUBLIC_ENV_FILE=.generated/public-env.json astro build",
        "build:llms": "node --import tsx scripts/generate-llms-txt-cli.ts",
        "postbuild:static": "bun scripts/postbuild-static.ts && bun run test:assets",
        "translate:site": "node --import tsx scripts/translate-site.ts",
        "audit:i18n": "node --import tsx scripts/audit-i18n.ts",
        "preview:cloudflare-pages": "bun run build:cloudflare-pages && bun --bun wrangler pages dev site/out --cwd ..",
        "test:home": "node --import tsx --test content/components/home-content.test.ts",
        "test:image-loader": "bun test utils/cloudflare-image-loader.test.ts",
        "test:public-env": "bun test utils/public-env.test.ts",
        "test:llms": "node --import tsx --test scripts/generate-llms-txt-test-cli.ts",
        "test:docs-examples": "node --import tsx --test scripts/validate-doc-examples.test.ts",
        "test:mdx-imports": "bun test scripts/check-mdx-imports.test.ts",
        "test:css-contract": "bun test scripts/css-variable-references.test.ts && bun scripts/verify-css-contract.ts",
        "update:css-contract": "bun scripts/verify-css-contract.ts --update",
        "test:syntax": "bun test components/SyntaxTr.test.ts common/generate-preset-css.test.ts",
        "test:reference": "node --import tsx --test reference/reference.test.ts",
        "start": "bun --bun wrangler pages dev site/out --cwd ..",
        "lint": "bun scripts/lint.mjs",
        "lint:full": "bun scripts/lint.mjs --no-cache",
        "test:lint-cache": "bun test scripts/lint-cache.test.mjs",
        "type-check": "bun run check:astro && bun run check:svelte && bun --bun tsc --noEmit",
        "test:assets": "bun scripts/verify-public-assets.ts",
        "test:atomic-classes": "bun test scripts/atomic-class-authoring.test.ts",
        "check:astro": "astro sync && astro-check --tsconfig ./tsconfig.json",
        "check:svelte": "svelte-check --tsconfig ./tsconfig.json"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "^7.3.4",
        "@astrojs/mdx": "^8.1.2",
        "@astrojs/svelte": "^9.1.2",
        "@master/css": "workspace:^",
        "@master/css-compiler": "workspace:^",
        "@master/css-language-service": "workspace:^",
        "@master/css-preset": "workspace:^",
        "@master/css-schema": "workspace:^",
        "@master/css-tooling": "workspace:^",
        "@shikijs/langs": "^4.4.3",
        "@shikijs/themes": "^4.4.3",
        "@shikijs/transformers": "^4.4.3",
        "@tabler/icons-svelte-runes": "^3.50.0",
        "acorn": "^8.18.0",
        "astro": "^7.4.2",
        "class-variant": "^2.0.6",
        "clsx": "^2.1.1",
        "colorjs.io": "^0.7.1",
        "dayjs": "^1.11.23",
        "defu": "^6.1.7",
        "fuse.js": "^7.5.0",
        "github-slugger": "^2.0.0",
        "hast-util-to-html": "^9.0.5",
        "html": "^1.0.0",
        "js-beautify": "^2.0.3",
        "mdast-util-from-markdown": "^2.0.3",
        "mdast-util-mdx-jsx": "^3.2.0",
        "mdast-util-mdxjs-esm": "^2.0.1",
        "micromark-extension-mdx-jsx": "^3.0.2",
        "micromark-extension-mdxjs-esm": "^3.0.0",
        "nanoid": "^6.0.1",
        "package-manager-detector": "^1.8.0",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.4.3",
        "svelte": "^5.57.2",
        "theme-mode": "^1.1.1",
        "throttle-debounce": "^5.0.2",
        "ts-dedent": "^2.3.0",
        "@master/internal-site": "0.1.0"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@eslint/compat": "^2.1.1",
        "@eslint/config-helpers": "^0.7.0",
        "@master/css-astro": "workspace:^",
        "@master/css-internal": "workspace:^",
        "@master/eslint-config-css": "workspace:^",
        "@resvg/resvg-js": "^2.6.2",
        "@types/hast": "^3.0.5",
        "@types/throttle-debounce": "^5.0.2",
        "@typescript-eslint/parser": "8.69.0",
        "acorn-jsx": "5.3.2",
        "astro-eslint-parser": "^3.2.0",
        "eslint": "^10.10.0",
        "eslint-mdx": "^3.8.1",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-svelte": "^3.23.1",
        "fast-glob": "^3.3.3",
        "satori": "^0.63.2",
        "svelte-check": "4.7.7",
        "svelte-eslint-parser": "^1.10.0",
        "svgo": "^4.1.0",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "unist-util-visit": "^5.1.0",
        "wrangler": "4.129.0"
    }
}
