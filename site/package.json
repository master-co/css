{
  "name": "site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "prepare-app": "tsx ./prepare",
    "resolve-public-env": "tsx scripts/resolve-public-env.ts --fetch-tags --write .generated/public-env.json",
    "clean": "rm -rf out .astro node_modules/.vite",
    "dev": "pnpm prepare-app && astro dev --ignore-lock",
    "build": "pnpm resolve-public-env && pnpm prepare-app && pnpm build:llms && pnpm build:astro && pnpm postbuild:static",
    "build:cloudflare-pages": "pnpm build",
    "build:astro": "cross-env NODE_OPTIONS=--max-old-space-size=16384 MASTER_CSS_PUBLIC_ENV_FILE=.generated/public-env.json astro build",
    "build:llms": "tsx scripts/generate-llms-txt-cli.ts",
    "postbuild:static": "tsx scripts/postbuild-static.tsx && pnpm test:assets",
    "translate:site": "tsx scripts/translate-site.ts",
    "audit:i18n": "tsx scripts/audit-i18n.ts",
    "preview:cloudflare-pages": "pnpm build:cloudflare-pages && wrangler pages dev site/out --cwd ..",
    "test:home": "tsx --test content/components/home-content.test.ts",
    "test:image-loader": "tsx --test utils/cloudflare-image-loader.test.ts",
    "test:public-env": "tsx --test utils/public-env.test.ts",
    "test:islands": "tsx --test islands/islands.test.tsx",
    "test:llms": "tsx --test scripts/generate-llms-txt-test-cli.ts",
    "test:docs-examples": "tsx --test scripts/validate-doc-examples.test.ts",
    "test:mdx-imports": "tsx --test scripts/check-mdx-imports.test.ts",
    "test:css-contract": "tsx --test scripts/css-variable-references.test.ts && tsx scripts/verify-css-contract.ts",
    "update:css-contract": "tsx scripts/verify-css-contract.ts --update",
    "test:syntax": "tsx --test components/SyntaxTr.test.ts common/generate-preset-css.test.ts",
    "test:reference": "tsx --test reference/reference.test.ts",
    "start": "wrangler pages dev site/out --cwd ..",
    "lint": "node scripts/lint.mjs",
    "lint:full": "node scripts/lint.mjs --no-cache",
    "test:lint-cache": "node --test scripts/lint-cache.test.mjs",
    "type-check": "tsc --noEmit",
    "test:assets": "tsx scripts/verify-public-assets.ts",
    "test:atomic-classes": "tsx --test scripts/atomic-class-authoring.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@master/css": "workspace:^",
    "@master/css-compiler": "workspace:^",
    "@master/css-language-service": "workspace:^",
    "@master/css-preset": "workspace:^",
    "@master/css-schema": "workspace:^",
    "@master/css-tooling": "workspace:^",
    "@master/styled.react": "^2.0.6",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@tabler/icons-react": "^3.46.0",
    "acorn": "^8.18.0",
    "astro": "^7.4.2",
    "class-variant": "^2.0.6",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.7.1",
    "dayjs": "^1.11.23",
    "defu": "^6.1.7",
    "es-module-lexer": "^3.0.4",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html": "^1.0.0",
    "js-beautify": "^2.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdxjs-esm": "^3.0.0",
    "nanoid": "^6.0.1",
    "package-manager-detector": "^1.8.0",
    "react": "^19.2.8",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.8",
    "react-intersection-observer": "^11.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "theme-mode": "^1.1.1",
    "throttle-debounce": "^5.0.2",
    "ts-dedent": "^2.3.0",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/config-helpers": "^0.7.0",
    "@master/css-astro": "workspace:^",
    "@master/css-internal": "workspace:^",
    "@master/eslint-config-css": "workspace:^",
    "@resvg/resvg-js": "^2.6.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/parser": "8.69.0",
    "acorn-jsx": "5.3.2",
    "eslint": "^10.10.0",
    "eslint-mdx": "^3.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-glob": "^3.3.3",
    "satori": "^0.63.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "wrangler": "4.129.0"
  }
}
