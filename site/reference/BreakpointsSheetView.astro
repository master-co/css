---
import './sheet-blocks'
import Link from '~/site/docs-shell/components/Link.svelte'
import SheetExampleBlock from './SheetExampleBlock.astro'
import SheetTable from './SheetTable.astro'
import type { BreakpointsSheet } from './sheets'

interface Props {
  sheet: BreakpointsSheet
}

const { sheet } = Astro.props
---

<h2 id="conditions">Conditions</h2>
<p>Append a condition to any class with <code>@</code>, such as <code>grid-cols(3)@md</code>. These are preset <code>@custom-media</code> definitions, not theme variables.</p>
{sheet.groups.map(group => <Fragment>
  <h3 id={group.id}>{group.title}</h3>
  <SheetTable class="ref-value-table" head={['Condition', 'Query']}>
    {group.rows.map(row => <tr id={`condition-${row.name}`}>
      <th scope="row"><code>@{row.name}</code></th>
      <td><code>{row.query}</code>{row.pixels && <span class="ref-value-note">{row.pixels}</span>}</td>
    </tr>)}
  </SheetTable>
</Fragment>)}

<h2 id="usage">Usage</h2>
<SheetExampleBlock example={sheet.usage} />

<h2 id="customize">Customize</h2>
<SheetExampleBlock example={sheet.customize} preview={false} />
<p class="ref-links">See <Link href="/reference/rules/conditions">conditions</Link> and <Link href="/guide/responsive-design#based-on-viewport-breakpoints">Responsive design</Link>.</p>
