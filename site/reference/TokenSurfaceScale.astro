---
import { siteOf } from '@master/internal-site/astro/site-context'
import { referenceLabel } from './ui'
import '@master/internal-site/styles/system/stage.ts'
import '@master/internal-site/styles/system/tray.ts'
import DocumentDisclosure from '@master/internal-site/components/DocumentDisclosure.astro'
import type { SheetGroup } from './sheets'

interface Props {
  group: SheetGroup
}

/** Complete visual lookup from the same values as the adjacent table. */
const { group } = Astro.props
const { locale } = siteOf(Astro)
const radius = group.namespace === 'radius'
---

{(radius || group.namespace === 'shadow') && <DocumentDisclosure title={referenceLabel(locale, radius ? 'radiusScale' : 'shadowScale')}>
  <div class="tray ui-tray">
    <div class="sheet sheet-flat ref-surface-scale ui-stage" data-kind={group.namespace}>
      {group.values.map(value => <div class="ref-surface-specimen">
        <code>{value.className}</code>
        <div class="ref-surface-sample" aria-hidden="true" style={radius ? { borderRadius: value.value } : { boxShadow: value.value }} />
      </div>)}
    </div>
  </div>
</DocumentDisclosure>}
