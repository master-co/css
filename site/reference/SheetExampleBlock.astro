---
import '@master/internal-site/styles/system/stage.ts'
import Code from '@master/internal-site/components/Code.astro'
import DocumentExample from '@master/internal-site/components/DocumentExample.astro'
import InlineText from './InlineText.astro'
import type { SheetExample } from './sheets'

interface Props {
  example: SheetExample
  preview?: boolean
  source?: boolean
  caption?: string
}

/**
 * Lead sentence, then one tray: the live preview on its stage, the subject's source and its
 * closed Generated CSS, so the preview and the code read as one example.
 */
const { example, preview = true, source = true, caption } = Astro.props
---

{example.lead && <p><InlineText text={example.lead} /></p>}
<DocumentExample resultKind="generated-css" providedSlots={['sourceCode', 'resultCode', ...(preview ? ['preview'] : []), ...(caption ? ['caption'] : [])]}>
  <Fragment slot="preview">{preview && <div class="sheet sheet-flat ui-stage">
    <div class="ref-example-scene" set:html={example.html} />
  </div>}</Fragment>
  <Fragment slot="sourceCode">
    {!preview && example.configuration && <Code lang="css" code={example.configuration} />}
    {source && <Code lang="html" code={example.code} />}
  </Fragment>
  <Code slot="resultCode" lang="css" beautify code={example.css} />
  {caption && <InlineText slot="caption" text={caption} plain />}
</DocumentExample>
