---
import { keyWidth } from './sheet-blocks'
import Code from '~/site/docs-shell/components/Code.astro'
import Link from '~/site/docs-shell/components/Link.svelte'
import DocumentDisclosure from '../components/DocumentDisclosure.astro'
import SheetClassTable from './SheetClassTable.astro'
import SheetExampleBlock from './SheetExampleBlock.astro'
import SheetNote from './SheetNote.astro'
import type { RecipeSheet } from './sheets'
import SheetExplanation from './SheetExplanation.astro'

interface Props {
  sheet: RecipeSheet
}

const { sheet } = Astro.props
const definitions = sheet.definitions.split('\n\n')
---

<h2 id="overview">Classes</h2>
<SheetClassTable rows={sheet.syntax} more={sheet.more} moreLabel={`${sheet.more.length} more functions`} width={keyWidth(sheet.syntax.map(row => row.syntax))} />
{sheet.note && <SheetNote text={sheet.note} />}

<SheetExplanation explanation={sheet.explanation} />

<h2 id="examples">Usage</h2>
<SheetExampleBlock example={sheet.usage} caption={sheet.caption} />

<h2 id="customize">Customize</h2>
<p>The preset defines {sheet.syntax.length + sheet.more.length > 1 ? 'these classes' : 'this class'} with <code>@utility</code>. Define the same name in your stylesheet to replace it.</p>
{definitions.length > 4
  ? <Fragment>
    <Code lang="css" code={definitions[0]} />
    <DocumentDisclosure title={`All ${definitions.length} definitions`}><Code lang="css" code={sheet.definitions} /></DocumentDisclosure>
  </Fragment>
  : <Code lang="css" code={sheet.definitions} />}
<p class="ref-links">See <Link href="/reference/directives/definitions">utility definitions</Link>{sheet.guide && <Fragment> and <Link href={sheet.guide.href}>{sheet.guide.label}</Link></Fragment>}.</p>
