---
import { selectFoundationTokens } from '@master/internal-site/css/foundation-data/tokens.ts'

interface Props {
  namespace: string
  keys: string[]
}

const { namespace, keys } = Astro.props
---

<ul>{selectFoundationTokens(namespace, keys).map(token =>
  <li><code>--{token.name}</code>: {token.values.map((value, index) =>
    <span>{index ? '; ' : ''}<code>{value.value}</code> ({value.path.join(' → ')})</span>
  )}</li>
)}</ul>
