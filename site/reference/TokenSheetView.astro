---
import { siteOf } from '@master/internal-site/astro/site-context'
import { referenceLabel, referenceHeader } from './ui'
import '@master/internal-site/styles/system/stage.ts'
import '@master/internal-site/styles/system/tray.ts'
import '@master/internal-site/styles/system/tray-code.css'
import { keyWidth } from './sheet-blocks'
import Link from '@master/internal-site/components/Link.svelte'
import Palette from '@master/internal-site/demo/foundations/Palette.svelte'
import { foundationTokens } from '@master/internal-site/css/foundation-data/tokens.ts'
import { modePair, pixels, type SheetGroup, type TokenSheet } from './sheets'
import SheetClassTable from './SheetClassTable.astro'
import SheetExampleBlock from './SheetExampleBlock.astro'
import SheetNote from './SheetNote.astro'
import SheetTable from './SheetTable.astro'
import SheetValue from './SheetValue.astro'
import InlineText from './InlineText.astro'
import SheetExplanation from './SheetExplanation.astro'
import TokenSurfaceScale from './TokenSurfaceScale.astro'
import TokenTypeScale from './TokenTypeScale.astro'
import TokenMotionScale from './TokenMotionScale.astro'

interface Props {
  sheet: TokenSheet
}

type PaletteGroup = { family: string; colors: { name: string; step: number; value: string }[] }

/** Show a stored `var(--token)` reference as the value it resolves to, e.g. text sizes. */
function resolved(value: string) {
  const name = value.match(/^var\(--([\w-]+)\)$/)?.[1]
  return (name && foundationTokens.find(token => token.name === name)?.values[0].value) || value
}

/** Numbered steps read best as a hue × step matrix; every swatch copies its value. */
function paletteGroups(group: SheetGroup) {
  const hues = new Map<string, PaletteGroup>()
  for (const row of group.values) {
    const [, family, step] = row.key.match(/^(.+)-(\d+)$/)!
    if (!hues.has(family)) hues.set(family, { family, colors: [] })
    hues.get(family)!.colors.push({ name: row.variable.slice(2), step: Number(step), value: row.value })
  }
  return [...hues.values()].map(hue => ({ ...hue, colors: hue.colors.sort((a, b) => a.step - b.step) }))
}

const { sheet } = Astro.props
const grouped = sheet.groups.length > 1
const width = keyWidth(sheet.syntax.map(row => row.syntax).concat(sheet.groups.flatMap(group => group.values.map(value => value.className))))
const { locale } = siteOf(Astro)
const l = (key: Parameters<typeof referenceLabel>[1], values?: Record<string, string | number>) => referenceLabel(locale, key, values)

---

<h2 id="consumers">{l('classes')}</h2>
<SheetClassTable rows={sheet.syntax} more={sheet.more} moreLabel={sheet.id.startsWith('color') ? l('moreColorFamilies', { count: sheet.more.length }) : l('moreClasses', { count: sheet.more.length })} width={width} />
{sheet.note && <SheetNote text={sheet.note} />}

<h2 id="values">{l('values')}</h2>
{sheet.valuesLead && <p><InlineText text={sheet.valuesLead} /></p>}
{sheet.groups.filter(group => group.values.length).map(group => <Fragment>
  {grouped && group.title && <h3 id={group.id}>{group.title}</h3>}
  {group.palette
    ? <div class="tray ui-tray">
      <div class="sheet sheet-flat ui-stage" data-padding="sm" data-align="start">
        <Palette client:idle={{ timeout: 500 }} groups={paletteGroups(group)} />
      </div>
    </div>
    : <SheetTable class="ref-value-table" head={group.head.map(header => referenceHeader(locale, header))} modes={group.modes} keyWidth={width}>
      {group.values.map(row => <tr class="table-row" id={row.id}>
        <th class="table-cell table-primary" scope="row"><code>{row.className}</code></th>
        {group.modes ? modePair(row.value)!.map(value => <td class="table-cell"><code>{value}</code></td>)
          : (row.cells ?? [row.value]).map(value => {
            // A hue alias is a lookup relationship; do not hide its reference behind a hover title.
            const display = group.namespace === 'color' ? value : resolved(value)
            return <td class="table-cell" title={display === value ? undefined : value}><SheetValue value={display} note={pixels(display)} /></td>
          })}
      </tr>)}
    </SheetTable>}
  <TokenSurfaceScale group={group} />
  <TokenTypeScale group={group} />
  <TokenMotionScale group={group} />
</Fragment>)}

<SheetExplanation explanation={sheet.explanation} />

<h2 id="usage">{l('usage')}</h2>
<SheetExampleBlock example={sheet.usage} />

<h2 id="customize">{l('customize')}</h2>
<SheetExampleBlock example={sheet.customize} preview={false} source={false} />
<p class="ref-links">{l('see')} <Link href="/reference/directives/theme">{l('themeDirectives')}</Link>{sheet.guide && <Fragment> {l('and')} <Link href={sheet.guide.href}>{sheet.guide.label}</Link></Fragment>}.</p>
