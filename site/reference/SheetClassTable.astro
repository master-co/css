---
import { siteOf } from '@master/internal-site/astro/site-context'
import { referenceLabel, referenceHeader } from './ui'
import Link from '@master/internal-site/components/Link.svelte'
import DocumentDisclosure from '@master/internal-site/components/DocumentDisclosure.astro'
import SheetTable from './SheetTable.astro'
import { keyWidth, placeholderParts } from './sheet-blocks'
import type { SheetSyntax } from './sheets'

interface Props {
  rows: SheetSyntax[]
  more?: SheetSyntax[]
  moreLabel?: string
  width?: string
}

/** Class pattern → native declarations, the first fact a reader looks for. */
const { rows, more, moreLabel, width } = Astro.props
const declarationsOf = (row: SheetSyntax) => row.declarations.split('\n').map(line => {
  const separator = line.indexOf(':')
  return { property: line.slice(0, separator), value: line.slice(separator + 1).trim().replace(/;$/, '') }
})
const { locale } = siteOf(Astro)
const l = (key: Parameters<typeof referenceLabel>[1], values?: Record<string, string | number>) => referenceLabel(locale, key, values)

---

<SheetTable class="ref-class-table" head={['Class', 'Declarations'].map(header => referenceHeader(locale, header))} keyWidth={width}>
  {rows.map(row => <tr class="table-row">
    <th class="table-cell table-primary" scope="row">
      {row.prefix
        ? <Link href={`/reference/tokens/families#family-${row.prefix}`}><code>{placeholderParts(row.syntax).map(part => part.placeholder ? <var>{part.text}</var> : part.text)}</code></Link>
        : <code>{placeholderParts(row.syntax).map(part => part.placeholder ? <var>{part.text}</var> : part.text)}</code>}
    </th>
    <td class="table-cell"><span class="ref-declarations">{declarationsOf(row).map(({ property, value }) => <span class="ref-declaration"><span class="ref-property">{property}:</span> <span class="ref-declaration-value">{placeholderParts(value).map(part => part.placeholder ? <var>{part.text}</var> : part.text)};</span></span>)}</span></td>
  </tr>)}
</SheetTable>
{/* The disclosed rows size their own column; they never join the page's alignment. */}
{!!more?.length && <DocumentDisclosure title={moreLabel ?? l('moreClasses', { count: more.length })}><Astro.self rows={more} width={keyWidth(more.map(row => row.syntax))} /></DocumentDisclosure>}
