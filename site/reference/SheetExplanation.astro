---
import { siteOf } from '@master/internal-site/astro/site-context'
import { referenceLabel } from './ui'
import Link from '@master/internal-site/components/Link.svelte'
import InlineText from './InlineText.astro'
import ReferenceIllustration from './ReferenceIllustration.astro'
import type { TokenPageEditorial } from './sheet-editorial'

interface Props {
  explanation: TokenPageEditorial['explanation']
}

const { explanation } = Astro.props
const { locale } = siteOf(Astro)
const l = (key: Parameters<typeof referenceLabel>[1], values?: Record<string, string | number>) => referenceLabel(locale, key, values)

---

{explanation && <Fragment>
  <h2 id={explanation.id}>{explanation.title}</h2>
  <p><InlineText text={explanation.paragraphs[0]} /></p>
  <ReferenceIllustration id={explanation.illustration} />
  {explanation.paragraphs.slice(1).map(paragraph => <p><InlineText text={paragraph} /></p>)}
  {!!explanation.links?.length && <p class="ref-links">{l('see')} {explanation.links.map((link, index) => <Fragment>{index ? l('and') : ''}<Link href={link.href}>{link.label}</Link></Fragment>)}.</p>}
</Fragment>}
