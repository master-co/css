---
import Link from '~/site/docs-shell/components/Link.svelte'
import InlineText from './InlineText.astro'
import ReferenceIllustration from './ReferenceIllustration.astro'
import type { TokenPageEditorial } from './sheet-editorial'

interface Props {
  explanation: TokenPageEditorial['explanation']
}

const { explanation } = Astro.props
---

{explanation && <Fragment>
  <h2 id={explanation.id}>{explanation.title}</h2>
  <p><InlineText text={explanation.paragraphs[0]} /></p>
  <ReferenceIllustration id={explanation.illustration} />
  {explanation.paragraphs.slice(1).map(paragraph => <p><InlineText text={paragraph} /></p>)}
  {!!explanation.links?.length && <p class="ref-links">See {explanation.links.map((link, index) => <Fragment>{index ? ' and ' : ''}<Link href={link.href}>{link.label}</Link></Fragment>)}.</p>}
</Fragment>}
