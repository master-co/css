---
import { siteOf } from '@master/internal-site/astro/site-context'
import { referenceLabel } from './ui'
import { referenceText } from './copy'
import DocumentDisclosure from '@master/internal-site/components/DocumentDisclosure.astro'
import Demo from '@master/internal-site/demo/Demo.svelte'
import DemoViewport from '@master/internal-site/demo/DemoViewport.svelte'
import { demoDocument } from '@master/internal-site/demo/reference/document.ts'
import { foundationScene } from '@master/internal-site/css/foundation-data/specimens.ts'
import type { SheetGroup } from './sheets'

interface Props {
  group: SheetGroup
}

/** Keep the existing native playback comparisons, selected by the complete lookup table. */
const { group } = Astro.props
const { locale } = siteOf(Astro)
const shown = ['animate', 'duration', 'easing'].includes(group.namespace)
const scene = shown ? foundationScene(group.namespace, group.values.map(value => value.key)) : undefined
// Curves may travel beyond either endpoint. Reserve proportional paint room at every frame width.
if (scene && group.namespace !== 'animate') scene.css += ' [data-motion-path] { margin-inline:16%; }'
const title = referenceLabel(locale, ({ animate: 'animationScale', duration: 'durationScale', easing: 'easingScale' } as const)[group.namespace as 'animate' | 'duration' | 'easing'] ?? 'animationScale')
const caption = scene ? referenceText('specimens', `${group.namespace === 'animate' ? 'animation' : group.namespace}-caption`, locale) : undefined
---

{scene && <DocumentDisclosure title={title}>
  <Demo frame="none" caption={caption}>
    <DemoViewport client:idle={{ timeout: 500 }} title={title} document={demoDocument({ page: 'tokens', id: group.namespace, title, html: [], css: '', classes: [], classLists: [], highlighted: [] }, scene)} sizing="content" motion />
  </Demo>
</DocumentDisclosure>}
