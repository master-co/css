{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Stylesheet side-effect imports resolve to CSS files the bundler owns.
    "noUncheckedSideEffectImports": false,
    "types": [
      "mdx",
      "node"
    ],
    "paths": {
      "@master/css-compiler": [ "../node_modules/@master/css-compiler/src" ],
      "@master/css-compiler/stylesheet": [ "../node_modules/@master/css-compiler/src/stylesheet/index-public.ts" ],
      "@master/css-compiler/*": [ "../node_modules/@master/css-compiler/src/*" ],
      "@master/css": [ "../node_modules/@master/css/src" ],
      "@master/css/*": [ "../node_modules/@master/css/src/*" ],
      "@master/css-internal": [ "../node_modules/@master/css-internal/src" ],
      "@master/css-internal/*": [ "../node_modules/@master/css-internal/src/*" ],
      "@master/css-tooling": [ "../node_modules/@master/css-tooling/src" ],
      "@master/css-tooling/*": [ "../node_modules/@master/css-tooling/src/*" ],
      "@master/css-language-service": [ "../node_modules/@master/css-language-service/src" ],
      "@master/css-language-service/*": [ "../node_modules/@master/css-language-service/src/*" ],
      "@master/css-schema": [ "../node_modules/@master/css-schema/src" ],
      "@master/css-schema/*": [ "../node_modules/@master/css-schema/src/*" ],
      "@master/css-binding-wasm-compiler": [ "../packages/binding-wasm-compiler/src/provider.ts" ],
      "@master/css-binding-wasm-engine": [ "../packages/binding-wasm-engine/src/provider.ts" ],
      "@master/css-engine-js": [ "../packages/engine-js/src/index.ts" ],
      "@master/css-binding-wasm-tooling": [ "../packages/binding-wasm-tooling/src/provider.ts" ],
      "@master/css-astro": [ "../node_modules/@master/css-astro/src" ],
      "~/packages/*": [ "../packages/*" ],
      "~/site/*": [ "./*" ],
      "~/*": [ "../*" ]
    }
  },
  "exclude": [
    "node_modules",
    "out",
    ".astro"
  ],
  "include": [
    "src/env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mdx"
  ]
}
