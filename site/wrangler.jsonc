{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "master-css-site-rc",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-06-11",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "account_id": "337580da126498c38a54d4d5cd2024c8",
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "master-css-site-rc"
        }
    ],
    "images": {
        "binding": "IMAGES"
    },
    "kv_namespaces": [
        {
            "binding": "PLAY_SHARES",
            "id": "d1211ca89fed447c9fa17966091faea8"
        }
    ],
    "routes": [
        {
            "pattern": "rc.css.master.co/*",
            "zone_name": "master.co"
        }
    ],
    "vars": {
        "NEXT_PUBLIC_HOST": "rc.css.master.co",
        "NEXT_PUBLIC_URL": "https://rc.css.master.co",
        "PLAY_SHARE_TTL_SECONDS": "2592000",
        "PLAY_ALLOWED_ORIGINS": "https://rc.css.master.co,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8787,http://127.0.0.1:8787,https://localhost:8787,https://127.0.0.1:8787"
    }
}
