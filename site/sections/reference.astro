---
import '~/site/styles/reference.css'
import DocumentShell from './document.astro'
import DocHeader from '~/site/docs-shell/components/DocHeader.svelte'
import DocWrapper from '~/site/docs-shell/components/DocWrapper.astro'
import ReferenceNavigation from '~/site/reference/Navigation.svelte'
import { routeIndex } from '~/site/reference/route-index'
import pageCategories from '~/site/.categories/reference.json'
import { referenceNavigationCategories } from '~/site/reference/navigation-data'

export const bodyClass = 'bg-surface-base'
const navigation = referenceNavigationCategories(routeIndex, pageCategories.map(category => category.name))
---

<DocumentShell>
  <DocHeader client:load contained documentNavigation={navigation} documentNavigationTitle="Reference" />
  <DocWrapper>
    <ReferenceNavigation client:load pageCategories={navigation} />
    <slot />
  </DocWrapper>
</DocumentShell>
