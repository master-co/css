---
import '~/site/styles/reference.css'
import DocumentShell from '@master/internal-site/sections/document.astro'
import DocHeader from '@master/internal-site/components/DocHeader.svelte'
import DocWrapper from '@master/internal-site/components/DocWrapper.astro'
import ReferenceNavigation from '~/site/reference/Navigation.svelte'
import { routeIndexForLocale } from '~/site/reference/route-index'
import { siteOf } from '@master/internal-site/astro/site-context'
import pageCategories from '~/site/.categories/reference.json'
import { referenceNavigationCategories } from '~/site/reference/navigation-data'

export const bodyClass = 'bg-surface-base'
const navigation = referenceNavigationCategories(routeIndexForLocale(siteOf(Astro).locale), pageCategories.map(category => category.name))
---

<DocumentShell>
  <DocHeader client:load contained />
  <DocWrapper>
    <ReferenceNavigation client:load pageCategories={navigation} />
    <slot />
  </DocWrapper>
</DocumentShell>
