---
import DocumentShell from './document.astro'
import DocHeader from '~/site/docs-shell/components/DocHeader.svelte'
import DocSidebar from '~/site/docs-shell/components/DocSidebar.svelte'
import DocWrapper from '~/site/docs-shell/components/DocWrapper.astro'
import pageCategories from '~/site/.categories/guide.json'
import type { MetadataTitle } from '~/site/docs-shell/types/Metadata'

export const bodyClass = 'bg-surface-base'

// The sidebar is a client island; serialize only the fields it renders on every page.
const sidebarCategories = pageCategories.map(({ name, pages }) => ({
  name,
  pages: pages.map(({ title, pathname, other }: { title: MetadataTitle, pathname: string, other?: { subject: string } }) => other ? { title, pathname, other } : { title, pathname })
}))
const menuCategories = sidebarCategories.map(category => ({ ...category, pages: category.pages.filter(page => page.pathname.split('/').length === 3) }))
---

<DocumentShell>
  <DocHeader client:load contained documentNavigation={menuCategories} documentNavigationTitle="Guide" />
  <DocWrapper>
    <DocSidebar client:load pageCategories={sidebarCategories} />
    <slot />
  </DocWrapper>
</DocumentShell>
