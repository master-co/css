---
export const documentStyles = false
import '@master/css-language-service/shiki.css'
import '@master/internal-site/home/design.css'
import '@master/internal-site/home/home.css'
import DocHeader from '@master/internal-site/components/DocHeader.svelte'
import { createPageMetadata } from '@master/internal-site/factories/create-page'
import dictionaries from '~/site/dictionaries'
import AgentsSection from './components/AgentsSection.astro'
import BenchmarkSection from './components/BenchmarkSection.astro'
import CTASection from './components/CTASection.astro'
import DeliveryModesSection from './components/DeliveryModesSection.astro'
import DesignSystemSection from './components/DesignSystemSection.astro'
import HeroSection from './components/HeroSection.astro'
import HomeFooter from '@master/internal-site/home/HomeFooter.svelte'
import { footerNavGroups } from '~/site/navigation'
import HomeLamp from '@master/internal-site/home/HomeLamp.svelte'
import LanguageServiceSection from './components/LanguageServiceSection.astro'
import LintSection from './components/LintSection.astro'
import WorkflowSection from './components/WorkflowSection.astro'

export const metadata = {
  title: { absolute: 'Master CSS - A markup-driven CSS orchestration language for developers and AI agents' },
  description: 'Style in markup with class names and design tokens. One project manifest generates only the CSS each page uses, and checks every class the same way in your editor, your build and your AI agents.',
  openGraph: { title: 'Master CSS' },
  cover: { src: '/brand/v2/social/png/master-css-og.png', alt: 'Master CSS', width: 1200, height: 630 }
}

export const generateMetadata = createPageMetadata(metadata, dictionaries)

const website = Astro.props.params.locale === 'en' && {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Master CSS',
  url: new URL('/', Astro.site).href
}
---

{website && <script is:inline type="application/ld+json" set:html={JSON.stringify(website).replace(/</g, '\\u003c')} />}
<DocHeader client:load class="home-header" stickable />
<main class="overflow-clip home-page">
  <HeroSection />
  <DesignSystemSection />
  <LanguageServiceSection />
  <DeliveryModesSection />
  <BenchmarkSection />
  <LintSection />
  <AgentsSection />
  <WorkflowSection />
  <CTASection />
  {/* Renders nothing of its own, so it hydrates once the page is idle rather than when visible. */}
  <HomeLamp client:idle={{ timeout: 500 }} />
</main>
<HomeFooter navGroups={footerNavGroups} wordmark="master css" client:idle={{ timeout: 500 }} />

<style is:global>
  @layer components {
    .home-header .ui-version {
      display: none;
    }
  }
</style>
