---
import { siteOf } from '@master/internal-site/astro/site-context'
import Link from '@master/internal-site/components/Link.svelte'
import brands from '@master/internal-site/data/brands'
import { workflowFrameworks, workflowIntegrations } from './workflow-content'
import WorkflowCanvas from './WorkflowCanvas.svelte'

/** Canvas draws the assembly; the original brand marks and installation links remain native. */
const { t } = siteOf(Astro)
---

<div class="home-wf-figure home-wf-stage-figure" data-active="0" data-wf="stage">
  <div class="home-wf-scene home-wf-stage">
    <div class="home-wf-framework-grid">
      {workflowFrameworks.map((framework, index) => {
        const { name, src: Logo, className } = brands[framework.brand]
        return (
          <Link
            aria-label={t('{name} installation guide').replace('{name}', name)}
            class="home-wf-anchor home-wf-framework"
            data-lit={index === 0 ? '' : undefined}
            data-wf-anchor={`framework-${index}`}
            data-wf-name={name}
            data-wf-pick={index}
            href={`/guide/installation/${framework.guide}`}
            title={name}>
            <Logo aria-hidden="true" class={['home-wf-framework-logo', className].filter(Boolean).join(' ')} height={30} width={30} />
          </Link>
        )
      })}
    </div>
    <div aria-hidden="true" class="home-wf-integration-grid">
      {workflowIntegrations.map(({ key }, index) => (
        <span class="home-wf-anchor home-wf-integration" data-wf-anchor={`integration-${index}`}>{key}</span>
      ))}
    </div>
    <span class="home-stone home-stone-quiet home-wf-anchor home-wf-manifest" data-wf-anchor="manifest"><span aria-hidden="true" class="home-wf-source-mark">{'{ }'}</span><code>index.css</code></span>
    <WorkflowCanvas client:idle={{ timeout: 500 }} figure="stage" />
  </div>
  <p aria-hidden="true" class="home-wf-readout" data-wf-caption="">Vite → @master/css-vite</p>
</div>
