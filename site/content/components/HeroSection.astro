---
import '@master/internal-site/home/hero.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import CopyCommand from './CopyCommand.svelte'
import HeroCanvas from '@master/internal-site/home/HeroCanvas.svelte'
import HomeAction from '@master/internal-site/home/HomeAction.astro'
import { homeSections, installPrompt } from './home-content'

/** A cut-stone title, a stone action and liquid-glass controls share one lamp over a sculpted gold field. */
const { t } = siteOf(Astro)
---

<section data-glyph-host id={homeSections.hero} class="relative overflow-hidden isolate home-hero">
  <HeroCanvas client:load class="home-hero-field" />
  <div class="relative app-wrapper home-hero-body home-section-wrap">
    <Link class="home-glass home-hero-pill" href="/guide/ai-coding#connect-the-mcp-server">
      <span class="home-hero-pill-badge">{t('New')}</span>
      <span class="home-hero-pill-label">{t('An MCP server for your AI agents')}</span>
      <IconArrowRight aria-hidden="true" size={14} stroke={1.75} />
    </Link>
    {/* One line of markup: the title's text nodes are exactly its words and the single gap the glass mask walks. */}
    <h1 class="home-display" data-glass-title><span class="home-display-line">{t('A markup-driven CSS orchestration language')}</span><span class="home-title-gap">{' '}</span><span class="home-display-line">{t('for developers and AI agents.')}</span></h1>
    <div class="home-hero-actions">
      <HomeAction href="/guide/introduction" variant="primary">
        {t('Get started')}
        <IconArrowRight aria-hidden="true" size={16} stroke={1.75} />
      </HomeAction>
      <CopyCommand client:idle={{ timeout: 500 }} command={installPrompt(import.meta.env.PUBLIC_VERSION, import.meta.env.PUBLIC_URL)} label={t('Set up with your AI agent')} copyLabel={t('Copy setup prompt')} wrap />
    </div>
  </div>
</section>
