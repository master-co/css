---
import './lint.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import Link from '@master/internal-site/components/Link.svelte'
import { siteOf } from '@master/internal-site/astro/site-context'
import HomeBentoFrame from '@master/internal-site/home/HomeBentoFrame.astro'
import HomeSectionHeader from './HomeSectionHeader.astro'
import LintExplorer from './LintExplorer.svelte'
import type { HomeCompactIconId } from '@master/internal-site/home/home-illustration.ts'
import { homeSections, lintRules } from './home-content'
import { lintRuleReach } from './lint-content'

const ruleIcons: Record<string, HomeCompactIconId> = {
  'Invalid classes': 'lint-invalid-classes',
  'Class order': 'lint-class-order',
  'Conflicting classes': 'lint-conflicting-classes',
  'Strict vocabulary': 'lint-strict-vocabulary',
  'Theme tokens': 'lint-theme-tokens',
  'Fix previews': 'lint-fix-previews'
}

const { t } = siteOf(Astro)
---

<section id={homeSections.codeDiagnostics} class="home-section">
  <div class="app-wrapper home-section-wrap">
    <HomeSectionHeader
      icon="section-lint"
      index="05"
      label={t('Lint')}
      title={t('Lint classes against your project.')}
      body={t('ESLint in your editor, the CLI in your scripts and the MCP server for agents check classes with the same rules and fixes.')}>
      <Link class="home-section-link" href="/guide/code-linting">
        {t('See every lint rule')}
        <IconArrowRight aria-hidden="true" size={16} stroke={1.75} />
      </Link>
    </HomeSectionHeader>
    <HomeBentoFrame class="home-lint-frame home-marks home-reveal-item">
      <LintExplorer
        client:idle={{ timeout: 500 }}
        icons={lintRules.map((rule) => ruleIcons[rule.title])}
        rules={lintRules.map((rule) => ({
          title: rule.title,
          file: rule.file,
          code: rule.code,
          fixedCode: rule.fixPreviewCode,
          mark: rule.mark,
          problem: rule.problem,
          reach: lintRuleReach[rule.title]
        }))} />
    </HomeBentoFrame>
  </div>
</section>
