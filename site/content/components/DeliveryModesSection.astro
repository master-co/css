---
import './delivery.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import { siteOf } from '~/site/astro/site-context'
import Link from '~/site/docs-shell/components/Link.svelte'
import DeliveryFigures from './DeliveryFigures.svelte'
import DeliveryStage from './DeliveryStage.astro'
import HomeSectionHeader from './HomeSectionHeader.astro'
import { deliveryModes, homeSections, type DeliveryModeId } from './home-content'

/** Short names for the mode switch. */
const modeNames = {
  static: 'Static',
  progressive: 'Progressive',
  runtime: 'Runtime'
} satisfies Record<DeliveryModeId, string>

const { t } = siteOf(Astro)
---

<section id={homeSections.deliveryModes} class="home-delivery home-section">
  <div class="app-wrapper home-section-wrap">
    <HomeSectionHeader
      icon="section-rendering"
      index="03"
      label={t('Rendering')}
      title={t('One syntax. Every delivery path.')}
      body={t('Ship static CSS by default, pre-render it into HTML or generate it in the browser. Your classes stay the same.')}>
      <Link class="home-section-link" href="/guide/rendering-modes">{t('Compare rendering modes')}<IconArrowRight aria-hidden="true" size={16} stroke={1.75} /></Link>
    </HomeSectionHeader>

    {/*
      The figure carries the timeline's state for everything inside it. The drawing comes first;
      under it one control area holds the mode choice and player. The preview is the mode explanation.
      On narrow screens the controls come first, followed by the split editor, processor and preview.
    */}
    <div class="home-delivery-figure home-delivery-stage" data-moment="3" style={{ '--home-delivery-t': 4 }}>
      <div class="home-delivery-layout">
        {/* The drawing is an artboard: corner marks frame it, the way a design tool marks a frame. */}
        <div class="home-delivery-drawing home-marks">
          <DeliveryStage />
          <svg aria-hidden="true" class="home-delivery-routes">
            <defs>
              <marker id="home-delivery-arrow" markerHeight="6" markerUnits="userSpaceOnUse" markerWidth="6" orient="auto" refX="5" refY="3">
                <path d="M0 0 5 3 0 6" fill="none" stroke="currentColor" stroke-width="1" />
              </marker>
            </defs>
            <path data-route="input" />
            <path data-route="rules" />
            <path data-route="paint" />
          </svg>
          <div aria-hidden="true" class="home-delivery-flights" />
        </div>

        <div class="home-delivery-controls">
          {/* Each native input lives at its visible tab, so focusing it never scrolls to the figure's top. */}
          <div aria-label={t('Rendering')} class="home-delivery-switch home-segmented-control" role="radiogroup">
            {deliveryModes.map((mode) => (
              <label class="home-segmented-control-option" data-mode={mode.id} for={`home-delivery-${mode.id}`}><input aria-label={t(mode.title)} class="sr-only" checked={'default' in mode && mode.default} id={`home-delivery-${mode.id}`} name="home-delivery-mode" type="radio" value={mode.id} />{t(modeNames[mode.id])}</label>
            ))}
          </div>
          <DeliveryFigures client:idle={{ timeout: 500 }} sectionId={homeSections.deliveryModes} />
        </div>
      </div>
    </div>
  </div>
</section>
