---
import HomeIllustrationArt from './HomeIllustrationArt.svelte'
import type { HomeIllustrationId } from './home-illustration'

export type { HomeIllustrationId } from './home-illustration'

interface Props {
  class?: string
  icon: HomeIllustrationId
  size?: number
}

/** Decorative, theme-specific artwork. CSS reserves its square before the image loads. */
const { class: className, icon, size = 80 } = Astro.props
---

<HomeIllustrationArt class={className} {icon} {size} />
