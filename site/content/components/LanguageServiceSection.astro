---
import './editor-tiles.css'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import Link from '~/site/docs-shell/components/Link.svelte'
import { siteOf } from '~/site/astro/site-context'
import EditorFigures from './EditorFigures.svelte'
import { editorFeatures } from './editor-content'
import { getEditorModel } from './editor-document'
import HomeSectionHeader from './HomeSectionHeader.astro'
import type { HomeIllustrationId } from './home-illustration'
import { homeSections } from './home-content'

const featureIcons = {
  complete: 'editor-manifest-completions',
  hover: 'editor-hover-inspection',
  highlight: 'editor-focused-highlighting',
  color: 'editor-color-tools'
} satisfies Record<typeof editorFeatures[number]['id'], HomeIllustrationId>

/**
 * One file in one editor. A caret and a pointer walk through the language service features in
 * turn, and every class answers the reader's pointer with the CSS the language service shows.
 */
const { t } = siteOf(Astro)
---

<section id={homeSections.languageService} class="home-section">
  <div class="app-wrapper home-section-wrap">
    <HomeSectionHeader
      icon="section-editor"
      index="02"
      label={t('Editor')}
      title={t('Dense class strings, still readable.')}
      body={t('The language service completes classes from your manifest, shows the CSS behind each class on hover and marks colors in place.')} />
    <EditorFigures client:idle={{ timeout: 500 }} features={editorFeatures} icons={editorFeatures.map((feature) => featureIcons[feature.id])} model={getEditorModel()} />
    <div class="home-editor-guide">
      <Link class="home-section-link" href="/guide/language-service">
        {t('Explore the language service')}
        <IconArrowRight aria-hidden="true" size={16} stroke={1.75} />
      </Link>
    </div>
  </div>
</section>
