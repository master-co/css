---
import '~/site/styles/system/specimens.css'
import '~/site/styles/brand.css'
import { brandMinimums } from '~/site/common/brand'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoLabel from '~/site/components/demo/DemoLabel.svelte'
import BrandArtwork from './BrandArtwork.astro'
---

<Demo title="Minimum sizes" description="At actual CSS pixels" padding="sm" caption="Check the artwork at the size it will be used.">
  <div class="brand-minimums" data-demo-container="">
    {brandMinimums.map(({ kind, title, height }) => <figure style={{ '--brand-height': `${height}px` }}>
      <BrandArtwork {kind} alt={`The Master CSS ${title.toLowerCase()} at ${height}px high`} /><DemoLabel>{title} · {height}px</DemoLabel>
    </figure>)}
  </div>
</Demo>
