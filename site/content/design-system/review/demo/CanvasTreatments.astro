---
import Demo from '~/site/components/demo/Demo.svelte'
import DemoItem from '~/site/components/demo/DemoItem.svelte'
import { canvasTreatments } from '../../components/catalog'
---

<div class="grid-cols(1) gap-md grid-cols(2)@sm">{canvasTreatments.map(choice =>
  <Demo title={choice.title} background={choice.background} padding="sm" caption={choice.description}>
    <div class="flex gap-sm py-lg"><DemoItem>01</DemoItem><DemoItem>02</DemoItem><DemoItem>03</DemoItem></div>
  </Demo>)}
</div>
