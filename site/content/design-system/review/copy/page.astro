---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoCopyButton from '~/site/components/demo/DemoCopyButton.svelte'

export const metadata = pageMetadata
---

<ComponentPage title="Copy" description="A copy button and a status beside it. The status reports the real clipboard result, including when copying is unavailable." usage={{ href: '/design-system/review/palette', label: 'Palette' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="value" title="Value and compact feedback">
    <Demo padding="sm" caption="Value feedback repeats what was copied; compact feedback suits a specimen that already shows it.">
      <div class="grid gap-md py-md">
        <DemoCopyButton client:idle={{ timeout: 500 }} value="var(--color-blue-60)" label="Copy the blue 60 variable">Copy variable</DemoCopyButton>
        <DemoCopyButton client:idle={{ timeout: 500 }} value="var(--ui-surface-sheet)" label="Copy the sheet surface variable" feedback="compact">Copy surface</DemoCopyButton>
      </div>
    </Demo>
  </ComponentSection>
</ComponentPage>
