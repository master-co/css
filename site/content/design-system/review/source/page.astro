---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import BenchmarkSource from '~/site/components/benchmarks/BenchmarkSource.astro'
import { benchmarkSnapshots } from '~/site/content/benchmarks/components/BenchmarkSnapshots'

export const metadata = pageMetadata
---

<ComponentPage kicker="Documents" title="Evidence footer" description="The source and its recorded date, always beside the claim." usage={{ href: '/benchmarks', label: 'the benchmarks' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="source" title="Source and date">
    <BenchmarkSource {...benchmarkSnapshots['tailwind-static-comparison']} />
  </ComponentSection>
</ComponentPage>
