---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import Segments from '~/site/docs-shell/components/Segments.svelte'
import Demo from '~/site/components/demo/Demo.svelte'
import ButtonPreview from '~/site/content/guide/syntax-tutorial/components/ButtonPreview.astro'
import ControlsReviewScene from './ControlsReviewScene.svelte'
import ControlsGallery from './ControlsGallery.svelte'

export const metadata = pageMetadata
---

<ComponentPage title="Buttons and inputs" description="Controls share one material: a raised face that lifts half a pixel on hover, sinks into a well when pressed and always shows an ink focus ring. Hue never expresses state." usage={{ href: '/guide/syntax-tutorial#conditions', label: 'the Syntax Tutorial' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="gallery" title="Every control">
    <ControlsGallery client:idle={{ timeout: 500 }} />
  </ComponentSection>
  <ComponentSection id="segmented" title="Exclusive choices in a tray head" description="A segmented control in the tray head changes the actual utility on the specimen.">
    <ControlsReviewScene client:idle={{ timeout: 500 }} />
  </ComponentSection>
  <ComponentSection id="document-views" title="Related document views" description="Arrow keys move between views; Home and End reach the first and last; Tab moves into the selected panel.">
    <Segments client:idle={{ timeout: 500 }} label="Document view example" names={['Overview', 'Details']}>
      <p slot="Overview">A short explanation stays beside the example.</p>
      <p slot="Details">Supporting details remain available in the HTML, including when JavaScript is disabled.</p>
    </Segments>
  </ComponentSection>
  <ComponentSection id="viewport-conditions" title="Viewport conditions" description="The presets cross the sm breakpoint inside a real iframe; the button padding follows that viewport.">
    <Demo frame="none" title="Responsive button padding">
      <ButtonPreview responsive classes={['p-md', 'p-lg@sm', 'fg-blue-60:hover', 'fg-blue-60:focus-visible']} />
    </Demo>
  </ComponentSection>
</ComponentPage>
