---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoLabel from '~/site/components/demo/DemoLabel.svelte'
import DemoSurface from '~/site/components/demo/DemoSurface.svelte'

export const metadata = pageMetadata

const elevations = ['flat', '1', undefined, '3'] as const
---

<ComponentPage title="Sheet and well" description="A sheet is a raised face on the stage; a well is a sunken field below its surroundings. Elevation, not hue, separates them." usage={{ href: '/guide/view-transitions', label: 'the View transitions guide' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="sheet-elevation" title="Elevation">
    <Demo background="dots" caption="data-elevation chooses flat, rise-1, rise-2 (the default) or rise-3. Geometry and padding stay with the example.">
      <div class="grid-cols(2) gap-lg w-full grid-cols(4)@sm">
        {elevations.map(elevation => <div class="grid gap-xs p-md ui-sheet" data-elevation={elevation}>
          <DemoLabel>{elevation ? `data-elevation="${elevation}"` : 'default · rise-2'}</DemoLabel><span class="text-sm fg-text-strong">Collection</span>
        </div>)}
      </div>
    </Demo>
  </ComponentSection>
  <ComponentSection id="surface-component" title="DemoSurface" description='The specimen component renders a flat sheet by default and rise-1 with elevation="raised".'>
    <Demo>
      <div class="grid-cols(1) gap-md w-full grid-cols(2)@sm">
        <DemoSurface class="p-md"><DemoLabel>flat</DemoLabel><p class="mb(0) mt-xs text-sm">Start with the collection overview and its key details.</p></DemoSurface>
        <DemoSurface elevation="raised" class="p-md"><DemoLabel>raised</DemoLabel><p class="mb(0) mt-xs text-sm">Continue through each column in reading order.</p></DemoSurface>
      </div>
    </Demo>
  </ComponentSection>
  <ComponentSection id="well" title="Well" description="Inputs, tracks and pressed states sink into a well.">
    <Demo padding="sm">
      <div class="grid gap-xs w-full (max-width:22rem) p-md ui-well"><DemoLabel>ui-well</DemoLabel><span class="text-sm">A sunken field for entry and selection.</span></div>
    </Demo>
  </ComponentSection>
</ComponentPage>
