---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoSwatch from '~/site/components/demo/DemoSwatch.svelte'

export const metadata = pageMetadata

const roles = [
  { label: 'Canvas', value: 'bg-surface-canvas' },
  { label: 'Raised', value: 'bg-surface-raised' },
  { label: 'Inset', value: 'bg-surface-inset' },
  { label: 'Blue 60', value: 'bg-blue-60' },
] as const
---

<ComponentPage title="Swatch" description="A sheet that shows a color role’s actual paint with its name and value underneath." usage={{ href: '/design-system#foundations', label: 'the design system overview' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="roles" title="Roles and steps">
    <Demo padding="sm">
      <div class="grid-cols(2) gap-sm w-full grid-cols(4)@sm">{roles.map(role => <DemoSwatch label={role.label} value={role.value} class={role.value} />)}</div>
    </Demo>
  </ComponentSection>
</ComponentPage>
