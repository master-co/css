---
import HoverInspection from '~/site/assets/images/home/icons/editor-hover-inspection.svg'
import hoverLight from '~/site/assets/images/home/icons/artwork/editor-hover-inspection-light.webp'
import hoverDark from '~/site/assets/images/home/icons/artwork/editor-hover-inspection-dark.webp'
import '~/site/assets/images/home/icons/artwork.css'
import Image from '~/site/docs-shell/components/Image.svelte'
import { editorFeatures } from '~/site/content/components/editor-content'

const copy = editorFeatures.find(card => card.id === 'hover')!
const themes = ['light', 'dark'] as const
// Each format renders the same subject: the vector SVG, or the themed WebP artwork.
const formats = ['svg', 'webp'] as const
---

<section class="hir-material-study" id="material-study" aria-labelledby="material-study-heading">
  <p class="hir-eyebrow">Material study · SVG / WebP</p>
  <h2 id="material-study-heading">Dense class strings, still readable.</h2>
  <p class="hir-material-intro">The same homepage copy, 96px canvas and approximately 80% visible width. Compare the rendered materials on both card backgrounds.</p>
  {themes.map(theme => <div class={`hir-material-theme hir-${theme}`}>
    <p class="hir-material-label">02 — Editor · {theme}</p>
    <div class="hir-material-pair">
      {formats.map(format => <div class="hir-material-option">
        <p>{format === 'svg' ? 'A · SVG' : 'B · WebP'}</p>
        <article class="hir-material-card">
          {format === 'svg'
            ? <HoverInspection width={96} height={96} aria-hidden="true" focusable="false" />
            : <Image src={theme === 'light' ? hoverLight : hoverDark} width={96} height={96} class="home-icon-artwork" alt="" aria-hidden="true" loading="eager" />}
          <div><h3>{copy.title}</h3><p>{copy.body}</p></div>
        </article>
        <div class="hir-material-sizes">
          {[64, 80, 96, 160].map(size => <figure>
            {format === 'svg'
              ? <HoverInspection width={size} height={size} aria-hidden="true" focusable="false" />
              : <Image src={theme === 'light' ? hoverLight : hoverDark} width={size} height={size} class="home-icon-artwork" alt="" aria-hidden="true" loading="eager" />}
            <figcaption>{size}px</figcaption>
          </figure>)}
        </div>
      </div>)}
    </div>
  </div>)}
</section>
