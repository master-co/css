---
import type { HomeIconDefinition } from '~/site/assets/images/home/icons/catalog'
import '~/site/assets/images/home/icons/artwork.css'
import Image from '~/site/docs-shell/components/Image.svelte'

interface Props {
  entry: HomeIconDefinition
  size?: number
  theme?: 'light' | 'dark'
}

/** Preview-only composition; homepage consumers can import each themed asset directly. */
const { entry, size = 96, theme } = Astro.props
---

{theme
  ? <Image src={entry.artwork[theme]} width={size} height={size} class="home-icon-artwork" alt="" aria-hidden="true" />
  : <span class="hir-artwork" style={{ width: `${size}px`, height: `${size}px` }} aria-hidden="true">
    <Image src={entry.artwork.light} width={size} height={size} class="hir-artwork-light home-icon-artwork" alt="" />
    <Image src={entry.artwork.dark} width={size} height={size} class="hir-artwork-dark home-icon-artwork" alt="" />
  </span>}
