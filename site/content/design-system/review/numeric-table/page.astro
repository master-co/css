---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import ThemeNumberVariableTable from '~/site/components/ThemeNumberVariableTable.astro'

export const metadata = pageMetadata
---

<ComponentPage kicker="Documents" title="Numeric tokens" description="Original values beside a useful comparison, from the active preset." usage={{ href: '/guide/layout-system#namespace-for-spacing', label: 'the Layout System guide' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="spacing" title="Spacing with its representation">
    <ThemeNumberVariableTable namespace="spacing" representation="spacing" />
  </ComponentSection>
</ComponentPage>
