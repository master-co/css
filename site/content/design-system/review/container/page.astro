---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import DemoContainer from '~/site/components/demo/DemoContainer.svelte'
import DemoPageViewport from '~/site/components/demo/DemoPageViewport.astro'

export const metadata = pageMetadata
---

<ComponentPage title="Container" description="The tray head holds a container range, Fit and the live width. The wrapper changes; the page viewport does not." usage={{ href: '/guide/responsive-design', label: 'the Responsive Design guide' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="query-card" title="A query card">
    <DemoContainer client:idle={{ timeout: 500 }} title="Query card" caption="Below 18rem of container width the regions stack.">
      <section class="overflow-hidden container-inline w-full b-solid b(1) b-line-divider r-lg bg-surface-raised">
        <div class="flex flex-col@container(width<=18rem)">
          <div class="(flex:1) p-md bg-surface-inset"><strong>Media</strong><p class="mb(0) mt-2xs text-sm fg-text-muted">A visual region</p></div>
          <div class="(flex:1) p-md"><strong>Content</strong><p class="mb(0) mt-2xs text-sm fg-text-muted">Stacks when this wrapper narrows.</p></div>
        </div>
      </section>
    </DemoContainer>
  </ComponentSection>
  <ComponentSection id="page-viewport" title="A whole page instead" description="When the lesson is about the viewport, show the real page in a browser instead of a container.">
    <DemoPageViewport src="/examples/layout-system" title="Workspace layout" height={360} />
  </ComponentSection>
</ComponentPage>
