---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import BenchmarkChart from '~/site/components/benchmarks/BenchmarkChart.astro'
import BenchmarkMetrics from '~/site/components/benchmarks/BenchmarkMetrics.astro'
import type { BenchmarkMetric } from '~/site/components/benchmarks/types'
import { StaticComparisonSummary } from '~/site/content/benchmarks/components/StaticTailwindComparison'

export const metadata = pageMetadata

const metrics: BenchmarkMetric[] = [
  { label: 'Fixture', value: 'dashboard', detail: 'Matched visual intent across variants' },
  { label: 'Median build', value: '148 ms', tone: 'good', detail: '10 measured command rounds' },
  { label: 'CSS rules', value: '1,284', detail: 'After static extraction and pruning' },
  { label: 'Long tasks', value: '0', tone: 'good', detail: 'Chromium trace sample' }
]
---

<ComponentPage kicker="Documents" title="Metric rows" description="Aligned values with their caveats." usage={{ href: '/benchmarks', label: 'the benchmarks' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="metrics" title="Metrics">
    <BenchmarkMetrics metrics={metrics} />
  </ComponentSection>
  <ComponentSection id="benchmarks" title="In the benchmarks">
    <BenchmarkChart chart={StaticComparisonSummary} />
  </ComponentSection>
</ComponentPage>
