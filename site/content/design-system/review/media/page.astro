---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoLabel from '~/site/components/demo/DemoLabel.svelte'
import DemoMedia from '~/site/components/demo/DemoMedia.svelte'

export const metadata = pageMetadata

const tones = ['neutral', 'blue', 'violet'] as const
---

<ComponentPage title="Media" description="A line drawing that takes a named tone through currentColor, or a real image with its intrinsic dimensions." usage={{ href: '/guide/responsive-design', label: 'the Responsive Design guide' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="tones" title="Artwork in a tone">
    <Demo padding="sm">
      <div class="grid-cols(1) gap-md w-full grid-cols(3)@sm">
        {tones.map(tone => <div class="grid gap-xs"><DemoLabel>tone=&quot;{tone}&quot;</DemoLabel><DemoMedia tone={tone} class="h-auto w-full r-sm" aria-label={`Mountain illustration in the ${tone} tone`} /></div>)}
      </div>
    </Demo>
  </ComponentSection>
  <ComponentSection id="image" title="A real image">
    <Demo padding="sm" caption="Text wraps around the floated image and continues in the remaining inline space.">
      <div class="(display:flow-root) w-full max-w-md text-sm">
        <DemoMedia src="/demo/landscape.svg" width={112} height={70} alt="Sun above layered mountains" class="(float:left) h-auto (width:7rem) mb-sm mr-md r-sm" />
        <p class="m(0)">Reset the float when the image should return to normal document flow. The image keeps its intrinsic ratio at every width.</p>
      </div>
    </Demo>
  </ComponentSection>
</ComponentPage>
