---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import Code from '~/site/docs-shell/components/Code.astro'
import StepSection from '~/site/docs-shell/components/StepSection.astro'
import Step from '~/site/docs-shell/components/Step.astro'
import StepL from '~/site/docs-shell/components/StepL.astro'
import StepR from '~/site/docs-shell/components/StepR.astro'

export const metadata = pageMetadata
---

<ComponentPage kicker="Documents" title="Steps" description="Each action beside its explanation and complete code; the numbered rail follows reading order." usage={{ href: '/guide/installation', label: 'the installation guides' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="sequence" title="Installation sequence">
    <StepSection>
      <Step $row>
        <StepL><h3>Create a project</h3><p>Start from a Vite project when you do not have an app yet.</p></StepL>
        <StepR><Code lang="sh" copyable={false} code={'npm create vite@latest my-app\ncd my-app'} /></StepR>
      </Step>
      <Step $row>
        <StepL><h3>Add Master CSS</h3><p>Run the installer from the project root.</p></StepL>
        <StepR><Code lang="sh" copyable={false} code="npm create @master/css@rc -- --yes" /></StepR>
      </Step>
      <Step $row>
        <StepL><h3>Run and style</h3><p>Start the dev server, then use Master CSS classes in your markup.</p></StepL>
        <StepR><Code lang="sh" copyable={false} code="npm run dev" /></StepR>
      </Step>
    </StepSection>
  </ComponentSection>
</ComponentPage>
