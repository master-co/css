---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoComparison from '~/site/components/demo/DemoComparison.svelte'
import DemoItem from '~/site/components/demo/DemoItem.svelte'
import ShadowScaleDemo from '~/site/components/demo/foundations/ShadowScaleDemo.astro'

export const metadata = pageMetadata
---

<ComponentPage title="Compare" description="Two stages side by side, each named by its condition. They stack when there is not enough room for both." usage={{ href: '/guide/colors#raised-surfaces', label: 'the Colors guide' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="conditions" title="Two conditions">
    <Demo title="Stacked below 40rem" frame="none" caption="Each stage is captioned with the condition it shows.">
      <DemoComparison items={[{ label: '@media (width < 40rem)', key: 'stacked' }, { label: '@media (width ≥ 40rem)', key: 'side' }]}>
        <div slot="stacked" class="grid gap-sm"><DemoItem tone="blue">01</DemoItem><DemoItem tone="blue">02</DemoItem></div>
        <div slot="side" class="flex gap-sm"><DemoItem tone="blue">01</DemoItem><DemoItem tone="blue">02</DemoItem></div>
      </DemoComparison>
    </Demo>
  </ComponentSection>
  <ComponentSection id="scale" title="A complete scale" description="A scale of more than two values is a grid of labelled specimens on one stage.">
    <ShadowScaleDemo />
  </ComponentSection>
</ComponentPage>
