---
import pageMetadata from './metadata'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import DemoPalette from '~/site/components/demo/DemoPalette.astro'

export const metadata = pageMetadata
---

<ComponentPage title="Palette" description="Every step of a preset hue as a copy action. One status line above the chips reports the actual clipboard result." usage={{ href: '/guide/colors', label: 'the Colors guide' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="families" title="Two families">
    <DemoPalette families={['blue', 'violet']} />
  </ComponentSection>
</ComponentPage>
