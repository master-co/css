---
import pageMetadata from './metadata'
import { brandAssets } from '~/site/common/brand'
import ComponentDocumentation from './content.mdx'
import ComponentPage from '../../components/ComponentPage.astro'
import ComponentSection from '../../components/ComponentSection.astro'
import DemoAsset from '~/site/components/demo/DemoAsset.astro'

export const metadata = pageMetadata
---

<ComponentPage title="Downloadable asset" description="Light and dark artwork sits on a sheet in its own mode; transparent artwork sits on a checkerboard. The download names its format." usage={{ href: '/brand', label: 'the brand page' }} Documentation={ComponentDocumentation}>
  <ComponentSection id="grounds" title="Grounds">
    <div class="grid-cols(1) gap-md grid-cols(2)@sm">
      <DemoAsset {...brandAssets[0]} />
      <DemoAsset {...brandAssets[1]} />
      <DemoAsset {...brandAssets[2]} surface="transparent" />
    </div>
  </ComponentSection>
</ComponentPage>
