---
import ProjectStyleExample from '~/site/components/demo/ProjectStyleExample.astro'
import { projectStyleExamples, type ProjectStyleName } from '~/site/components/demo/project-style-examples'
---

<div class="grid gap-xl">
  {(Object.keys(projectStyleExamples) as ProjectStyleName[]).map(name => <div>
    <ProjectStyleExample name={name} code={false} />
    <a class="inline-block mt-sm font-sm fg-text-link" href={projectStyleExamples[name].guide} aria-label={`Read the lesson: ${projectStyleExamples[name].title}`}>Read the lesson →</a>
  </div>)}
</div>
