---
import DemoPalette from '~/site/components/demo/DemoPalette.astro'
import FoundationColorRoles from '~/site/components/demo/foundations/FoundationColorRoles.astro'
import FoundationSurfaces from '~/site/components/demo/foundations/FoundationSurfaces.astro'
import FoundationLines from '~/site/components/demo/foundations/FoundationLines.astro'
import FoundationTextRoles from '~/site/components/demo/foundations/FoundationTextRoles.astro'
import FoundationHue from '~/site/components/demo/foundations/FoundationHue.astro'
import FoundationTextHue from '~/site/components/demo/foundations/FoundationTextHue.astro'
import FoundationElevation from '~/site/components/demo/foundations/FoundationElevation.astro'
import FoundationElevationState from '~/site/components/demo/foundations/FoundationElevationState.astro'

const examples = [
  ['Color roles', '/guide/colors#choose-a-color-token', FoundationColorRoles],
  ['Surface hierarchy', '/reference/tokens/color-roles#color-surface', FoundationSurfaces],
  ['Line roles', '/reference/tokens/color-roles#color-line', FoundationLines],
  ['Text roles', '/reference/tokens/color-roles#color-text', FoundationTextRoles],
  ['Base hue', '/guide/colors#mode-aware-hue-aliases', FoundationHue],
  ['Text hue', '/guide/colors#mode-aware-hue-aliases', FoundationTextHue],
  ['Quiet elevation', '/guide/colors#raised-surfaces', FoundationElevation],
  ['Interactive elevation', '/guide/colors#raised-surfaces', FoundationElevationState],
] as const
---

<div class="grid gap-2xl">
  <DemoPalette families={['blue', 'violet']} />
  {examples.map(([title, href, Component], index) => <section class="grid gap-sm" data-paint-recipe={index}>
    <div class="flex flex-wrap items-baseline justify-between gap-sm"><h3 class="m(0) font-md font-semibold fg-text-strong">{title}</h3><a href={href} class="font-sm fg-text-muted fg-text-strong:hover">View guide ↗</a></div>
    <Component />
  </section>)}
</div>
