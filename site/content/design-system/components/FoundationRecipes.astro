---
import FoundationBreakpoint from '~/site/components/demo/FoundationBreakpoint.astro'
import FoundationAxes from '~/site/components/demo/foundations/FoundationAxes.astro'
import FoundationContainerGrid from '~/site/components/demo/foundations/FoundationContainerGrid.astro'
import FoundationMedia from '~/site/components/demo/foundations/FoundationMedia.astro'
import FoundationRadius from '~/site/components/demo/foundations/FoundationRadius.astro'
import FoundationShapes from '~/site/components/demo/foundations/FoundationShapes.astro'
import FoundationShrink from '~/site/components/demo/foundations/FoundationShrink.astro'
import FoundationSizing from '~/site/components/demo/foundations/FoundationSizing.astro'
import DemoPageViewport from '~/site/components/demo/DemoPageViewport.astro'

const examples = [
  ['Viewport typography', '/guide/responsive-design#based-on-viewport-breakpoints', FoundationBreakpoint],
  ['Container grid', '/guide/responsive-design#based-on-container-sizes', FoundationContainerGrid],
  ['Container media object', '/guide/layout-system', FoundationMedia],
  ['Fluid wrapper and measured object', '/guide/layout-system#use-container-tokens', FoundationSizing],
  ['One axis or both', '/guide/layout-system#use-container-tokens', FoundationAxes],
  ['Shrinkable content', '/guide/layout-system#add-explicit-tracks-only-when-needed', FoundationShrink],
  ['Radius scale', '/guide/colors#raised-surfaces', FoundationRadius],
  ['Shape shortcuts', '/guide/colors#raised-surfaces', FoundationShapes],
] as const
---

<div class="grid gap-2xl">
  {examples.map(([title, href, Component], index) => <section class="grid gap-sm" data-foundation-recipe={index} id={index === 7 ? 'use-shape-shortcuts' : undefined}>
    <div class="flex flex-wrap items-baseline justify-between gap-sm"><h3 class="m(0) font-md font-semibold fg-text-strong">{title}</h3><a href={href} class="font-sm fg-text-muted fg-text-strong:hover">View guide ↗</a></div>
    <Component />
  </section>)}
  <DemoPageViewport src="/examples/layout-system" title="Workspace layout" height={540} />
</div>
