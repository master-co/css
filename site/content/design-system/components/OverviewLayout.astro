---
import '~/site/styles/design-system.css'
import DocMain from '~/site/docs-shell/components/DocMain.astro'
import ArticleHeader from '~/site/docs-shell/components/ArticleHeader.astro'
import { footerProps } from '~/site/navigation'

const { params, metadata, dictionaries } = Astro.props
---

<DocMain footerProps={footerProps}>
  <article class="ui-handbook ui-prose">
    <ArticleHeader locale={params.locale} metadata={metadata} dictionaries={dictionaries} toc={null} />
    <slot />
  </article>
</DocMain>
