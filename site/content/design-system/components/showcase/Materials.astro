---
import '~/site/styles/system/specimens.css'
import '~/site/styles/system/data.css'
import { siteOf } from '~/site/astro/site-context'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoItem from '~/site/components/demo/DemoItem.svelte'
import DemoLabel from '~/site/components/demo/DemoLabel.svelte'
import DemoSurface from '~/site/components/demo/DemoSurface.svelte'
import { elevationSteps, materialRoles } from '../catalog'

/** The ladder from page to overlay, the elevation order and the concentric radii. */
const { t } = siteOf(Astro)
---

<div class="ui-handbook-section">
  <div class="grid-cols(2) gap-sm grid-cols(3)@sm">
    {materialRoles.map(role => <figure class="ui-swatch">
      <div class="ui-swatch-paint" style={{ background: `var(${role.token})` }} aria-hidden="true" />
      <figcaption><b>{t(role.name)}</b><code>{role.token}</code></figcaption>
    </figure>)}
  </div>
  <Demo title="Elevation" description="sink < flat < rise-1 < rise-1h < rise-2 < rise-3 < overlay" background="dots"
    caption={t('Every layer doubles offset and blur while its spread pulls in. Hover lifts half a pixel to rise-1h; pressing sinks into the well.')}>
    <div class="grid-cols(2) gap-lg w-full grid-cols(4)@sm grid-cols(7)@md">
      {elevationSteps.map(step => <div class="grid (justify-items:center) gap-xs">
        <div class="r-md" style={{ width: '4rem', height: '4rem', background: step === 'sink' ? 'var(--ui-surface-well)' : 'var(--ui-surface-sheet)', boxShadow: `var(--ui-elevation-${step})` }} aria-hidden="true" />
        <DemoLabel>{step}</DemoLabel>
      </div>)}
    </div>
  </Demo>
  <Demo title="Concentric radii" description="3 · 4 · 6 · 8 · 10 · 14, nested by a 4px inset" caption={t('A tray of 14 holds a stage, code window or sheet of 10 at a 4px inset; a menu of 8 holds items of 4.')}>
    <div class="w-full (max-width:22rem)" style={{ padding: 'var(--ui-inset)', borderRadius: 'var(--ui-radius-2xl)', background: 'var(--ui-surface-tray)', boxShadow: 'inset 0 0 0 1px var(--ui-line-hair)' }}>
      <DemoSurface elevation="raised" class="grid gap-sm p-lg" style={{ borderRadius: 'var(--ui-radius-xl)' }}>
        <DemoLabel>Tray 14 → sheet 10</DemoLabel>
        <div class="flex gap-xs">{[3, 4, 6, 8].map(radius => <DemoItem class="min-w(0) p(0) font-xs" style={{ width: '3rem', height: '3rem', borderRadius: radius }}>{radius}</DemoItem>)}</div>
      </DemoSurface>
    </div>
  </Demo>
</div>
