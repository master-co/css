---
import '~/site/styles/documentation-index.css'
import { siteOf } from '~/site/astro/site-context'
import Link from '~/site/docs-shell/components/Link.svelte'
import { componentGroups } from '../catalog'

/** The component pages as a book's contents, like the Guide and Reference overviews: ruled spreads, not a wall of cards. */
const { t } = siteOf(Astro)
---

<div class="documentation-index">
  {componentGroups.map((group, index) => <section class="documentation-index-section" id={group.id} aria-labelledby={`${group.id}-title`}>
    <header>
      <small>{String(index + 1).padStart(2, '0')}</small>
      <h3 id={`${group.id}-title`}>{t(group.title)} <span class="documentation-index-count">{group.entries.length}</span></h3>
    </header>
    <ul class="documentation-index-links" data-described="">{group.entries.map(entry => <li><Link id={entry.id} href={`/design-system/review/${entry.slug}`}>
      <b>{t(entry.title)}</b><span>{t(entry.description)}</span>
    </Link></li>)}</ul>
  </section>)}
</div>
