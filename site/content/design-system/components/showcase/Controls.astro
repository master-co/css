---
import '~/site/styles/system/specimens.css'
import '~/site/styles/system/data.css'
import { siteOf } from '~/site/astro/site-context'
import Demo from '~/site/components/demo/Demo.svelte'
import DemoCopyButton from '~/site/components/demo/DemoCopyButton.svelte'
import ControlsGallery from '../../review/controls/ControlsGallery.svelte'

const { t } = siteOf(Astro)
---

<div class="ui-handbook-section">
  <ControlsGallery client:idle={{ timeout: 500 }} />
  <Demo title="Copy with an honest result" padding="sm" caption={t('The status beside the action reports the real clipboard result, including denial.')}>
    <DemoCopyButton client:idle={{ timeout: 500 }} value="var(--ui-surface-sheet)" label="Copy the sheet surface variable">{t('Copy surface')}</DemoCopyButton>
  </Demo>
</div>
