---
import IconArrowUpRight from '@tabler/icons-svelte-runes/icons/arrow-up-right'
import { siteOf } from '~/site/astro/site-context'
import Link from '~/site/docs-shell/components/Link.svelte'
import { recipeGroups } from '../catalog'

const { t } = siteOf(Astro)
---

<nav class="flex flex-wrap gap-xs" aria-label="Working recipe collections">{recipeGroups.map(group => <Link id={group.id} class="ui-button" data-size="sm" href={`/design-system/authoring#${group.id}`}>{t(group.title)}<IconArrowUpRight aria-hidden="true" /></Link>)}</nav>
