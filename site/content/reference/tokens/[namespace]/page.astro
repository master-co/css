---
import ReferencePage from '~/site/reference/ReferencePage.astro'
import TokenSheetView from '~/site/reference/TokenSheetView.astro'
import FamiliesSheetView from '~/site/reference/FamiliesSheetView.astro'
import { loadReferenceRoute, referenceMetadata } from '~/site/reference/reference-route'

type Props = { params: { locale: string; namespace: string } }

export async function generateMetadata({ params }: Props) {
  const { namespace, locale } = params
  return referenceMetadata(`tokens/${namespace}`, locale)
}

const { namespace } = Astro.props.params
const doc = await loadReferenceRoute(`tokens/${namespace}`, 'tokens')
const sheet = doc.sheet
if (sheet?.kind !== 'tokens' && sheet?.kind !== 'families') throw new Error(`Missing token sheet: ${doc.id}`)
---

<ReferencePage {...Astro.props} document={doc}>
  {sheet.kind === 'tokens' ? <TokenSheetView sheet={sheet} /> : <FamiliesSheetView sheet={sheet} />}
</ReferencePage>
