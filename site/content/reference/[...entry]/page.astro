---
import ReferencePage from '~/site/reference/ReferencePage.astro'
import NamedConditionsSheetView from '~/site/reference/NamedConditionsSheetView.astro'
import { loadReferenceRoute, referenceMetadata } from '~/site/reference/reference-route'

type Props = { params: { locale: string; entry: string[] } }

export async function generateMetadata({ params }: Props) {
  const { entry, locale } = params
  return referenceMetadata(entry.join('/'), locale)
}

const { entry, locale } = Astro.props.params
const doc = await loadReferenceRoute(entry.join('/'), locale)
---

{doc.sheet?.kind === 'named-conditions'
  ? <ReferencePage {...Astro.props} document={doc}><NamedConditionsSheetView sheet={doc.sheet} /></ReferencePage>
  : <ReferencePage {...Astro.props} document={doc} />}
