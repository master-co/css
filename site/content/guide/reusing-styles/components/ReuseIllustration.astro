---
import DocumentIllustration from '@master/internal-site/components/DocumentIllustration.astro'
import light from '../../../../assets/images/reusing-styles/shared-and-local-light.png'
import dark from '../../../../assets/images/reusing-styles/shared-and-local-dark.png'
import { reuseIllustration as figure } from '../illustration'
---

<DocumentIllustration title={figure.title} alt={figure.alt} images={{ light, dark }} caption={figure.caption}>
  <ol>
    {figure.description.map(item => <li><strong>{item.title}.</strong> {item.text}</li>)}
  </ol>
</DocumentIllustration>
