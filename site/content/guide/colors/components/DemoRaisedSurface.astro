---
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context.ts'
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import DemoThemeComparison from '@master/internal-site/demo/DemoThemeComparison.astro'

const copy = demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, 'DemoRaisedSurface', { title: 'A raised surface', caption: 'Identical classes in both documents. The surface, text and shadow colors come from the active mode; the shadow geometry stays the same.' })

const html = `<a class="block p-md r-lg bg-surface-raised fg-text-body shadow-sm shadow-md:hover shadow-md:focus-visible (text-decoration:none)" href="/guide/colors#raised-surfaces" target="_top">
<span class="flex items-center justify-between gap-sm">
<span class="text-md fg-text-strong">Field notes</span>
<span class="px-xs py-3xs pill bg-line-subtle text-xs fg-text-muted">12 new</span>
</span>
<span class="block mt-xs text-sm fg-text-muted">Hover or focus the card to lift it.</span>
</a>`
---

{/* One raised surface: role color, radius token, state elevation and a pill badge. */}
<DemoThemeComparison name="raised-surface" title={copy.title} html={html} height={160}
  caption={copy.caption} />
