---
import DocumentIllustration from '~/site/components/DocumentIllustration.astro'
import light from '../../../../assets/images/responsive-design/local-boundaries-light.png'
import dark from '../../../../assets/images/responsive-design/local-boundaries-dark.png'
import { responsiveIllustration as figure } from '../illustration'
---

<DocumentIllustration title={figure.title} alt={figure.alt} images={{ light, dark }} caption={figure.caption}>
  <ol>{figure.description.map(item => <li><strong>{item.title}.</strong> {item.text}</li>)}</ol>
</DocumentIllustration>
