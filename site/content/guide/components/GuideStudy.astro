interface Props {
  id: GuideStudyId
}

const images = {
  'pipes-and-quotes': { light: light0, dark: dark0 },
  'conditions-intersection': { light: light1, dark: dark1 },
  'inherited-alias': { light: light2, dark: dark2 },
  'delivery-substitution': { light: light3, dark: dark3 },
  'reuse-ownership': { light: light4, dark: dark4 },
  'independent-parameters': { light: light5, dark: dark5 },
  'local-color-scheme': { light: light6, dark: dark6 },
  'palette-or-role': { light: light7, dark: dark7 },
  'width-cap-growth': { light: light8, dark: dark8 },
  'grid-long-content': { light: light9, dark: dark9 },
  'type-content-height': { light: light10, dark: dark10 },
  'named-container-target': { light: light11, dark: dark11 },
  'responsive-local-change': { light: light12, dark: dark12 },
  'unlayered-obstacle': { light: light13, dark: dark13 },
  'defaults-inheritance': { light: light14, dark: dark14 },
  'delivery-not-scope': { light: light15, dark: dark15 },
  'stable-dynamic-value': { light: light16, dark: dark16 },
  'source-and-policy': { light: light17, dark: dark17 },
  'static-late-class': { light: light18, dark: dark18 },
  'progressive-known-class': { light: light19, dark: dark19 },
  'installation-observation': { light: light20, dark: dark20 },
  'fallback-addition': { light: light21, dark: dark21 },
  'migration-local-scope': { light: light22, dark: dark22 },
  'shared-source-inputs': { light: light23, dark: dark23 },
  'consumer-override': { light: light24, dark: dark24 },
  'editor-build-boundary': { light: light25, dark: dark25 },
  'lint-ownership': { light: light26, dark: dark26 },
  'inspection-coverage': { light: light27, dark: dark27 },
  'language-and-delivery': { light: light29, dark: dark29 },
}

const { id } = Astro.props
const study = figureCopy(documentCopyOf(Astro), siteOf(Astro).locale, `GuideStudy:${id}`, guideStudies[id])
---

<DocumentIllustration title={study.title} alt={study.alt} images={images[id]} caption={study.caption}>
  <p>{study.alt}</p>
</DocumentIllustration>
