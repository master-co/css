---
import Page from '~/site/docs-shell/factories/Page.astro'
import { createPageMetadata } from '~/site/docs-shell/factories/create-page'
import Layout from './components/BenchmarksLayout.astro'
import metadata from './metadata'
import dictionaries from '~/site/dictionaries'
import * as content from './content.mdx'

export const generateMetadata = createPageMetadata(metadata, dictionaries)
---

<Page {...Astro.props} {metadata} {dictionaries} categories={[]} {content} {Layout} />
