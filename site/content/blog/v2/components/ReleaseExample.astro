---
import ConfiguredExample from '~/site/reference/ConfiguredExample.astro'
import DemoConfiguredExample from '~/site/components/demo/DemoConfiguredExample.astro'
import { componentMarkup, componentSource, themeMarkup, themeSource } from '../examples'

interface Props {
  name: 'theme' | 'component'
}

const { name } = Astro.props
---

{name === 'theme'
  ? <DemoConfiguredExample name="fieldwork-theme" title="A field note, in your colors" source={themeSource} html={themeMarkup} theme caption="Switch the color scheme: the accent and surface respond together, while the story’s spacing stays the same. Open the field note to read on." />
  : <ConfiguredExample source={componentSource} html={componentMarkup} />}
