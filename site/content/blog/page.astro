---
import '~/site/styles/blog-materials.css'
import '~/site/styles/blog.css'
import Footer from '~/site/docs-shell/components/Footer.svelte'
import pageCategories from '~/site/.categories/blog.json'
import { footerProps } from '~/site/navigation'
import dayjs from 'dayjs'
import Link from '~/site/docs-shell/components/Link.svelte'
import TitleLines from '~/site/components/blog/article/title-lines.astro'
import metadata from './metadata'
import generate from '~/site/docs-shell/utils/generate-metadata'
import dictionaries from '~/site/dictionaries'
import { createTranslation } from '~/site/docs-shell/utils/i18n'

// The index lists articles; it renders no document surfaces, code or prose.
export const documentStyles = false

export async function generateMetadata(props: any) {
  return await generate(metadata, props, dictionaries)
}

interface BlogPage {
  title: string
  description: string
  category?: string
  authors: { name: string }[]
  date: string
  pathname: string
}

const { locale } = Astro.props.params
const tw = locale === 'tw'
const $ = await createTranslation(locale, dictionaries)
const pages: BlogPage[] = pageCategories
  .flatMap(({ pages }) => pages)
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))
const latest = pages[0]
// A category every post shares says nothing about any one of them.
const showCategory = new Set(pages.map((page) => page.category ?? '')).size > 1
// The timeline names each year once, beside its posts; a post shows only its day (its full date is still read).
const yearOf = (value: string) => dayjs(value).format('YYYY')
const day = (value: string) => dayjs(value).format(tw ? 'M 月 D 日' : 'MMMM D')
const years = pages.reduce<{ year: string, pages: BlogPage[] }[]>((groups, page) => {
  const group = groups.at(-1)
  if (group?.year === yearOf(page.date)) group.pages.push(page)
  else groups.push({ year: yearOf(page.date), pages: [page] })
  return groups
}, [])
const slug = (page: BlogPage) => page.pathname.split('/').at(-1)
// A post not yet translated keeps its English text on /tw; say so, so it is set and read as English.
const lang = (text: string) => (tw && $(text) === text ? 'en' : undefined)
// A link is named by its title and described by its date, category (when shown) and description.
const describedBy = (page: BlogPage) => [`post-${slug(page)}-date`, showCategory && page.category && `post-${slug(page)}-category`, `post-${slug(page)}-description`].filter(Boolean).join(' ')
---

<main class="blog-index blog-materials">
  <header class="blog-masthead blog-rails">
    <h1 class="blog-hatch-text blog-masthead-title">{tw ? <Fragment>最新消息<wbr />與筆記</Fragment> : 'News and notes'}</h1>
  </header>
  {years.map(({ year, pages: posts }) => (
    // A year is a heading, not a landmark: a long archive would otherwise list one region per year.
    <section class="blog-rails blog-rails-rule blog-year">
      <h2 class="blog-year-label">{year}</h2>
      {/* Preserve WebKit list semantics when list-style is none. */}
      <ol class="blog-year-posts" role="list">
        {posts.map((page) => (
          <li class="blog-entry">
            {page === latest && <span class="blog-entry-signal blog-signal" aria-hidden="true" />}
            <Link href={page.pathname} class="blog-entry-link blog-marks" aria-labelledby={`post-${slug(page)}`} aria-describedby={describedBy(page)}>
              <span class="blog-entry-meta">
                <time id={`post-${slug(page)}-date`} datetime={page.date}>{tw ? <Fragment><span class="sr-only">{year} 年 </span>{day(page.date)}</Fragment> : <Fragment>{day(page.date)}<span class="sr-only">, {year}</span></Fragment>}</time>
                {showCategory && page.category && <span id={`post-${slug(page)}-category`}>{$(page.category)}</span>}
              </span>
              <h3 id={`post-${slug(page)}`} class="blog-entry-title" lang={lang(page.title)}><TitleLines title={$(page.title)} class="blog-title-half" /></h3>
              <p id={`post-${slug(page)}-description`} class="blog-entry-description" lang={lang(page.description)}>{$(page.description)}</p>
            </Link>
          </li>
        ))}
      </ol>
    </section>
  ))}
  {years.length > 0 && <div class="blog-rails-rule blog-timeline-end" aria-hidden="true" />}
</main>
<Footer client:load {...footerProps} class="app-wrapper" />
