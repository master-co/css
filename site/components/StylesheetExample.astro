---
import DocumentCodeExample from './DocumentCodeExample.astro'
import { stylesheetExampleCSS } from '../reference/stylesheet-example'

interface Props {
  title: string
  source: string
}

/** Server-only: source and its complete compiled CSS, without a simulated preview. */
const { title, source } = Astro.props
const css = await stylesheetExampleCSS(source)
---

<DocumentCodeExample title={title} language="css" source={source} result={css} resultKind="generated-css" />
