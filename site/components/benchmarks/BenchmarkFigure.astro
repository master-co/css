---
import '~/site/styles/system/data.css'
import { siteOf } from '~/site/astro/site-context'
import RenderNode from '~/site/docs-shell/components/RenderNode.astro'

interface Props {
  title?: unknown
  description?: unknown
  caption?: unknown
  class?: string
}

/** A titled chart, its sample context and its caption as one figure. */
const { title, description, caption, class: className } = Astro.props
const { t } = siteOf(Astro)
const text = (node: unknown) => typeof node === 'string' ? t(node) : node
---

<figure class={className ? `ui-tray ${className}` : 'ui-tray'}>
  {(title || description) && (
    <div class="ui-tray-head">
      <div>
        {title && <p class="ui-tray-title"><RenderNode node={text(title)} /></p>}
        {description && <p class="ui-tray-description"><RenderNode node={text(description)} /></p>}
      </div>
    </div>
  )}
  <slot />
  {caption && <figcaption class="ui-tray-caption"><RenderNode node={text(caption)} /></figcaption>}
</figure>
