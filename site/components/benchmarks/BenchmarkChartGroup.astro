---
import '~/site/styles/system/data.css'
import { siteOf } from '~/site/astro/site-context'
import BenchmarkBarRows from './BenchmarkBarRows.astro'
import type { BenchmarkBarItem } from './types'

interface Props {
  title: string
  detail?: string
  items: BenchmarkBarItem[]
  unit?: string
}

/** One metric in one chart frame: its name, statistic and unit stay with the bars. */
const { title, detail = 'Median', items, unit = 'ms' } = Astro.props
const { t } = siteOf(Astro)
---

<div class="ui-chart">
  <div class="ui-chart-head">
    <div><b>{t(title)}</b><small>{t(detail)} · {unit}</small></div>
  </div>
  <BenchmarkBarRows items={items} unit={unit} />
</div>
