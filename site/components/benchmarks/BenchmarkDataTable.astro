---
import '~/site/styles/system/data.css'
import '~/site/styles/benchmarks.css'
import { siteOf } from '~/site/astro/site-context'
import BenchmarkScrollRegion from './BenchmarkScrollRegion.svelte'

interface Props {
  title: string
}

/** Native disclosure preserves the full server-rendered table; keyboard scrolling is isolated. */
const { title } = Astro.props
const { t } = siteOf(Astro)
---

<details class="ui-disclosure" data-variant="rule">
  <summary>
    {t(title)}
    <span class="ui-disclosure-meta">{t('Complete measurements')}</span>
  </summary>
  <div class="ui-disclosure-body">
    <BenchmarkScrollRegion title={title} client:idle={{ timeout: 500 }}><slot /></BenchmarkScrollRegion>
  </div>
</details>
