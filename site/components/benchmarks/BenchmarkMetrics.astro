---
import '~/site/styles/system/data.css'
import { siteOf } from '~/site/astro/site-context'
import BenchmarkStatus from './BenchmarkStatus.astro'
import type { BenchmarkMetric } from './types'

interface Props {
  metrics: BenchmarkMetric[]
}

const { metrics } = Astro.props
const { t } = siteOf(Astro)
---

<div class="ui-metrics">
  {metrics.map((metric) => (
    <div class="ui-metric">
      <small>{t(metric.label)}</small>
      <b>{metric.value}</b>
      {(metric.detail || (metric.tone && metric.tone !== 'neutral')) && <p><BenchmarkStatus tone={metric.tone} /> {metric.detail && t(metric.detail)}</p>}
    </div>
  ))}
</div>
