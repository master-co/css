---
import '~/site/styles/system/data.css'
import '~/site/styles/benchmarks.css'
import BenchmarkBarRows from './BenchmarkBarRows.astro'
import type { BenchmarkBarsProps } from './types'

interface Props extends BenchmarkBarsProps {
  class?: string
}

const { class: className, ...props } = Astro.props
---

<div class={className ? `ui-chart ${className}` : 'ui-chart'}><BenchmarkBarRows {...props} /></div>
