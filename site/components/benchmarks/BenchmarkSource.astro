---
import '~/site/styles/system/data.css'
import { siteOf } from '~/site/astro/site-context'

interface Props {
  generatedAt: string
  href: string
  label?: string
}

/** The evidence and its date stay beside the claim. */
const { generatedAt, href, label = 'Committed snapshot' } = Astro.props
const { t } = siteOf(Astro)
---

<p class="ui-source">
  {t('Evidence')}
  <a href={href}>{t(label)}</a>
  <span>{t('Recorded')} <time datetime={generatedAt}>{generatedAt.slice(0, 10)} UTC</time></span>
</p>
