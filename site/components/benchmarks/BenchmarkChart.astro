---
import ExpandContent from '~/site/docs-shell/components/ExpandContent.svelte'
import BenchmarkBars from './BenchmarkBars.astro'
import BenchmarkMetricTable from './BenchmarkMetricTable.astro'
import BenchmarkStackedBars from './BenchmarkStackedBars.astro'
import type { BenchmarkChartModel } from './types'

interface Props {
  chart: BenchmarkChartModel
}

/** Renders an authored chart model; `utils/benchmark-content` exports the same model as Markdown. */
const { chart } = Astro.props
---

{chart.kind === 'bars' && <BenchmarkBars items={chart.items} max={chart.max} unit={chart.unit} valueFormatter={chart.valueFormatter} />}
{chart.kind === 'stacked-bars' && <BenchmarkStackedBars items={chart.items} max={chart.max} unit={chart.unit} valueFormatter={chart.valueFormatter} />}
{chart.kind === 'metric-table' && <BenchmarkMetricTable label={chart.label} metrics={chart.metrics} />}
{chart.kind === 'chart-groups' && (
  <div class="grid gap-lg">
    {chart.groups.map((group) => (
      <div class="grid gap-sm">
        <div class="flex items-baseline justify-between gap-md">
          <h4 class="m(0) font-sm (font-weight:var(--ui-weight-medium)) fg-text-strong">{group.title}</h4>
          <span class="font-xs fg-text-muted">{group.detail}</span>
        </div>
        <BenchmarkBars items={group.items} unit={group.unit} />
      </div>
    ))}
  </div>
)}
{chart.kind === 'data-table' && (
  <ExpandContent client:idle={{ timeout: 500 }}>
    {/* Preserve keyboard access to wide result tables. */}
    <div class="ui-table" data-numeric-from={chart.numericFrom} role="region" aria-label={chart.label} tabindex="0">
      <table>
        <thead>
          <tr>
            {chart.headers.map((header) => <th>{header}</th>)}
          </tr>
        </thead>
        <tbody>
          {chart.rows.map(([rowHeader, ...cells]) => (
            <tr>
              <th>{rowHeader}</th>
              {cells.map((cell) => <td>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </ExpandContent>
)}
