---
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context'
import DocumentOptions from '@master/internal-site/components/DocumentOptions.astro'
import { agentOptionGroup } from '../utils/agent-options'

interface Props {
  name: string
}

const { name } = Astro.props
const copy = demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, `AgentOptions:${name}`, agentOptionGroup(name))

---

<div data-agent-options={name}><DocumentOptions {...copy} /></div>
