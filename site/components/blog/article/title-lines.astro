---
import { titleParts } from './title-parts'

interface Props {
  title: string
  class: string
}

/** The title, split at its colon into lines the stylesheet sets apart; see `titleParts`. */
const { title, class: className } = Astro.props
const parts = titleParts(title)
---

{parts ? <Fragment><span class={className}>{parts.first}</span>{parts.space ? ' ' : null}<span class={className}>{parts.second}</span></Fragment> : title}
