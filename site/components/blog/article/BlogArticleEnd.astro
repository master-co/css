---
import dayjs from 'dayjs'
import IconArrowLeft from '@tabler/icons-svelte-runes/icons/arrow-left'
import IconArrowRight from '@tabler/icons-svelte-runes/icons/arrow-right'
import Link from '~/site/docs-shell/components/Link.svelte'
import { siteOf } from '~/site/astro/site-context'
import TitleLines from './title-lines.astro'
import { sourceLanguageOf } from './language'
import type { BlogArticleNeighbor } from './neighbors'

interface Props {
  newer?: BlogArticleNeighbor
  older?: BlogArticleNeighbor
  showCategory?: boolean
}

/**
 * The close of a post, set like its header: an eyebrow, the next read as an open title with its italic description
 * (marked on hover with the index's artboard corners, not a card), then the other neighbour and the way back to every
 * article as quiet links.
 */
const { newer, older, showCategory = true } = Astro.props
const { t: $, i18n, locale } = siteOf(Astro)
const tw = locale === 'tw'
const languageOf = (text?: string) => sourceLanguageOf(text, { ...i18n, locale })
// Readers who finish a post usually continue backwards through the archive; the newest post leads with the one before it.
const lead = older ?? newer
const other = lead === older ? newer : undefined
// Written out in full, as on the post's own header and on the index's featured sheet.
const date = (value: string) => dayjs(value).format(tw ? 'YYYY 年 M 月 D 日' : 'MMMM D, YYYY')
---

<nav class="blog-article-end blog-rails blog-rails-rule" aria-labelledby="blog-article-end-title">
  <p class="blog-article-end-title" id="blog-article-end-title">{$('Keep reading')}</p>
  {lead && (
    <Link class="blog-article-next blog-marks" href={lead.pathname}>
      <span class="blog-article-next-meta">
        {showCategory && lead.category && <span>{$(lead.category)}</span>}
        <time datetime={lead.date}>{date(lead.date)}</time>
      </span>
      <span class="blog-article-next-title" lang={languageOf(lead.title)}><TitleLines title={$(lead.title)} class="blog-article-next-title-line" /><IconArrowRight class="blog-article-next-arrow" aria-hidden="true" size={22} stroke={1.25} /></span>
      {lead.description && <span class="blog-article-next-description" lang={languageOf(lead.description)}>{$(lead.description)}</span>}
    </Link>
  )}
  <div class="blog-article-end-links">
    <Link class="blog-article-end-link" href="/blog"><IconArrowLeft aria-hidden="true" size={14} stroke={1.75} />{$('All articles')}</Link>
    {other && (
      <Link class="blog-article-end-link" href={other.pathname}>
        <span class="blog-article-end-link-label">{$('Newer')}</span>
        <span class="blog-article-end-link-title" lang={languageOf(other.title)}>{$(other.title)}</span>
        <IconArrowRight aria-hidden="true" size={14} stroke={1.75} />
      </Link>
    )}
  </div>
</nav>
