---
import dayjs from 'dayjs'
import authors from '~/site/docs-shell/data/authors'
import Image from '~/site/docs-shell/components/Image.svelte'
import Link from '~/site/docs-shell/components/Link.svelte'
import { siteOf } from '~/site/astro/site-context'
import TitleLines from './title-lines.astro'
import { sourceLanguageOf } from './language'

interface Props {
  metadata: any
}

/**
 * The post's own header, the first section of the drawing: a quiet line of category and date, the title in a soft
 * stone tone, the description, and the authors. Nothing moves and nothing glows; the page's one light simply
 * falls on it from above and to the left.
 */
const { metadata } = Astro.props
const { t: $, i18n, locale } = siteOf(Astro)
const tw = locale === 'tw'
const source: string = metadata.title?.absolute || metadata.title
const title: string = $(source)
const languageOf = (text?: string) => sourceLanguageOf(text, { ...i18n, locale })
const people = (metadata.authors ?? [])
  .map(({ name }: { name: string }) => authors.find((author) => author.name === name))
  .filter(Boolean) as typeof authors
---

<header class="blog-article-masthead blog-rails">
  {(metadata.category || metadata.date) && (
    <p class="blog-article-meta">
      {metadata.category && <span>{$(metadata.category)}</span>}
      {metadata.date && <time datetime={metadata.date}>{dayjs(metadata.date).format(tw ? 'YYYY 年 M 月 D 日' : 'MMMM D, YYYY')}</time>}
    </p>
  )}
  <h1 class="blog-article-title blog-stone-text" lang={languageOf(source)}><TitleLines title={title} class="blog-article-title-line" /></h1>
  {metadata.description && <p class="blog-article-dek" lang={languageOf(metadata.description)}>{$(metadata.description)}</p>}
  {people.length > 0 && (
    <div class="blog-article-byline">
      <span class="blog-article-byline-label">{$('Written by')}</span>
      <ul class="blog-article-authors">
        {people.map((author) => (
          <li>
            {author.url ? (
              <Link class="blog-article-author" href={author.url}>
                <Image class="blog-article-avatar" src={author.image} width={28} height={28} alt="" />
                <span>{author.name}</span>
              </Link>
            ) : (
              <span class="blog-article-author">
                <Image class="blog-article-avatar" src={author.image} width={28} height={28} alt="" />
                <span>{author.name}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )}
</header>
