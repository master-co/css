---
import '~/site/styles/system/data.css'
import '~/site/styles/installation.css'
import Link from '~/site/docs-shell/components/Link.svelte'
import brands from '~/site/docs-shell/data/brands'
import { installationGuideGroups } from '../utils/installation-guides'

/** A grouped directory; framework aliases keep their existing guide anchors. */
---

<nav aria-label="Installation guides" class="installation-guides">
  {installationGuideGroups.map(group => <div class="installation-guides-group">
    <p class="installation-guides-label">{group.title}</p>
    <div class="ui-logos">
      {group.entries.map(([slug, title, href]) => {
        const brand = brands[slug]
        const Logo = brand.src
        return <Link href={href}>
          <Logo class={brand.className} width={20} height={20} aria-hidden="true" />
          <span>{title}</span>
        </Link>
      })}
    </div>
  </div>)}
</nav>
