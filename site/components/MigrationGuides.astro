---
import brands from '@master/internal-site/data/brands'
import DocumentChoices from '@master/internal-site/components/DocumentChoices.astro'
import { migrationGuides } from '../utils/migration-guides'
---

<DocumentChoices label="Migration guides" entries={migrationGuides.map(guide => {
  const { src: Icon, className } = brands[guide.brand]
  return { ...guide, href: `/guide/migration/${guide.slug}`, icon: <Icon class={className} width={20} height={20} aria-hidden="true" /> }
})} />
