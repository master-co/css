---
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context'
import DocumentPrompt from '@master/internal-site/components/DocumentPrompt.astro'
import { agentPrompt } from '../utils/agent-guide-data'

interface Props {
  name: string
}

const { name } = Astro.props
const copy = demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, `AgentPrompt:${name}`, agentPrompt(name))

---

<div data-agent-prompt={name}><DocumentPrompt {...copy} /></div>
