---
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context'
import DocumentPrompt from '@master/internal-site/components/DocumentPrompt.astro'
import { agentPrompt, resolveAgentPrompt } from '../utils/agent-guide-data'

interface Props {
  name: string
}

const { name } = Astro.props
const copy = resolveAgentPrompt(demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, `AgentPrompt:${name}`, agentPrompt(name)), {
  version: import.meta.env.PUBLIC_VERSION, docsURL: import.meta.env.PUBLIC_URL
})

---

<div data-agent-prompt={name}><DocumentPrompt {...copy} /></div>
