---
import SharedClass2CSS from '@master/internal-site/css/Class2CSS.astro'
import type { CodeProp } from '@master/internal-site/components/code-props'
import { slotText } from '@master/internal-site/utils/slot-text'

type Props = Partial<CodeProp> & {
  /** The classes to compile, as a list or a space-separated string. Text children work too: `<Class2CSS>p-md shadow-md</Class2CSS>`. */
  classes?: string | readonly string[]
}

// A slot renders an array of strings as one joined text, so lists of classes come through `classes`.
const { classes = await slotText(Astro.slots), ...props } = Astro.props
---

<SharedClass2CSS {...props} classes={classes} />
