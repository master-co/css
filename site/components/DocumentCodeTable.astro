---
import '~/site/styles/system/data.css'

interface Props {
  label?: string
  rows: { syntax: string, css: string }[]
}

/** Preserve short syntax tokens while allowing native CSS to wrap at its spaces. */
const { label = 'Syntax', rows } = Astro.props
---

{/* The table's narrow overflow region must be focusable for native keyboard scrolling. */}
<div class="ui-table" data-variant="lookup" role="region" aria-label={`${label} and CSS`} tabindex="0"><table>
  <thead><tr><th scope="col">{label}</th><th scope="col">CSS</th></tr></thead>
  <tbody>{rows.map(({ syntax, css }) => <tr>
    <th scope="row"><code>{syntax}</code></th><td><code>{css}</code></td>
  </tr>)}</tbody>
</table></div>
