---
import '~/site/styles/system/data.css'
import { siteOf } from '~/site/astro/site-context'
import { uniqueId } from '~/site/docs-shell/utils/unique-id'
import InlineCode from '~/site/docs-shell/components/InlineCode.astro'
import RenderNode from '~/site/docs-shell/components/RenderNode.astro'
import { filterNamespaceKeys } from '~/site/utils/manifest-utilities'
import type { NamespaceUtilityGroup } from './document-types'

export type { NamespaceUtilityGroup } from './document-types'

interface Props {
  groups: NamespaceUtilityGroup[]
}

const { t } = siteOf(Astro)
const captionId = uniqueId(Astro, 'namespace-utility-table')
const groups = Astro.props.groups
  .map((group) => ({
    ...group,
    keys: filterNamespaceKeys(group)
  }))
  .filter((group) => group.keys.length)
const hasDescriptions = groups.some((group) => group.description)
---

{/* The table's narrow overflow region must be focusable for native keyboard scrolling. */}
<div class="ui-table" role="region" aria-labelledby={captionId} tabindex="0">
  <table>
    <caption id={captionId} class="sr-only">{t('Utility groups table')}</caption>
    <thead>
      <tr>
        <th scope="col">{t('Group')}</th>
        <th scope="col">{t('Utility keys')}</th>
        {hasDescriptions && <th scope="col">{t('Description')}</th>}
      </tr>
    </thead>
    <tbody>
      {
        groups.map((group) => (
          <tr>
            <th scope="row">{t(group.label)}</th>
            <td>{group.keys.map((key, index) => <span><InlineCode code={key} />{index !== group.keys.length - 1 && ', '}</span>)}</td>
            {hasDescriptions && <td>{typeof group.description === 'string' ? t(group.description) : <RenderNode node={group.description} />}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
