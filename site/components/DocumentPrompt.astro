---
import DocumentCopyButton from './DocumentCopyButton.svelte'
import type { DocumentPromptProps } from './document-types'

export type { DocumentPromptProps } from './document-types'

type Props = DocumentPromptProps

/** Readable prose preserves its exact clipboard text while wrapping within the document. */
const { title, text } = Astro.props
---

<figure class="ui-prompt" aria-label={title}>
  <figcaption class="ui-code-bar"><span class="ui-code-file">{title}</span><DocumentCopyButton client:idle={{ timeout: 500 }} text={text} label={title} /></figcaption>
  <p class="ui-prompt-body">{text}</p>
</figure>
