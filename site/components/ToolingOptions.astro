---
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context'
import DocumentOptions from '@master/internal-site/components/DocumentOptions.astro'
import { toolingOptionGroup, toolingOptions } from '../utils/tooling-guide-data'

interface Props {
  name: keyof typeof toolingOptions
}

const { name } = Astro.props
const copy = demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, `ToolingOptions:${name}`, toolingOptionGroup(name))

---

<div data-tooling-options={name}><DocumentOptions {...copy} /></div>
