---
import '~/site/styles/system/data.css'
import '~/site/styles/system/specimens.css'
import RenderNode from '~/site/docs-shell/components/RenderNode.astro'
import DocumentIdentifier from './DocumentIdentifier.astro'
import type { DocumentParameter } from './document-types'

export type { DocumentParameter } from './document-types'

interface Props {
  label: string
  parameters: readonly DocumentParameter[]
}

/** Name, type and requirement read as one term; descriptions use the remaining width. */
const { label, parameters } = Astro.props
---

<dl class="ui-params" aria-label={label}>
  {parameters.map(parameter => <div>
    <dt>
      <span><DocumentIdentifier text={parameter.name} /></span>
      <small>{parameter.type}</small>
      {parameter.requirement && (/^required$/i.test(parameter.requirement)
        ? <span class="ui-badge" data-size="sm">{parameter.requirement}</span>
        : <small>{parameter.requirement}</small>)}
    </dt>
    <dd><p><RenderNode node={parameter.description} /></p></dd>
  </div>)}
</dl>
