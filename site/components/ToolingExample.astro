---
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context'
import DocumentCodeExample from '@master/internal-site/components/DocumentCodeExample.astro'
import { toolingExample, toolingExamples } from '../utils/tooling-guide-data'

interface Props {
  name: keyof typeof toolingExamples
}

const { name } = Astro.props
const copy = demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, `ToolingExample:${name}`, toolingExample(name))

---

<div data-tooling-example={name}><DocumentCodeExample {...copy} /></div>
