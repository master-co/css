---
import '~/site/styles/system/data.css'
import IconAlertTriangle from '@tabler/icons-svelte-runes/icons/alert-triangle'
import IconCircleX from '@tabler/icons-svelte-runes/icons/circle-x'
import RenderNode from '~/site/docs-shell/components/RenderNode.astro'
import GeneratedCSS from './GeneratedCSS.astro'
import type { DocumentCodeExampleViewProps } from './document-types'

export type { DocumentCodeExampleViewProps } from './document-types'

type Props = DocumentCodeExampleViewProps

/**
 * Static, verified source/output pair in one tray. It does not simulate an editor or execute code.
 * The code blocks arrive as the `sourceCode`/`resultCode` props, or as slots of the same names.
 */
const { title, sourceCode, resultCode, resultKind, diagnostic } = Astro.props
const DiagnosticIcon = diagnostic?.severity === 'Error' ? IconCircleX : IconAlertTriangle
const hasResult = resultCode != null || Astro.slots.has('resultCode')
---

<figure class="ui-tray" aria-label={title}>
  <figcaption class="ui-tray-head"><p class="ui-tray-title">{title}</p></figcaption>
  {sourceCode != null ? <RenderNode node={sourceCode} /> : <slot name="sourceCode" />}
  {diagnostic && <div class="ui-callout" data-tone={diagnostic.severity === 'Error' ? 'danger' : 'warning'}>
    <DiagnosticIcon stroke={1.6} aria-hidden="true" />
    <div>
      <p><b>{diagnostic.severity}</b> · <code>{diagnostic.rule}</code></p>
      <p>{diagnostic.message}</p>
    </div>
  </div>}
  {hasResult && (resultKind === 'generated-css'
    ? <GeneratedCSS>{resultCode != null ? <RenderNode node={resultCode} /> : <slot name="resultCode" />}</GeneratedCSS>
    : resultCode != null ? <RenderNode node={resultCode} /> : <slot name="resultCode" />)}
</figure>
