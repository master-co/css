---
import '~/site/styles/system/data.css'
import RenderNode from '~/site/docs-shell/components/RenderNode.astro'
import DocumentOptionEntry from './DocumentOptionEntry.astro'
import DocumentOptionList from './DocumentOptionList.astro'
import type { DocumentOption } from './document-types'


interface Props {
  label: string
  options: readonly DocumentOption[]
}

/** Names keep their own column; defaults and prose stay readable on mobile. */
const { label, options } = Astro.props
---

<DocumentOptionList label={label}>
  {options.map(option => <DocumentOptionEntry name={option.name}>
    {option.defaultValue !== undefined && <small>Default <code>{option.defaultValue}</code></small>}
    <p><RenderNode node={option.description} /></p>
  </DocumentOptionEntry>)}
</DocumentOptionList>
