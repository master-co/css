---
import '~/site/styles/documentation-illustration.css'
import IconArrowsMaximize from '@tabler/icons-svelte-runes/icons/arrows-maximize'
import Image from '../docs-shell/components/Image.svelte'
import type { IllustrationImages } from './document-types'

export type { IllustrationImages } from './document-types'

interface Props {
  title: string
  alt: string
  images: IllustrationImages
  caption: string
  fullSize?: boolean
}

/** A static figure with one accessible image and an independent text description. */
const { title, alt, images, caption, fullSize = false } = Astro.props
---

<figure class="ui-tray" aria-label={title} data-illustration-expandable={fullSize || undefined}>
  <figcaption class="ui-tray-head">
    <p class="ui-tray-title">{title}</p>
    {fullSize && (['light', 'dark'] as const).map(scheme => <a
      class="document-illustration-expand ui-button"
      data-variant="quiet" data-shape="icon" data-size="sm" data-scheme={scheme}
      href={images[scheme].src} target="_blank" rel="noopener noreferrer"
      aria-label={`View full-size illustration: ${title} (opens in a new tab)`}
      title="View full-size illustration (opens in a new tab)"
    ><IconArrowsMaximize aria-hidden="true" /></a>)}
  </figcaption>
  <div class="document-illustration" role="img" aria-label={alt}>
    {(['light', 'dark'] as const).map(scheme => <Image
      src={images[scheme]}
      data-scheme={scheme}
      sizes="(max-width: 834px) 100vw, 900px"
      alt=""
      aria-hidden="true"
    />)}
  </div>
  <p class="ui-tray-caption">{caption}</p>
  <details class="ui-disclosure" data-variant="text-description">
    <summary>Text description</summary>
    <div class="ui-disclosure-body ui-tray-caption"><slot /></div>
  </details>
</figure>
