---
import Code from '~/site/docs-shell/components/Code.astro'
import DocumentCodeExampleView from './DocumentCodeExampleView.astro'
import type { DocumentCodeExampleProps } from './document-types'

export type { DocumentCodeExampleProps } from './document-types'

type Props = DocumentCodeExampleProps

/** Labels name the two sides of a pair; a source alone, or above its Generated CSS disclosure, needs none. */
const { language, resultLanguage = language, source, result, sourceLabel, resultLabel = 'Result', ...props } = Astro.props
const pair = result !== undefined && props.resultKind !== 'generated-css'
---

<DocumentCodeExampleView {...props}>
  <Code slot="sourceCode" lang={language} name={sourceLabel ?? (pair ? 'Source' : undefined)} code={source} />
  {result !== undefined && (props.resultKind === 'generated-css'
    ? <Code slot="resultCode" lang={resultLanguage} code={result} />
    : <Code slot="resultCode" lang={resultLanguage} name={resultLabel} code={result} />)}
</DocumentCodeExampleView>
