---
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context'
import DemoConfiguredExample from '@master/internal-site/demo/DemoConfiguredExample.astro'
import { agentStyleExample } from '../utils/agent-style-example'

interface Props {
  code?: boolean
}

const { code = true } = Astro.props
const copy = demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, 'AgentStyleExample', agentStyleExample)

---

<DemoConfiguredExample name="agent-project-vocabulary" {...copy} code={code} />
