---
import '~/site/styles/system/specimens.css'
import IconDownload from '@tabler/icons-svelte-runes/icons/download'
import Demo from './Demo.svelte'
import DemoMedia from './DemoMedia.svelte'

export interface DemoAssetProps {
  title: string
  description: string
  src: string
  alt: string
  width: number
  height: number
  format?: string
  surface?: 'light' | 'dark' | 'transparent'
}
type Props = DemoAssetProps

/** A downloadable specimen, not a CSS test subject. Intrinsic dimensions reserve
 * the image ratio; only the preview is constrained. The file stays unchanged.
 * Light and dark artwork turns the stage itself to that mode, so the artwork has no frame of its own inside it;
 * transparent artwork sits on a checkerboard. A demo container keeps the prose media perimeter off the artwork.
 */
const { title, description, src, alt, width, height, format = 'SVG', surface = 'transparent' } = Astro.props
---

<Demo title={title} description={description} background={surface === 'transparent' ? 'checkerboard' : 'plain'} class={surface === 'transparent' ? undefined : surface} data-asset={surface}>
  <Fragment slot="caption">
    <span class="flex flex-wrap items-center justify-between gap-sm">
      <span class="ui-badge" data-size="sm">{format}</span>
      <a href={src} download class="ui-button" data-size="sm" aria-label={`Download ${title} (${format})`}>
        <IconDownload aria-hidden="true" />
        Download {format}
      </a>
    </span>
  </Fragment>
  <div class="grid (place-items:center) w-full" data-demo-container=""><DemoMedia src={src} alt={alt} width={width} height={height} class="block h-auto w-auto max-w-full (max-height:6rem)" /></div>
</Demo>
