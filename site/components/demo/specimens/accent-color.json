  {
    "page": "accent-color",
    "id": "set-the-accent-color",
    "title": "Set the accent color",
    "html": [
      "<!-- Platform accent -->\n<form>\n  <fieldset id=\"target\"\n    class=\"grid gap-md min-w(0) m(0) p(0) b(0)\n           (accent-color:auto)\">\n    <legend class=\"sr-only\">Platform accent</legend>\n    <label class=\"flex items-center gap-sm\">\n      <input type=\"checkbox\" checked> Snap to grid\n    </label>\n    <div class=\"flex flex-wrap gap-md\">\n      <label class=\"flex items-center gap-sm\">\n        <input type=\"radio\" name=\"view\" value=\"canvas\" checked> Canvas\n      </label>\n      <label class=\"flex items-center gap-sm\">\n        <input type=\"radio\" name=\"view\" value=\"layers\"> Layers\n      </label>\n    </div>\n    <label class=\"grid gap-xs w(240) max-w-full\">\n      Zoom\n      <input type=\"range\" min=\"25\" max=\"100\" value=\"65\"\n        class=\"w-full\">\n    </label>\n  </fieldset>\n</form>",
      "<!-- Blue accent -->\n<form>\n  <fieldset id=\"target\"\n    class=\"grid gap-md min-w(0) m(0) p(0) b(0)\n           accent-blue\">\n    <legend class=\"sr-only\">Blue accent</legend>\n    <label class=\"flex items-center gap-sm\">\n      <input type=\"checkbox\" checked> Snap to grid\n    </label>\n    <div class=\"flex flex-wrap gap-md\">\n      <label class=\"flex items-center gap-sm\">\n        <input type=\"radio\" name=\"view\" value=\"canvas\" checked> Canvas\n      </label>\n      <label class=\"flex items-center gap-sm\">\n        <input type=\"radio\" name=\"view\" value=\"layers\"> Layers\n      </label>\n    </div>\n    <label class=\"grid gap-xs w(240) max-w-full\">\n      Zoom\n      <input type=\"range\" min=\"25\" max=\"100\" value=\"65\"\n        class=\"w-full\">\n    </label>\n  </fieldset>\n</form>"
    ],
