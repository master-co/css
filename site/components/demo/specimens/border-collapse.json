    "id": "match-border-spacing-to-the-mode",
    "title": "Match border spacing to the mode",
    "html": [
      "<!-- Collapse · spacing ignored -->\n<table id=\"target\"\n  class=\"w(240) max-w-full (border-collapse:collapse)\n         border-spacing-xs font-sm text-left\n         fg-text-body (table-layout:fixed)\">\n  <caption class=\"pb-sm font-semibold text-left\">\n    Project assets\n  </caption>\n  <tbody>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs b(2) b-solid b-blue font-medium\">\n        Design\n      </th>\n      <td class=\"p-xs b(2) b-solid b-blue\">12 files</td>\n    </tr>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs b(2) b-solid b-blue font-medium\">\n        Research\n      </th>\n      <td class=\"p-xs b(2) b-solid b-blue\">8 files</td>\n    </tr>\n  </tbody>\n</table>",
      "<!-- Separate · 8px spacing -->\n<table id=\"target\"\n  class=\"w(240) max-w-full (border-collapse:separate)\n         border-spacing-xs font-sm text-left\n         fg-text-body (table-layout:fixed)\">\n  <caption class=\"pb-sm font-semibold text-left\">\n    Project assets\n  </caption>\n  <tbody>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs b(2) b-solid b-blue font-medium\">\n        Design\n      </th>\n      <td class=\"p-xs b(2) b-solid b-blue\">12 files</td>\n    </tr>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs b(2) b-solid b-blue font-medium\">\n        Research\n      </th>\n      <td class=\"p-xs b(2) b-solid b-blue\">8 files</td>\n    </tr>\n  </tbody>\n</table>"
