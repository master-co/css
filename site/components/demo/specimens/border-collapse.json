    "id": "match-border-spacing-to-the-mode",
    "title": "Match border spacing to the mode",
    "html": [
      "<!-- Collapse · spacing ignored -->\n<table id=\"target\"\n  class=\"width:240px max-width:100% border-collapse:collapse\n         border-spacing-xs font-sm text-align:left\n         fg-text-body table-layout:fixed\">\n  <caption class=\"pb-sm font-semibold text-align:left\">\n    Project assets\n  </caption>\n  <tbody>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs border-width:2px border-style:solid b-blue font-medium\">\n        Design\n      </th>\n      <td class=\"p-xs border-width:2px border-style:solid b-blue\">12 files</td>\n    </tr>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs border-width:2px border-style:solid b-blue font-medium\">\n        Research\n      </th>\n      <td class=\"p-xs border-width:2px border-style:solid b-blue\">8 files</td>\n    </tr>\n  </tbody>\n</table>",
      "<!-- Separate · 8px spacing -->\n<table id=\"target\"\n  class=\"width:240px max-width:100% border-collapse:separate\n         border-spacing-xs font-sm text-align:left\n         fg-text-body table-layout:fixed\">\n  <caption class=\"pb-sm font-semibold text-align:left\">\n    Project assets\n  </caption>\n  <tbody>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs border-width:2px border-style:solid b-blue font-medium\">\n        Design\n      </th>\n      <td class=\"p-xs border-width:2px border-style:solid b-blue\">12 files</td>\n    </tr>\n    <tr>\n      <th scope=\"row\"\n        class=\"p-xs border-width:2px border-style:solid b-blue font-medium\">\n        Research\n      </th>\n      <td class=\"p-xs border-width:2px border-style:solid b-blue\">8 files</td>\n    </tr>\n  </tbody>\n</table>"
    ],
