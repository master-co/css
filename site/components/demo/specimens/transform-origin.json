    "page": "transform-origin",
    "id": "set-the-pivot-point",
    "title": "Set the pivot point",
    "html": [
      "<!-- Center · four edges move inward -->\n<div class=\"p-lg\">\n  <div class=\"relative h(96) w(160) outline(1) outline-dashed outline-line-subtle\">\n    <div id=\"target\"\n      class=\"grid items-start (justify-items:center) h(96) w(160) p-sm\n             b(1) b-solid b-blue-60 r-sm font-sm bg-blue-10\n             fg-blue-80 (transform:scale(.75))\n             (transform-origin:center)\">\n      Center pivot\n    </div>\n    <span aria-hidden=\"true\"\n      class=\"absolute left(77) top(45) w(6) h(6) (border-radius:100%)\n             bg-violet-60 pointer-none\"></span>\n  </div>\n</div>",
      "<!-- Top left · two edges stay fixed -->\n<div class=\"p-lg\">\n  <div class=\"relative h(96) w(160) outline(1) outline-dashed outline-line-subtle\">\n    <div id=\"target\"\n      class=\"grid items-start (justify-items:center) h(96) w(160) p-sm\n             b(1) b-solid b-blue-60 r-sm font-sm bg-blue-10\n             fg-blue-80 (transform:scale(.75))\n             (transform-origin:top|left)\">\n      Corner pivot\n    </div>\n    <span aria-hidden=\"true\"\n      class=\"absolute left(-3) top(-3) w(6) h(6) (border-radius:100%)\n             bg-violet-60 pointer-none\"></span>\n  </div>\n</div>"
    ],
