    "id": "disable-browser-gestures-on-a-custom-surface",
    "title": "Disable browser gestures on a custom surface",
    "html": [
      "<!-- None · native touch panning blocked -->\n<div id=\"target\" role=\"region\" aria-label=\"Gesture test\" tabindex=\"0\"\n\nclass=\"overflow-auto h(160) w(240) max-w-full\n       b(1) b-solid b-line-divider r-sm (touch-action:none)\">\n  <div\n\n  class=\"flex flex-col justify-between h(360)\n         w(480) p-md bg-surface-raised\">\n    <p class=\"m(0)\">Start · swipe vertically or horizontally</p>\n    <p class=\"self-end m(0) fg-text-blue\">End · 480 × 360px content</p>\n  </div>\n</div>",
      "<!-- Auto · native touch panning allowed -->\n<div id=\"target\" role=\"region\" aria-label=\"Gesture test\" tabindex=\"0\"\n\nclass=\"overflow-auto h(160) w(240) max-w-full\n       b(1) b-solid b-line-divider r-sm (touch-action:auto)\">\n  <div\n\n  class=\"flex flex-col justify-between h(360)\n         w(480) p-md bg-surface-raised\">\n    <p class=\"m(0)\">Start · swipe vertically or horizontally</p>\n    <p class=\"self-end m(0) fg-text-blue\">End · 480 × 360px content</p>\n  </div>\n</div>"
