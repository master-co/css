    "title": "Let clicks pass through an overlay",
    "html": [
      "<!-- None · reaches the checkbox -->\n<div class=\"relative px-lg pb-lg pt-xl b(1) b-solid b-line-divider r-sm\">\n  <label class=\"flex items-center gap-sm\">\n    <input type=\"checkbox\"> Snap to grid\n  </label>\n  <div id=\"target\" aria-hidden=\"true\"\n    class=\"absolute inset(0) b(1) b-dashed b-violet r-sm\n           pointer-none\">\n    <span class=\"absolute right-xs top-xs font-xs fg-text-violet\">Overlay</span>\n  </div>\n</div>",
      "<!-- Auto · overlay intercepts the pointer -->\n<div class=\"relative px-lg pb-lg pt-xl b(1) b-solid b-line-divider r-sm\">\n  <label class=\"flex items-center gap-sm\">\n    <input type=\"checkbox\"> Snap to grid\n  </label>\n  <div id=\"target\" aria-hidden=\"true\"\n    class=\"absolute inset(0) b(1) b-dashed b-violet r-sm\n           pointer-auto\">\n    <span class=\"absolute right-xs top-xs font-xs fg-text-violet\">Overlay</span>\n  </div>\n</div>"
