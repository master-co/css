    "id": "flatten-nested-transforms",
    "title": "Flatten nested transforms",
    "html": [
      "<!-- Explicit flat · default flattening -->\n<div class=\"display:grid place-items:center height:200px width:240px\n         max-width:100% perspective:400px\">\n  <div id=\"target\"\n    class=\"position:relative height:104px width:144px border-width:2px border-style:solid b-violet-60\n           font-sm bg-violet-10 fg-violet-80\n           transform:rotateY(32deg)\n           transform-style:flat\">\n    <span class=\"display:block p-xs\">Parent · 0</span>\n    <div id=\"front\"\n      class=\"position:absolute left-md top-xl display:grid place-items:center\n             height:80px width:120px border-width:2px border-style:solid b-blue-60\n             bg-blue-20 fg-blue-80\n             transform:translateZ(48px)\">\n      Front · +48px\n    </div>\n  </div>\n</div>",
      "<!-- Opacity .8 · preserve-3d is flattened -->\n<div class=\"display:grid place-items:center height:200px width:240px\n         max-width:100% perspective:400px\">\n  <div id=\"target\"\n    class=\"position:relative height:104px width:144px border-width:2px border-style:solid b-violet-60\n           font-sm bg-violet-10 fg-violet-80 opacity:.8\n           transform:rotateY(32deg)\n           transform-style:preserve-3d\">\n    <span class=\"display:block p-xs\">Parent · 0</span>\n    <div id=\"front\"\n      class=\"position:absolute left-md top-xl display:grid place-items:center\n             height:80px width:120px border-width:2px border-style:solid b-blue-60\n             bg-blue-20 fg-blue-80\n             transform:translateZ(48px)\">\n      Front · +48px\n    </div>\n  </div>\n</div>"
    ],
