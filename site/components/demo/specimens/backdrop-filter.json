    "title": "Blur content behind an element",
    "html": [
      "<!-- No filter · sharp backdrop -->\n<div class=\"relative h(168) w(240) max-w-full\">\n  <img src=\"/demo/landscape.svg\"\n  width=\"320\" height=\"200\"\n  alt=\"\"\n  class=\"block h(168) w(240) max-w-full\n         object-cover\" />\n  <div id=\"target\"\n    class=\"absolute inset-md flex items-center\n           justify-center p-sm b(1) b-solid b-line-divider r-sm\n           font-md bg-surface-base/.64 fg-text-strong\n           (backdrop-filter:none)\">\n    Preview layer\n  </div>\n</div>",
      "<!-- Blur · softened backdrop -->\n<div class=\"relative h(168) w(240) max-w-full\">\n  <img src=\"/demo/landscape.svg\"\n  width=\"320\" height=\"200\"\n  alt=\"\"\n  class=\"block h(168) w(240) max-w-full\n         object-cover\" />\n  <div id=\"target\"\n    class=\"absolute inset-md flex items-center\n           justify-center p-sm b(1) b-solid b-line-divider r-sm\n           font-md bg-surface-base/.64 fg-text-strong\n           (backdrop-filter:blur(8px))\">\n    Preview layer\n  </div>\n</div>"
