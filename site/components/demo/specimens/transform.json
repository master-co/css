    "html": [
      "<!-- Translate upward · hover or focus -->\n<div class=\"p-lg\">\n  <div class=\"relative h(96) w(160) outline(1) outline-dashed outline-line-subtle\">\n    <button id=\"target\" type=\"button\"\n      class=\"grid (place-items:center) h(96) w(160) p-sm\n             b(1) b-solid b-blue-60 r-sm font-sm bg-blue-10\n             fg-blue-80 (transform:none)\n             outline(2):focus-visible outline-solid:focus-visible outline-blue:focus-visible\n             outline-offset(3):focus-visible\n             (transform:none)@media(print)\n             (transition-property:transform)@motion-safe (transition-duration:var(--duration-fast))@motion-safe (transition-timing-function:ease-out)@motion-safe\n             (transform:translateY(-8px)):hover@media(screen)\n             (transform:translateY(-8px)):focus-visible@media(screen)\">\n      Lift layer\n    </button>\n  </div>\n</div>"
