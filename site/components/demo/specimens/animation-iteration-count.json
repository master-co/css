    "id": "specify-n-iterations",
    "title": "Specify a number of iterations",
    "html": [
      "<!-- Three cycles · ends at 96px -->\n<div class=\"w(240) max-w-full\">\n  <p class=\"mb-sm font-mono font-xs fg-text-muted\">Base 0 · start 24 · end 96px</p>\n  <div aria-hidden=\"true\"\n    class=\"h(56) p-xs outline(1) outline-dashed outline-line-subtle\">\n    <span id=\"target\"\n      class=\"grid (place-items:center) h(40) w(48)\n             b(1) b-solid b-blue-60 r-sm bg-blue-10\n             fg-blue-80 (transform:none)\n             (animation-duration:1s)\n             (animation-fill-mode:forwards)\n             (animation-iteration-count:3)\n             (animation-name:layer-slide)\n             (animation-timing-function:linear)\n             (animation:none)@media(print)\n             (animation-play-state:paused)@motion-reduce\">→</span>\n  </div>\n</div>",
      "<!-- 2.5 cycles · ends at 60px -->\n<div class=\"w(240) max-w-full\">\n  <p class=\"mb-sm font-mono font-xs fg-text-muted\">Base 0 · start 24 · end 96px</p>\n  <div aria-hidden=\"true\"\n    class=\"h(56) p-xs outline(1) outline-dashed outline-line-subtle\">\n    <span id=\"target\"\n      class=\"grid (place-items:center) h(40) w(48)\n             b(1) b-solid b-blue-60 r-sm bg-blue-10\n             fg-blue-80 (transform:none)\n             (animation-duration:1s)\n             (animation-fill-mode:forwards)\n             (animation-iteration-count:2.5)\n             (animation-name:layer-slide)\n             (animation-timing-function:linear)\n             (animation:none)@media(print)\n             (animation-play-state:paused)@motion-reduce\">→</span>\n  </div>\n</div>"
    ],
    "css": "@theme {\n\n}\n@keyframes layer-slide {\n    from { transform: translateX(24px); }\n    to { transform: translateX(96px); }\n  }\n\n",
