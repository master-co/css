      "<!-- Unclipped · original border -->\n<div\n  class=\"h(120) w(240) max-w-full\n         outline(1) outline-solid outline-line-subtle bg-surface-base\">\n  <div id=\"target\"\n    class=\"grid (place-items:center) h(120) w(240)\n           max-w-full b(2) b-solid b-blue-60 font-md\n           bg-blue-10 fg-blue-80 (clip-path:none)\">\n    Clipped panel\n  </div>\n</div>",
      "<!-- Inset · rounded paint boundary -->\n<div\n  class=\"h(120) w(240) max-w-full\n         outline(1) outline-solid outline-line-subtle bg-surface-base\">\n  <div id=\"target\"\n    class=\"grid (place-items:center) h(120) w(240)\n           max-w-full b(2) b-solid b-blue-60 font-md\n           bg-blue-10 fg-blue-80\n           (clip-path:inset(8px|24px|round|12px))\">\n    Clipped panel\n  </div>\n</div>"
