    "page": "transition-duration",
    "id": "match-duration-to-distance",
    "title": "Match duration to distance",
    "html": [
      "<!-- 48px / 300ms · 160px per second -->\n<label class=\"block w(280) max-w-full font-sm\n         (transform:translateX(48px)):has(input:checked)>span>span@media(screen)\">\n  <input type=\"checkbox\" aria-label=\"Move short distance\"\n    class=\"mr-xs accent-blue\n           outline(2):focus-visible outline-solid:focus-visible outline-blue:focus-visible\n           outline-offset(3):focus-visible\">\n  Move short distance\n  <span aria-hidden=\"true\"\n    class=\"block h(64) mt-md p-xs\n           outline(1) outline-dashed outline-line-subtle\">\n    <span id=\"target\"\n      class=\"grid (place-items:center) h(48) w(128)\n             b(1) b-solid b-blue-60 r-sm font-sm bg-blue-10\n             fg-blue-80 (opacity:1) (transform:none)\n             (transition-property:transform)\n             (transition-timing-function:linear)\n             (transition-duration:0ms)@media(print)\n             transition-slow@media(screen)@motion-safe\">\n      Layer 01\n    </span>\n  </span>\n</label>",
      "<!-- 96px / 600ms · 160px per second -->\n<label class=\"block w(280) max-w-full font-sm\n         (transform:translateX(96px)):has(input:checked)>span>span@media(screen)\">\n  <input type=\"checkbox\" aria-label=\"Move long distance\"\n    class=\"mr-xs accent-blue\n           outline(2):focus-visible outline-solid:focus-visible outline-blue:focus-visible\n           outline-offset(3):focus-visible\">\n  Move long distance\n  <span aria-hidden=\"true\"\n    class=\"block h(64) mt-md p-xs\n           outline(1) outline-dashed outline-line-subtle\">\n    <span id=\"target\"\n      class=\"grid (place-items:center) h(48) w(128)\n             b(1) b-solid b-blue-60 r-sm font-sm bg-blue-10\n             fg-blue-80 (opacity:1) (transform:none)\n             (transition-property:transform)\n             (transition-timing-function:linear)\n             (transition-duration:0ms)@media(print)\n             (transition-duration:600ms)@media(screen)@motion-safe\">\n      Layer 01\n    </span>\n  </span>\n</label>"
    ],
