    "page": "transition-timing-function",
    "id": "choose-an-easing-curve",
    "title": "Choose an easing curve",
    "html": [
      "<!-- Linear · constant progress -->\n<label class=\"display:block width:280px max-width:100% font-size-sm\n         transform:translateX(96px):has(input:checked)>span>span@media(screen)\">\n  <input type=\"checkbox\" aria-label=\"Move layer\"\n    class=\"mr-xs accent-color-blue\n           outline-width:2px:focus-visible outline-style:solid:focus-visible outline-blue:focus-visible\n           outline-offset:3px:focus-visible\">\n  Move layer\n  <span aria-hidden=\"true\"\n    class=\"display:block height:64px mt-md p-xs\n           outline-width:1px outline-style:dashed outline-line-subtle\">\n    <span id=\"target\"\n      class=\"display:grid place-items:center height:48px width:128px\n             border-width:1px border-style:solid b-blue-60 r-sm font-size-sm bg-blue-10\n             fg-blue-80 opacity:1 transform:none\n             transition-property:transform\n             transition-timing-function:linear\n             transition:none@media(print)\n             transition-duration-slowest@media(screen)@motion-safe\">\n      Layer 01\n    </span>\n  </span>\n</label>",
      "<!-- Ease in · slower at the beginning -->\n<label class=\"display:block width:280px max-width:100% font-size-sm\n         transform:translateX(96px):has(input:checked)>span>span@media(screen)\">\n  <input type=\"checkbox\" aria-label=\"Move layer\"\n    class=\"mr-xs accent-color-blue\n           outline-width:2px:focus-visible outline-style:solid:focus-visible outline-blue:focus-visible\n           outline-offset:3px:focus-visible\">\n  Move layer\n  <span aria-hidden=\"true\"\n    class=\"display:block height:64px mt-md p-xs\n           outline-width:1px outline-style:dashed outline-line-subtle\">\n    <span id=\"target\"\n      class=\"display:grid place-items:center height:48px width:128px\n             border-width:1px border-style:solid b-blue-60 r-sm font-size-sm bg-blue-10\n             fg-blue-80 opacity:1 transform:none\n             transition-property:transform\n             transition-timing-function:ease-in\n             transition:none@media(print)\n             transition-duration-slowest@media(screen)@motion-safe\">\n      Layer 01\n    </span>\n  </span>\n</label>",
      "<!-- Ease out · slower at the end -->\n<label class=\"display:block width:280px max-width:100% font-size-sm\n         transform:translateX(96px):has(input:checked)>span>span@media(screen)\">\n  <input type=\"checkbox\" aria-label=\"Move layer\"\n    class=\"mr-xs accent-color-blue\n           outline-width:2px:focus-visible outline-style:solid:focus-visible outline-blue:focus-visible\n           outline-offset:3px:focus-visible\">\n  Move layer\n  <span aria-hidden=\"true\"\n    class=\"display:block height:64px mt-md p-xs\n           outline-width:1px outline-style:dashed outline-line-subtle\">\n    <span id=\"target\"\n      class=\"display:grid place-items:center height:48px width:128px\n             border-width:1px border-style:solid b-blue-60 r-sm font-size-sm bg-blue-10\n             fg-blue-80 opacity:1 transform:none\n             transition-property:transform\n             transition-timing-function:ease-out\n             transition:none@media(print)\n             transition-duration-slowest@media(screen)@motion-safe\">\n      Layer 01\n    </span>\n  </span>\n</label>"
    ],
