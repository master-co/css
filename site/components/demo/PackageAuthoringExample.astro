---
import Code from '@master/internal-site/components/Code.astro'
import Demo from '@master/internal-site/demo/Demo.svelte'
import DemoGeneratedCSS from '@master/internal-site/demo/DemoGeneratedCSS.svelte'
import DemoViewport from '@master/internal-site/demo/DemoViewport.svelte'
import { demoDocument } from '@master/internal-site/demo/reference/document.ts'
import { authoringSource, authoringHTML, authoringCSS, authoringExampleCopy } from '../../utils/authoring-examples'
import { demoCopy } from '@master/internal-site/utils/document-copy.js'
import { documentCopyOf, siteOf } from '@master/internal-site/astro/site-context'

interface Props {
  part?: 'source' | 'preview'
  code?: boolean
}

const { part = 'preview', code = true } = Astro.props
const { title, caption } = part === 'source' ? authoringExampleCopy : demoCopy(documentCopyOf(Astro), siteOf(Astro).locale, 'PackageAuthoringExample', authoringExampleCopy)
const section = { page: 'project-styles', id: 'authoring-package', title, html: [authoringHTML], css: authoringSource, classes: [], classLists: [], highlighted: [] }
---

{part === 'source'
  ? <Code lang="css" name="master.css" code={authoringSource} />
  : <Demo title={title} caption={caption} frame="none" data-project-style="authoring-package">
    {code && <Fragment slot="source">
      <Code lang="html" code={authoringHTML} />
      <DemoGeneratedCSS><Code lang="css" beautify code={authoringCSS()} /></DemoGeneratedCSS>
    </Fragment>}
    <DemoViewport client:idle={{ timeout: 500 }} title={title} document={demoDocument(section, { html: authoringHTML, caption, bodyClass: 'p-md p(8)@media(width<240px)' })} sizing="content" />
  </Demo>}
