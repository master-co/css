---
import '~/site/styles/demo.css'
import RenderNode from '~/site/docs-shell/components/RenderNode.astro'
import DemoIndex from './DemoIndex.astro'

export interface DemoCatalogGroup {
  id: string
  title: string
  /** `children` is markup: an Astro template value or MDX JSX, rendered with RenderNode. */
  entries: readonly { id: string, title: string, label: string, href?: string, children: unknown }[]
}

interface Props {
  groups: readonly DemoCatalogGroup[]
}

/** The complete specimens stay server-rendered inside native disclosures. */
const { groups } = Astro.props
---

<div class="ui-catalog">
  <DemoIndex label="Utility recipe categories" groups={[{
    title: 'Choose a behavior',
    links: groups.map(group => ({ href: `#${group.id}`, label: `${group.title} · ${group.entries.length}` }))
  }]} />
  {groups.map(group => <section aria-labelledby={group.id}>
    <h3 id={group.id}>{group.title}<small>{group.entries.length} recipes</small></h3>
    {group.entries.map(entry => <details class="ui-disclosure" data-variant="rule">
      <summary>{entry.title}<span class="ui-disclosure-meta">{entry.label}</span></summary>
      <div class="ui-catalog-entry">
        {entry.href && <a href={entry.href}>Read related documentation ↗</a>}
        <RenderNode node={entry.children} />
      </div>
    </details>)}
  </section>)}
</div>
