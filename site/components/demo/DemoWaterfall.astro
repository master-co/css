---
import '~/site/styles/system/data.css'
import Demo from './Demo.svelte'
import type { DemoWaterfallProps } from './demo-waterfall'

type Props = DemoWaterfallProps

/** A conceptual discovery diagram. Keep measured performance in benchmark charts. */
const { title, description, rows, marker, caption = 'Illustrative order · no time scale' } = Astro.props
if (marker && (!Number.isFinite(marker.position) || marker.position < 0 || marker.position > 100)) throw new Error('Invalid waterfall marker')
for (const { label, start, end } of rows) {
  if (!Number.isFinite(start) || !Number.isFinite(end) || start < 0 || end > 100 || end <= start) throw new Error(`Invalid waterfall interval: ${label}`)
}
---

<Demo title={title} description={description} caption={caption} padding="sm" aria-label={title}>
  <div class="w-full ui-waterfall">
    <div class="ui-waterfall-axis" aria-hidden="true"><span /><div class="relative"><span>Earlier</span>{marker && <span class="absolute font-medium fg-text-strong (translate:-50%)" style={{ left: `${marker.position}%` }}>{marker.label}</span>}<span>Later</span></div></div>
    {/* Preserve WebKit list semantics without list markers. */}
    <ul role="list" class="grid gap-2xs m(0) p(0) (list-style:none)">
      {rows.map(({ label, start, end, tone = 'blue' }) => <li class="ui-waterfall-row">
        <span>{label}</span>
        <span class="ui-waterfall-track" aria-hidden="true">
          <i data-tone={tone === 'neutral' ? 'muted' : undefined} style={{ left: `${start}%`, width: `${end - start}%`, ...(tone === 'neutral' ? {} : { background: `var(--ui-tone-${tone})` }) }} />
          {marker && <span class="ui-waterfall-mark" style={{ left: `${marker.position}%` }} />}
        </span>
      </li>)}
    </ul>
  </div>
</Demo>
