---
import Demo from '../Demo.svelte'
import DemoItem from '../DemoItem.svelte'
import DemoLabel from '../DemoLabel.svelte'
---

<Demo title="Choose one axis or both" data-foundation="axes">
  <div class="flex items-end gap-md w-full">
    <div class="shrink(0) (width:3.5rem)"><DemoLabel>(width:3.5rem) (height:3.5rem)</DemoLabel><DemoItem class="grid (place-content:center) (height:3.5rem) (width:3.5rem) mt-sm font-mono">FN</DemoItem></div>
    <div class="(flex:1) min-w(0)"><DemoLabel>w-full (height:3.5rem)</DemoLabel><DemoItem tone="violet" class="grid (place-content:center) (height:3.5rem) w-full mt-sm text-sm">Fluid</DemoItem></div>
  </div>
</Demo>
