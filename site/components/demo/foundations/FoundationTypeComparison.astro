---
import FoundationSpecimen from './FoundationSpecimen.astro'
import { typeSpecimens } from '../reference/type-specimens'
import type { ReferenceDemoSection } from '../reference/types'

const authored: ReferenceDemoSection = { page: 'text-size', id: 'type-comparison', title: 'Font size and text scale', css: '', classes: [], classLists: [], highlighted: [], html: [
  "<!-- font-3xl · inherited leading and tracking -->\n<div class=\"leading-md tracking-normal wrap-anywhere\"><p id=\"target\" class=\"m(0) font-3xl font-regular\">Designing for a clearer reading experience.</p></div>",
  "<!-- text-3xl · size, leading and tracking -->\n<div class=\"leading-md tracking-normal wrap-anywhere\"><p id=\"target\" class=\"m(0) text-3xl font-regular\">Designing for a clearer reading experience.</p></div>",
] }
---

<FoundationSpecimen name="type-comparison" title="One size, two type treatments" scene={typeSpecimens(authored, { properties: ['font-size', 'line-height', 'letter-spacing'], appearance: 'plain', caption: 'Both specimens have the same font size and content. font-3xl inherits the parent’s leading and tracking; text-3xl sets all three properties.' })} />
