---
import DemoContainer from '../DemoContainer.svelte'
import DemoLabel from '../DemoLabel.svelte'
import DemoMedia from '../DemoMedia.svelte'

/** The query boundary is an ancestor; it never queries its own width. */
---

<DemoContainer client:idle={{ timeout: 500 }} title="A component follows its container" data-foundation="media" caption="Below 28rem of container width, the media stacks. At 28rem it keeps a 9rem width beside flexible text.">
    <div class="container-inline">
      <article class="flex flex-col items-start gap-md p-md flex-row@container(width>=28rem) ui-sheet" data-elevation="1">
        <DemoMedia tone="blue" class="h-auto w-full (aspect-ratio:4/3) r-sm shrink(0)@container(width>=28rem) (width:9rem)@container(width>=28rem)" aria-label="Blue mountain illustration" />
        <div class="(flex:1) min-w(0)">
          <DemoLabel>Collection / 024</DemoLabel>
          <h3 class="mb(0) mx(0) mt-xs text-md font-semibold">Field notes</h3>
          <p class="mb(0) mx(0) mt-xs text-sm fg-text-muted">A small archive of places, textures and quiet details from the trail.</p>
          <div class="flex flex-wrap gap-sm mt-md"><DemoLabel>12 images</DemoLabel><DemoLabel>Updated today</DemoLabel></div>
        </div>
      </article>
    </div>
</DemoContainer>
