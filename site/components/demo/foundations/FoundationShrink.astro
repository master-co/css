---
import DemoContainer from '../DemoContainer.svelte'
import DemoItem from '../DemoItem.svelte'
---

<DemoContainer client:idle={{ timeout: 500 }} title="Keep long content within its cap" data-foundation="shrink" caption="The row stops at sm. The flexible text region can shrink below its content width.">
    <article class="flex gap-md w-full max-w-sm mx-auto p-md ui-sheet" data-elevation="1">
      <DemoItem class="grid shrink(0) (place-content:center) (height:2.5rem) (width:2.5rem) text-sm font-mono">FN</DemoItem>
      <div class="(flex:1) min-w(0)">
        <div class="text-sm font-semibold">Project archive</div>
        <p class="truncate mb(0) mx(0) mt-2xs text-sm fg-text-muted">field-notes-autumn-collection-final-v03.fig</p>
      </div>
    </article>
</DemoContainer>
