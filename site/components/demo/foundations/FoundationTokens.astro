---
import Code from '../../../docs-shell/components/Code.astro'
import { configuredExampleCSS, configuredMarkupClasses } from '../../../reference/configured-example'
import { foundationScene } from '../../../common/foundation-data/specimens'
import DocumentDisclosure from '../../DocumentDisclosure.astro'
import FoundationTokensView from './FoundationTokensView.astro'

interface Props {
  namespace: string
  keys?: string[]
}

const { namespace, keys } = Astro.props
const scene = keys && namespace !== 'color' && namespace !== 'breakpoints' ? foundationScene(namespace, keys) : undefined
---

<FoundationTokensView namespace={namespace} keys={keys} presentation="guide">
  {scene?.html && <DocumentDisclosure slot="source" title="Example code">
    <Code lang="html" beautify code={scene.html} />
    <Code lang="css" beautify code={configuredExampleCSS(scene.css ?? '', configuredMarkupClasses(scene.html))} />
  </DocumentDisclosure>}
</FoundationTokensView>
