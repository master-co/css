---
import Demo from '../Demo.svelte'
import DemoItem from '../DemoItem.svelte'
import DemoLabel from '../DemoLabel.svelte'
import DemoSurface from '../DemoSurface.svelte'
---

<Demo title="Fluid space, measured object" data-foundation="sizing">
  <DemoSurface class="w-full max-w-sm mx-auto p-md">
    <DemoLabel>w-full · max-w-sm</DemoLabel>
    <div class="flex items-center gap-md mt-md">
      <DemoItem class="grid shrink(0) (place-content:center) (height:3rem) (width:3rem) (aspect-ratio:1/1) (border-radius:50%) text-sm font-mono">FN</DemoItem>
      <div class="wrap-anywhere (flex:1) min-w(0)">
        <div class="text-sm font-semibold">Field notes</div>
        <p class="mb(0) mx(0) mt-2xs text-sm fg-text-muted">Measured avatar. Flexible content.</p>
      </div>
    </div>
  </DemoSurface>
</Demo>
