---
import '~/site/styles/integration-cover.css'
import Image from '@master/internal-site/components/Image.svelte'
import type { StaticImage } from '@master/internal-site/types/StaticImage'

interface Props {
  images: { light: StaticImage, dark: StaticImage }
  alt: string
}

/** A single accessible cover with matched light/dark artwork and intrinsic sizing. */
const { images, alt } = Astro.props
---

<div class="integration-cover" role="img" aria-label={alt}>
  {(['light', 'dark'] as const).map(scheme => <Image
    src={images[scheme]}
    data-scheme={scheme}
    sizes="(max-width: 834px) 100vw, 720px"
    alt=""
    aria-hidden="true"
    priority
  />)}
</div>
