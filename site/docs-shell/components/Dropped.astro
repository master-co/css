---
interface Props {
  p1?: string
  p2?: string
  target?: string
}

let { p1, p2, target } = Astro.props
if (p1 && p2) {
  p1 = p1.trim()
  p2 = p2.trim()
  if (target === 'class') {
    p1 = p1.replace(/.*class="(.*)".*/gm, '$1')
    p2 = p2.replace(/.*class="(.*)".*/gm, '$1')
  }
}
---

{p1 && p2 && <small class="(font-weight:var(--ui-weight-medium)) text-success">↓ {
  Math.round(Math.abs((p1.length - p2.length) / p1.length) * 100)
}% code</small>}
