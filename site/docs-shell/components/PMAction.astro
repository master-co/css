---
import { resolveCommand } from 'package-manager-detector/commands'
import CodeTabs from './CodeTabs.astro'
import { slotText } from '../utils/slot-text'

interface Props {
  action?: string
  /** The package or arguments; text children work too. */
  code?: string
}

/** One command for every package manager, as `ui-code` tabs that share the reader's choice. */
const { action = 'install', code: source } = Astro.props
const code = source ?? await slotText(Astro.slots) ?? ''
const tabs = ['npm', 'pnpm', 'bun', 'yarn'].map((pm) => {
  const resolvedCommand = resolveCommand(pm as any, action as any, [code])
  return {
    name: pm,
    lang: 'bash',
    code: resolvedCommand ? resolvedCommand.command + ' ' + resolvedCommand.args.join(' ') : `${pm} ${action} ${code}`
  }
})
---

<CodeTabs localStorageKey="pm" tabs={tabs} />
