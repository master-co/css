---
import type { PageContentItem } from './page-content.svelte'
import { pageContentBootstrapScript } from './page-content-bootstrap'

interface Props {
  items: PageContentItem[]
}

/** Marks the doc-page active state while the document parses, before islands hydrate. */
const script = pageContentBootstrapScript(Astro.props.items)
---

<script is:inline data-page-content-bootstrap id="page-content-bootstrap" set:html={script} />
