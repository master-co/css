---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'nav'>

/** Links between sibling pages as underlined `ui-segmented` tabs; the page being read is underlined in ink (`aria-current="page"`). Each tab is a `Tab.astro`. */
const { class: className, ...props } = Astro.props
---

<nav {...props} class:list={['ui-segmented', className]} data-variant="underline"><slot /></nav>
