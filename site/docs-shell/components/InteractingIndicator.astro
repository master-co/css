---
import IconForms from '@tabler/icons-svelte-runes/icons/forms'
import IconHandClick from '@tabler/icons-svelte-runes/icons/hand-click'
import IconHandMove from '@tabler/icons-svelte-runes/icons/hand-move'
import IconResize from '@tabler/icons-svelte-runes/icons/resize'
import IconTestPipe from '@tabler/icons-svelte-runes/icons/test-pipe'
import IconWand from '@tabler/icons-svelte-runes/icons/wand'

const icons = { wand: IconWand, hover: IconHandMove, click: IconHandClick, type: IconForms, observe: IconTestPipe, resize: IconResize, test: IconTestPipe }

interface Props {
  icon: keyof typeof icons
}

/** How to use the example that follows: a muted line led by its gesture. */
const Icon = icons[Astro.props.icon]
---

<p class="ui-hint"><Icon aria-hidden="true" /><slot /></p>
