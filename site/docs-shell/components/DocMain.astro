---
import '~/site/styles/docs-shell/docs.css'
import type { HTMLAttributes } from 'astro/types'
import Footer, { type FooterProps } from './Footer.svelte'

interface Props extends HTMLAttributes<'main'> {
  footerProps?: FooterProps
}

/** The main column: the article and its contents rail, then the footer. */
const { footerProps, class: className, ...props } = Astro.props
---

<main {...props} class:list={['ui-docs-main', className]}>
  <div class="ui-docs-body">
    <slot />
  </div>
  {footerProps && <Footer client:load {...footerProps} />}
</main>
