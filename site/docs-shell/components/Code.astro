---
import type { HTMLAttributes } from 'astro/types'
import { toHtml } from 'hast-util-to-html'
import highlightCode from '../utils/highlight-code'
import { slotText } from '../utils/slot-text'
import CodeView from './CodeView.astro'
import type { CodeProp } from './code-props'

type Props = CodeProp & Omit<HTMLAttributes<'div'>, 'class'> & {
  /** The source; text children work too, as in `<Code lang="html">{`<div>`}</Code>`. */
  code?: string
}

const { code: source, ...props } = Astro.props
const code = source ?? await slotText(Astro.slots) ?? ''
const hast = await highlightCode(code, {
  lang: props.lang,
  beautify: !!props.beautify,
  dedent: props.dedent,
  className: props.preClassName,
  masterCSS: props.masterCSS
})
---

<CodeView {...props}><Fragment set:html={toHtml(hast)} /></CodeView>
