---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import type { Props as PageProps } from '../types/Props'

interface Props {
  /** Outermost first; each layer renders the next in its default slot. */
  layers: AstroComponentFactory[]
  props: PageProps
}

const { layers, props } = Astro.props
const [Layer, ...inner] = layers
---

{inner.length
  ? <Layer {...props}><Astro.self layers={inner} props={props} /></Layer>
  : <Layer {...props} />}
