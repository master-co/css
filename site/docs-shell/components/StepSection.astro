---
import '~/site/styles/system/data.css'
import '~/site/styles/docs-shell/steps.css'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'ol'>

/** Document steps on `ui-steps`: the list numbers each step beside its authored heading. Steps are `Step.astro`, split into `StepL.astro` and `StepR.astro`. */
const { class: className, ...props } = Astro.props
---

<ol {...props} class:list={['ui-steps', className]} data-variant="document"><slot /></ol>
