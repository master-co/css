---
import Link from './Link.svelte'
import { createTranslation } from '../utils/i18n'

interface Props {
  pageCategories?: { pages: any[] }[]
  metadata: any
  locale: string
  dictionaries: Record<string, () => Promise<any>>
}

/** The previous and next documents in the section's order, as a `ui-pager`. */
const { pageCategories, metadata, locale, dictionaries } = Astro.props
const $ = await createTranslation(locale, dictionaries)
const tw = locale === 'tw'
const unit = metadata?.pathname?.split('/')?.[1]
const pages = (pageCategories?.flatMap((category: any) => category.pages) || [])
  .filter(({ pathname }: any) => pathname.split('/').length <= 3 && unit)
const currentPageIndex = pages.findIndex(({ pathname }: any) => metadata.pathname === pathname)
const prevDefinedMetadata = currentPageIndex !== -1 && pages[currentPageIndex - 1]
const nextDefinedMetadata = currentPageIndex !== -1 && pages[currentPageIndex + 1]
const navs = [
  prevDefinedMetadata && { direction: 'prev', definedMetadata: prevDefinedMetadata },
  nextDefinedMetadata && { direction: 'next', definedMetadata: nextDefinedMetadata }
].filter(Boolean).map(({ direction, definedMetadata }: any) => ({
  direction,
  href: definedMetadata.pathname,
  label: direction === 'prev' ? (tw ? '上一篇' : 'Previous') : (tw ? '下一篇' : 'Next'),
  title: $(definedMetadata.title.absolute || definedMetadata.title)
}))
---

{navs.length > 0 && (
  <nav class="ui-pager" aria-label={tw ? '前後篇文件' : 'Previous and next documents'}>
    {navs.map(({ direction, href, label, title }) => <Link {href} rel={direction} aria-label={`${label}: ${title}`}>
      <small>{label}</small>
      <b>{title}</b>
    </Link>)}
  </nav>
)}
