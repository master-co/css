---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  /** Text and source side by side (`StepL`, `StepR`). */
  $row?: boolean
}

/** One step of a `StepSection`. */
const { $row, class: className, ...props } = Astro.props
---

<li><div {...props} class:list={['ui-steps-content', className]} data-columns={$row || undefined}><slot /></div></li>
