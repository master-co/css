---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'img'>

// Each image shows in one mode; the dark one is the source with `@dark` before its extension.
const { class: _class, ...props } = Astro.props
---

<img {...props} class="hidden@apply(--site-dark)" />
<img {...props} src={(props.src as string)?.replace(/(\.\w+)$/, '@dark$1')} class="hidden@apply(--site-light)" />
