---
import IconCheck from '@tabler/icons-svelte-runes/icons/check'
import IconCopy from '@tabler/icons-svelte-runes/icons/copy'

interface Props {
  text?: string
  name?: string
  class?: string
}

/**
 * Copies the code it belongs to through `docs-shell/scripts/code`: the icon swaps and the status beside it says what
 * happened (`data-result`). Pass `text` only when it differs from the rendered code lines.
 */
const { text, name, class: className } = Astro.props
const label = name ? `Copy ${name}` : 'Copy code'
---

<span class:list={['ui-copy', className]}>
  <span class="ui-copy-status" role="status"></span>
  <button type="button" class="ui-button" data-variant="quiet" data-shape="icon" data-size="sm" aria-label={label} title={label} data-code-copy={name ?? ''} data-code-copy-text={text}>
    <IconCopy size={16} stroke={1.5} aria-hidden="true" />
    <IconCheck size={16} stroke={1.6} aria-hidden="true" class="ui-result-icon" />
  </button>
</span>
