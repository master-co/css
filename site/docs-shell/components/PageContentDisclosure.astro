---
import '~/site/styles/docs-shell/page-content.css'
import type { PageContentItem } from './page-content.svelte'
import PageContentTitle from './PageContentTitle.svelte'
import groupPageContent from '../utils/group-page-content'

interface Props {
  items: (PageContentItem & { lang?: string })[]
  label: string
  labelLang?: string
}

/** The same heading inventory as the documentation rail, closed in a disclosure, available without hydration. */
const { items, label, labelLang } = Astro.props
---

<details class="ui-disclosure" data-variant="rule" data-contents-disclosure="">
  <summary lang={labelLang}>{label}</summary>
  <nav class="ui-toc" aria-label={label}>
    <ol>{groupPageContent(items).map(({ item, children }) => <li>
      <a href={`#${item.id}`} lang={item.lang}><PageContentTitle title={item.title} /></a>
      {children.length > 0 && <ol>{children.map(child => <li><a href={`#${child.id}`} lang={child.lang}><PageContentTitle title={child.title} /></a></li>)}</ol>}
    </li>)}</ol>
  </nav>
</details>
