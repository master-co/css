---
import { siteOf } from '~/site/astro/site-context'
import PageContentDisclosure from './PageContentDisclosure.astro'

interface Props {
  data: { id: string, title: string, level: number }[]
}

/**
 * A page's contents placed in its text: the same disclosure, drawn as the same ruler, that documentation pages show
 * under their header on narrow screens. Its label is in the reader's language, even inside text still in its source
 * language.
 */
const { t, i18n: { hreflangOfLocale }, locale } = siteOf(Astro)
const items = (Astro.props.data ?? []).filter((item): item is { id: string, title: string, level: 2 | 3 } => item.level === 2 || item.level === 3)
---

{items.some((item) => item.level === 2) && <PageContentDisclosure items={items} label={t('On this page')} labelLang={hreflangOfLocale?.[locale] ?? locale} />}
