---
import { siteOf } from '~/site/astro/site-context'
import { slotText } from '../utils/slot-text'

/**
 * Translates its text: a child that is only text is a dictionary key. Markup children render as they are,
 * since a slot cannot be taken apart into its text runs.
 */
const { t } = siteOf(Astro)
const html = Astro.slots.has('default') ? await Astro.slots.render('default') : ''
const text = /<[a-z!/]/i.test(html) ? undefined : await slotText(Astro.slots)
---

{text !== undefined ? t(text.trim()) : <Fragment set:html={html} />}
