---
import type { CodeProp } from './code-props'
import type { PreparedCode } from '../utils/prepared-code'
import CodeView from './CodeView.astro'

type Props = CodeProp & { prepared: PreparedCode }

/** A `CodeView` around a block highlighted ahead of rendering. */
const { prepared, ...props } = Astro.props
---

<CodeView {...props}><Fragment set:html={prepared.html} /></CodeView>
