---
import brands from '../data/brands'

interface Props {
  name: keyof typeof brands
}

/** A brand mark in an article header, resolved at the page that requests it. */
const brand = brands[Astro.props.name]
if (!brand) throw new Error(`Brand ${Astro.props.name} not found`)
const Icon = brand.src
---

<Icon class:list={['block w-full h-full max-w-full max-h-full', brand.headerClassName]} style={{ display: 'block', width: '100%', height: '100%', maxWidth: '100%', maxHeight: '100%' }} />
