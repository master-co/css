---
import ArticleHeader from '../components/ArticleHeader.astro'
import PageNavs from '../components/PageNavs.astro'
import DocMain from '../components/DocMain.astro'
import PageContent from '../components/PageContent.svelte'
import PageContentBootstrap from '../components/PageContentBootstrap.astro'
import DocArticle from '../components/DocArticle.astro'
import type { FooterProps } from '../components/Footer.svelte'
import type { PageParams } from '../types/Props'

interface Props {
  params: PageParams
  toc?: any[] | null
  pageCategories?: any
  metadata: any
  dictionaries: Record<string, () => Promise<any>>
  footerProps?: FooterProps
  class?: string
  /** The rest reaches `ArticleHeader`: `subtitle`, `categoryLink`, `icon`, `end`, … */
  [key: string]: any
}

const { params, toc, pageCategories, metadata, dictionaries, footerProps, ...props } = Astro.props
const { locale } = params
const pageContent = Array.isArray(toc) && toc.length > 0 ? toc : null
---

<DocMain class={props.class} footerProps={footerProps}>
  <DocArticle aside={Boolean(pageContent)}>
    <ArticleHeader {...props} locale={locale} metadata={metadata} dictionaries={dictionaries} toc={pageContent} />
    <slot />
    <PageNavs locale={locale} metadata={metadata} pageCategories={pageCategories} dictionaries={dictionaries} />
  </DocArticle>
  {pageContent && (
    <Fragment>
      {/* The rail's island serializes only the fields it renders. */}
      <PageContent client:load items={pageContent.map(({ id, title, level }) => ({ id, title, level }))} metadata={{ sourcePath: metadata.sourcePath, title: metadata.title }} />
      <PageContentBootstrap items={pageContent} />
    </Fragment>
  )}
</DocMain>
