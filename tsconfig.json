{
  "compilerOptions": {
    "jsx": "react",
    "paths": {
      "@master/css-cli": [ "./node_modules/@master/css-cli/src" ],
      "@master/css-compiler": [ "./node_modules/@master/css-compiler/src" ],
      "@master/css-compiler/*": [ "./node_modules/@master/css-compiler/src/*" ],
      "@master/css-preset": [ "./node_modules/@master/css-preset/src" ],
      "@master/css-preset/*": [ "./node_modules/@master/css-preset/src/*" ],
      "@master/create-css": [ "./node_modules/@master/create-css/src" ],
      "@master/css": [ "./node_modules/@master/css/src" ],
      "@master/css/*": [ "./node_modules/@master/css/src/*" ],
      "@master/eslint-config-css": [ "./node_modules/@master/eslint-config-css/src" ],
      "@master/eslint-plugin-css": [ "./node_modules/@master/eslint-plugin-css/src" ],
      "@master/css-internal-integration": [ "./node_modules/@master/css-internal-integration/src" ],
      "@master/css-internal-integration/*": [ "./node_modules/@master/css-internal-integration/src/*" ],
      "@master/css-schema": [ "./node_modules/@master/css-schema/src" ],
      "@master/css-schema/*": [ "./node_modules/@master/css-schema/src/*" ],
      "@master/css-wasm-compiler": [ "./packages/wasm-compiler/src" ],
      "@master/css-wasm-runtime": [ "./packages/wasm-runtime/src" ],
      "@master/css-wasm-tooling": [ "./packages/wasm-tooling/src" ],
      "@master/css-tooling": [ "./node_modules/@master/css-tooling/src" ],
      "@master/css-tooling/*": [ "./node_modules/@master/css-tooling/src/*" ],
      "@master/css-vite": [ "./node_modules/@master/css-vite/src" ],
      "@master/css-webpack": [ "./node_modules/@master/css-webpack/src" ],
      "@master/css-language-server": [ "./node_modules/@master/css-language-server/src" ],
      "@master/css-language-service": [ "./node_modules/@master/css-language-service/src" ],
      "@master/css-language-service/*": [ "./node_modules/@master/css-language-service/src/*" ],
      "@master/css-mcp": [ "./node_modules/@master/css-mcp/src" ],
      "@master/css-mcp/*": [ "./node_modules/@master/css-mcp/src/*" ],
      "@master/css-nuxt": [ "./node_modules/@master/css-nuxt/src/module.ts" ],
      "@master/css-next": [ "./node_modules/@master/css-next/src" ],
      "@master/css-runtime": [ "./node_modules/@master/css-runtime/src" ],
      "@master/css-server": [ "./node_modules/@master/css-server/src" ],
      "@master/css-sv": [ "./node_modules/@master/css-sv/src" ],
      "@master/css-svelte": [ "./node_modules/@master/css-svelte/src" ],
      "@master/css-svelte/*": [ "./node_modules/@master/css-svelte/src/lib/*" ],
      "@master/css-astro": [ "./node_modules/@master/css-astro/src" ],
      "@master/css-figma": [ "./node_modules/@master/css-figma/src" ],
      "@master/css-vscode": [ "./node_modules/@master/css-vscode/src" ],
      "~/*": [ "./*" ],
    },
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
  },
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
