#!/usr/bin/env sh

pnpm exec commitlint --edit "$1" || {
    cat <<'EOF'

Master CSS commit messages must follow Techor conventional commits:
  Type(Target): Summary

Examples:
  Fix(Core): Parse escaped selectors
  Docs(Site): Update box shadow reference
  Test(CLI): Cover extract watch mode

Types:
  Bump, Feat, New, Perf, Add, Update, Improve, Fix, Deprecate, Drop, Docs, Upgrade, Revert, Example, Test, Refactor, Chore, Misc

Use sentence case and no trailing period.
EOF
    exit 1
}
