---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Master CSS Astro progressive rendering">
	<main class="min-h:100vh p:10x bg:#f8fafc fg:#0f172a">
		<section class="max-width:960px mx:auto py:12x">
			<p class="inline-flex align-items:center h:32px px:3x r:999px bg:#eff6ff fg:royalblue font:14px font-weight:600">
				Astro integration
			</p>
			<h1 class="m:0 mt:4x font:48px font-weight:800 tracking:-.015em">
				Progressive rendering by default
			</h1>
			<p class="max-width:640px fg:#475569 font:18px line-height:1.7">
				The Astro integration pre-renders the CSS needed for the initial HTML and hydrates the Master CSS runtime for classes that appear later in the browser.
			</p>
			<div class="mt:6x p:5x r:10px bg:white border:1px|solid|#e2e8f0">
				<p class="m:0 fg:#475569 line-height:1.6">
					This button starts with pre-rendered classes. Click it to add a new runtime-only class after the page has loaded.
				</p>
				<button
					data-runtime-toggle
					class="inline-flex align-items:center h:44px px:5x mt:4x bg:black fg:white r:6px text:14px font-weight:600 border:0 cursor:pointer"
				>
					Hydrate runtime class
				</button>
			<p data-runtime-status class="m:0 mt:3x fg:#475569 font:14px">
					Waiting for interaction
				</p>
			</div>
		</section>
		<section class="max-width:960px mx:auto pb:12x">
			<ul role="list" class="grid grid-cols:3 gap:4x p:0 m:0">
			<Card
				href="https://css.master.co/guide/rendering-modes#progressive-rendering"
				title="pre-rendered CSS"
				body="Astro middleware injects style#master into HTML during static generation or server rendering."
			/>
			<Card
				href="https://css.master.co/reference/runtime"
				title="Runtime hydration"
				body="The browser runtime reuses the pre-rendered stylesheet and observes class changes after load."
			/>
			<Card
				href="https://css.master.co/guide/installation/astro"
				title="Default setup"
				body="Use masterCSS() in astro.config.mjs. Progressive mode is enabled unless you choose another mode."
			/>
			</ul>
		</section>
	</main>
</Layout>

<script>
	const button = document.querySelector('[data-runtime-toggle]');
	const status = document.querySelector('[data-runtime-status]');
	let active = false;

	button?.addEventListener('click', () => {
		active = !active;
		button.classList.toggle('bg:black', !active);
		button.classList.toggle('bg:royalblue', active);
		status?.classList.toggle('fg:#475569', !active);
		status?.classList.toggle('fg:mediumblue', active);
		if (status) {
			status.textContent = active
				? 'Runtime generated bg:royalblue and fg:mediumblue after hydration.'
				: 'Waiting for interaction';
		}
	});
</script>

<style>
	@media (max-width: 760px) {
		.grid-cols\:3 {
			grid-template-columns: 1fr;
		}
	}
</style>
