---
export interface Props {
  title: string;
  body: string;
  href: string;
}

const { href, title, body } = Astro.props;
---

<li class="(list-style:none)">
    <a class="block h-full (padding:1.25rem) r(8) bg-white (border:1px|solid|#e2e8f0) (text-decoration:none) (color:#0f172a)" href={href}>
      <h2 class="m(0) (font-size:18px) (font-weight:600)">
      {title}
    </h2>
    <p class="(margin-top:0.5rem) mb(0) (color:#475569) (line-height:1.6)">
      {body}
    </p>
  </a>
</li>
