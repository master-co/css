      }
    },
    "@nuxt/module-builder": {
      "dependencies": {
        "typescript-legacy-api": "npm:typescript@6.0.3"
      }
    },
    "@sveltejs/package": {
      "dependencies": {
        "typescript-legacy-api": "npm:typescript@6.0.3"
      }
    },
    "@typescript-eslint/eslint-plugin": {
      "dependencies": {
