{
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.9.0",
            "onFail": "ignore"
        }
    },
    "scripts": {
        "submodules": "pnpm dlx tsx submodules",
        "postinstall": "pnpm dlx husky install",
        "build": "turbo run build --filter=\"./packages/*\"",
        "build:examples": "turbo run build --filter=\"./examples/*\"",
        "release:vscode": "node packages/vscode/scripts/release.mjs",
        "check": "pnpm run commit-check && turbo run test lint type-check --filter=\"./packages/*\"",
        "test": "turbo run test --filter=\"./packages/*\"",
        "test:docs-consistency": "node --test .ai/scripts/validate-doc-consistency.test.mjs",
        "e2e": "turbo run e2e --filter=\"./packages/*\" --concurrency=1",
        "lint": "turbo run lint --filter=\"./packages/*\"",
        "type-check": "turbo run type-check --filter=\"./packages/*\"",
        "commit-check": "commitlint --from=HEAD~1 --verbose"
    },
    "engines": {
        "node": "^24"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git"
    },
    "dependencies": {
        "@eslint/compat": "^2.1.0",
        "@playwright/test": "1.61.0",
        "@swc-node/jest": "^1.9.1",
        "@techor/fs": "^3.2.5",
        "@techor/glob": "^3.2.5",
        "@techor/jest-dom": "^3.2.5",
        "@techor/repo": "^3.2.5",
        "@types/node": "^25.9.4",
        "@types/node-fetch": "^2.6.13",
        "@types/shuffle-array": "^1.0.5",
        "cross-env": "^10.1.0",
        "edit-json-file": "^1.8.1",
        "eslint": "^10.5.0",
        "eslint-plugin-playwright": "^2.10.4",
        "execa": "^9.6.1",
        "fast-glob": "^3.3.3",
        "get-tsconfig": "^4.14.0",
        "jest-extended": "^7.0.0",
        "jest-text-transformer": "^1.0.4",
        "js-beautify": "^1.15.4",
        "nanoid": "^5.1.15",
        "nodemon": "^3.1.14",
        "shuffle-array": "^1.0.1",
        "strip-ansi": "^7.2.0",
        "techor": "^3.2.5",
        "tinybench": "^6.0.2",
        "ts-dedent": "^2.3.0",
        "ts-jest": "^29.4.11",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.9"
    },
    "devDependencies": {
        "@master/css": "workspace:^",
        "@master/css-cli": "workspace:^",
        "@master/css-compiler": "workspace:^",
        "@master/css-engine": "workspace:^",
        "@master/css-integration": "workspace:^",
        "@master/css-language": "workspace:^",
        "@master/css-language-server": "workspace:^",
        "@master/css-language-service": "workspace:^",
        "@master/css-lexer": "workspace:^",
        "@master/css-lint": "workspace:^",
        "@master/css-preset": "workspace:^",
        "@master/css-project": "workspace:^",
        "@master/css-runtime": "workspace:^",
        "@master/css-scanner": "workspace:^",
        "@master/css-schema": "workspace:^",
        "@master/css-server": "workspace:^",
        "@master/css-source": "workspace:^",
        "@master/css-stylesheet": "workspace:^",
        "@master/css-validator": "workspace:^",
        "@master/css.figma": "workspace:^",
        "@master/css.next": "workspace:^",
        "@master/css.nuxt": "workspace:^",
        "@master/css.react": "workspace:^",
        "@master/css.svelte": "workspace:^",
        "@master/css.vite": "workspace:^",
        "@master/css.vue": "workspace:^",
        "@master/css.webpack": "workspace:^",
        "@master/eslint-config-css": "workspace:^",
        "@master/eslint-plugin-css": "workspace:^",
        "@types/edit-json-file": "^1.7.4",
        "commitlint": "^21.0.2",
        "concurrently": "^9.2.3",
        "eslint-config-techor": "^3.2.5",
        "master-css-vscode": "workspace:^",
        "turbo": "^2.10.0"
    }
}
