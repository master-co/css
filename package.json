{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "postinstall": "bun scripts/isolate-tooling-typescript.mjs && bun --bun husky install",
    "build": "bun scripts/storage-retention.mjs --apply --auto && bun run build:rust:wasm && bun ./node_modules/turbo/bin/turbo run build --filter=\"./packages/*\"",
    "build:rust:native": "cargo xtask build-native --release",
    "build:rust:wasm": "cargo xtask build-wasm all",
    "build:site": "bun scripts/storage-retention.mjs --apply --auto && bun run build && bun run --filter site build",
    "build:site:cloudflare-pages": "bash scripts/build-site-hosted.sh",
    "build:examples": "bun ./node_modules/turbo/bin/turbo run build --filter=\"./examples/*\"",
    "dev:site": "bun run build && bun run --filter site dev",
    "dev:site:clean": "bun run --filter site clean && bun run dev:site",
    "release:vscode": "node packages/vscode/scripts/release.js",
    "release": "node ./node_modules/semantic-release/bin/semantic-release.js",
    "check": "bun run check:toolchain && bun run test:toolchain && bun run check:ai-context && bun run check:rust && bun run check:mdn-registry && bun run check:boundaries && bun run check:packages && bun run check:release && bun run commit-check && bun ./node_modules/turbo/bin/turbo run test lint type-check --filter=\"./packages/*\" && bun run check:artifacts && bun run check:runtime-size",
    "check:ai-context": "bun scripts/check-ai-context.mjs",
    "check:api-census": "node scripts/check-api-census.mjs",
    "check:artifacts": "bun scripts/check-package-artifacts.mjs",
    "check:boundaries": "bun scripts/check-rust-core-boundaries.mjs",
    "check:mdn-registry": "bun scripts/build-rust-mdn-completion-registry.mjs --check",
    "check:packages": "node scripts/check-package-contracts.mjs",
    "check:packages:update": "node scripts/check-package-contracts.mjs --write",
    "check:runtime-size": "bun scripts/check-runtime-bundle-size.mjs",
    "check:runtime-size:update": "bun scripts/check-runtime-bundle-size.mjs --write",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace && cargo xtask codegen --check && cargo xtask parity",
    "check:release": "bun scripts/release-config-check.mjs",
    "test": "bun scripts/storage-retention.mjs --apply --auto && bun ./node_modules/turbo/bin/turbo run test --filter=\"./packages/*\"",
    "test:ai-context": "bun test scripts/check-ai-context.test.mjs",
    "e2e": "bun scripts/storage-retention.mjs --apply --auto && bun ./node_modules/turbo/bin/turbo run e2e --filter=\"./packages/*\" --filter=\"!@master/css-runtime\" --concurrency=1 && bun run --filter @master/css-runtime e2e",
    "lint": "bun ./node_modules/turbo/bin/turbo run lint --filter=\"./packages/*\"",
    "type-check": "bun ./node_modules/turbo/bin/turbo run type-check --filter=\"./packages/*\"",
    "type-check:refs": "bun --bun tsc -b tsconfig.typecheck.json",
    "type-check:clean": "bun --bun tsc -b tsconfig.typecheck.json --clean",
    "type-check:affected": "bun ./node_modules/turbo/bin/turbo run type-check --affected",
    "commit-check": "bun --bun commitlint --from=HEAD~1 --verbose",
    "storage:preview": "bun scripts/storage-retention.mjs",
    "storage:prune": "bun scripts/storage-retention.mjs --apply",
    "test:storage": "bun test scripts/storage-retention.spec.node.mjs",
    "turbo": "bun ./node_modules/turbo/bin/turbo",
    "check:toolchain": "bun scripts/check-toolchain.mjs",
    "test:toolchain": "node --test scripts/toolchain.test.mjs scripts/semantic-release-workspace.test.mjs scripts/tsdown-package.test.mjs"
  },
  "engines": {
    "node": "^24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git"
  },
  "dependencies": {
    "@master/css": "workspace:^",
    "@master/css-astro": "workspace:^",
    "@master/css-cli": "workspace:^",
    "@master/css-compiler": "workspace:^",
    "@master/css-figma": "workspace:^",
    "@master/css-language-server": "workspace:^",
    "@master/css-language-service": "workspace:^",
    "@master/css-mcp": "workspace:^",
    "@master/css-next": "workspace:^",
    "@master/css-nuxt": "workspace:^",
    "@master/css-preset": "workspace:^",
    "@master/css-runtime": "workspace:^",
    "@master/css-schema": "workspace:^",
    "@master/css-server": "workspace:^",
    "@master/css-svelte": "workspace:^",
    "@master/css-svelte-addon": "workspace:^",
    "@master/css-tooling": "workspace:^",
    "@master/css-vite": "workspace:^",
    "@master/css-webpack": "workspace:^",
    "@master/eslint-config-css": "workspace:^"
  },
  "devDependencies": {
    "@aronrepo/commitlint-config": "^2.2.1",
    "@aronrepo/conventional-changelog-config": "^2.2.1",
    "@aronrepo/conventional-commits": "^2.2.1",
    "@aronrepo/semantic-release-config": "^2.2.1",
    "@aronrepo/semantic-release-pnpm": "^2.2.1",
    "@commitlint/cli": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@master/css-vscode": "workspace:^",
    "@playwright/test": "1.64.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/edit-json-file": "^1.7.4",
    "@types/node": "^24.19.2",
    "aronrepo": "^2.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "edit-json-file": "^1.8.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "nanoid": "^6.0.2",
    "nodemon": "^3.1.14",
    "semantic-release": "^25.0.9",
    "strip-ansi": "^7.2.0",
    "ts-dedent": "^2.3.0",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks",
    "site"
  ],
  "overrides": {
    "dompurify@>=3.0.0 <3.4.13": "3.4.13",
    "qs@>=6.0.0 <6.16.0": "6.16.0",
    "rolldown-plugin-dts": "0.27.4"
  },
  "patchedDependencies": {
    "rolldown-plugin-dts@0.27.4": "patches/rolldown-plugin-dts@0.27.4.patch",
    "watchpack@2.5.2": "patches/watchpack@2.5.2.patch",
    "sv@1.1.1": "patches/sv@1.1.1.patch"
  },
  "trustedDependencies": [
    "@aronrepo/commitlint-config",
    "@aronrepo/conventional-changelog-config",
    "@aronrepo/conventional-commits",
    "@aronrepo/semantic-release-config",
    "@aronrepo/semantic-release-pnpm",
    "@firebase/util",
    "@parcel/watcher",
    "@swc/core",
    "@vscode/vsce-sign",
    "aronrepo",
    "esbuild",
    "lmdb",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "packageExtensions": {
    "@angular-devkit/build-angular": {
      "dependencies": {
        "typescript-legacy-api": "npm:typescript@6.0.3"
      }
    },
    "@angular/build": {
