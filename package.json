{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "postinstall": "bun scripts/isolate-tooling-typescript.mjs && bun --bun husky install",
    "build": "bun scripts/storage-retention.mjs --apply --auto && bun run build:rust:wasm && bun ./node_modules/turbo/bin/turbo run build --filter=\"./packages/*\"",
    "build:rust:native": "cargo xtask build-native --release",
    "build:rust:wasm": "bun ./node_modules/turbo/bin/turbo run build:artifacts --filter=\"./packages/binding-wasm-*\" --concurrency=1",
    "build:site": "bun scripts/storage-retention.mjs --apply --auto && bun run build && bun run --filter site build",
    "build:site:cloudflare-pages": "bash scripts/build-site-hosted.sh",
    "build:examples": "bun ./node_modules/turbo/bin/turbo run build --filter=\"./examples/*\"",
    "dev:site": "bun run build && bun run --filter site dev",
    "dev:site:clean": "bun run --filter site clean && bun run dev:site",
    "release:vscode": "node packages/vscode/scripts/release.js",
    "release": "node scripts/release.mjs",
    "check": "bun run check:toolchain && bun run test:toolchain && bun run check:ai-context && bun run check:rust && bun run check:mdn-registry && bun run check:boundaries && bun run check:packages && bun run check:release && bun run commit-check && bun ./node_modules/turbo/bin/turbo run test lint type-check --filter=\"./packages/*\" --concurrency=2 && bun run check:artifacts && bun run check:runtime-size",
    "check:ai-context": "bun scripts/check-ai-context.mjs",
    "check:api-census": "node scripts/check-api-census.mjs",
    "check:artifacts": "bun scripts/check-package-artifacts.mjs",
    "check:boundaries": "bun scripts/check-rust-core-boundaries.mjs",
    "check:mdn-registry": "bun scripts/build-rust-mdn-completion-registry.mjs --check",
    "check:packages": "node scripts/check-package-contracts.mjs",
    "check:packages:update": "node scripts/check-package-contracts.mjs --write",
    "check:runtime-size": "bun scripts/check-runtime-bundle-size.mjs",
    "check:runtime-size:update": "bun scripts/check-runtime-bundle-size.mjs --write",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace && cargo xtask codegen --check && cargo xtask parity",
    "check:release": "bun scripts/release-config-check.mjs",
    "test": "bun scripts/storage-retention.mjs --apply --auto && bun ./node_modules/turbo/bin/turbo run test --filter=\"./packages/*\" --concurrency=2",
    "test:ai-context": "bun test scripts/check-ai-context.test.mjs",
    "e2e": "bun scripts/storage-retention.mjs --apply --auto && bun ./node_modules/turbo/bin/turbo run e2e --filter=\"./packages/*\" --filter=\"!@master/css-runtime\" --concurrency=1 && bun run --filter @master/css-runtime e2e",
    "lint": "bun ./node_modules/turbo/bin/turbo run lint --filter=\"./packages/*\"",
    "type-check": "bun ./node_modules/turbo/bin/turbo run type-check --filter=\"./packages/*\"",
    "type-check:refs": "bun --bun tsc -b tsconfig.typecheck.json",
    "type-check:clean": "bun --bun tsc -b tsconfig.typecheck.json --clean",
    "type-check:affected": "bun ./node_modules/turbo/bin/turbo run type-check --affected",
    "commit-check": "aronrepo check --from HEAD~1",
    "storage:preview": "bun scripts/storage-retention.mjs",
    "storage:prune": "bun scripts/storage-retention.mjs --apply",
    "test:storage": "bun test ./scripts/storage-retention.spec.node.mjs",
    "turbo": "bun ./node_modules/turbo/bin/turbo",
    "check:toolchain": "bun scripts/check-toolchain.mjs",
    "test:toolchain": "node --test scripts/toolchain.test.mjs scripts/release-workspace.test.mjs scripts/tsdown-package.test.mjs scripts/site-toolchain-snapshot.test.mjs",
    "snapshot:site": "node scripts/site-toolchain-snapshot.mjs",
    "skills:sync": "master-skills sync",
    "skills:check": "master-skills check"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git"
  },
  "dependencies": {
    "@master/css": "workspace:^",
