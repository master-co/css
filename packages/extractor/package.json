{
    "name": "@master/css-extractor",
    "type": "module",
    "scripts": {
        "build": "techor build \"src/**/*.ts\" --formats esm",
        "dev": "techor build --watch",
        "lint": "eslint",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "bench": "tsx tests/bench.ts"
    },
    "license": "MIT",
    "description": "Master CSS static extraction for various raw text",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/extractor"
    },
    "keywords": [
        "plugin",
        "integration",
        "extractor",
        "static",
        "build tools",
        "css",
        "mastercss"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./style": {
            "types": "./dist/style.d.ts",
            "import": "./dist/style.mjs",
            "default": "./dist/style.mjs"
        },
        "./options": {
            "types": "./dist/options/index.d.ts",
            "import": "./dist/options/index.mjs",
            "default": "./dist/options/index.mjs"
        },
        "./adapters": {
            "types": "./dist/adapters/index.d.ts",
            "import": "./dist/adapters/index.mjs",
            "default": "./dist/adapters/index.mjs"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.ts"
            ],
            "./style": [
                "./dist/style.d.ts"
            ],
            "./options": [
                "./dist/options/index.d.ts"
            ],
            "./adapters": [
                "./dist/adapters/index.d.ts"
            ]
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-compiler": "workspace:^",
        "@master/css-configer": "workspace:^",
        "@master/css-validator": "workspace:^",
        "@techor/extend": "^3.2.5",
        "@techor/glob": "^3.2.5",
        "@techor/log": "^3.2.5",
        "bytes": "^3.1.2",
        "chokidar": "^5.0.0",
        "htmlparser2": "^12.0.0",
        "minimatch": "^10.2.5",
        "oxc-parser": "^0.129.0"
    },
    "devDependencies": {
        "@types/bytes": "^3.1.5",
        "shared": "workspace:^"
    }
}
