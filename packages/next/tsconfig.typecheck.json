{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tsbuild/typecheck",
    "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
  },
  "references": [
    {
      "path": "../css/tsconfig.typecheck.json"
    },
    {
      "path": "../internal/tsconfig.typecheck.json"
    },
    {
      "path": "../compiler/tsconfig.typecheck.json"
    },
    {
      "path": "../tooling/tsconfig.typecheck.json"
    },
    {
      "path": "../schema/tsconfig.typecheck.json"
    },
    {
      "path": "../server/tsconfig.typecheck.json"
    },
    {
      "path": "../runtime/tsconfig.typecheck.json"
    }
  ],
  "include": [
    "src/**/*.ts",
    "tests/**/*.test.ts",
    "tests/helpers/**/*.ts"
  ]
}
