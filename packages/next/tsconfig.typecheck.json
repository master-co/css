{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": false,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "rootDir": ".",
        "outDir": ".tsbuild/typecheck",
        "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
    },
    "references": [
        {
            "path": "../core/tsconfig.typecheck.json"
        },
        {
            "path": "../integration/tsconfig.typecheck.json"
        },
        {
            "path": "../lexer/tsconfig.typecheck.json"
        },
        {
            "path": "../project/tsconfig.typecheck.json"
        },
        {
            "path": "../scanner/tsconfig.typecheck.json"
        },
        {
            "path": "../schema/tsconfig.typecheck.json"
        },
        {
            "path": "../server/tsconfig.typecheck.json"
        },
        {
            "path": "../stylesheet/tsconfig.typecheck.json"
        }
    ],
    "include": [
        "src/**/*.ts",
        "tests/**/*.test.ts",
        "tests/helpers/**/*.ts"
    ]
}
