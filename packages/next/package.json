{
    "name": "@master/css.next",
    "type": "module",
    "scripts": {
        "build": "tsdown --config ../../shared/tsdown-package.config.ts",
        "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
        "dev:build": "pnpm --dir playground build",
        "e2e": "vitest run tests/css-manifest-query-e2e.test.ts",
        "lint": "eslint",
        "type-check": "tsc --noEmit",
        "test": "vitest"
    },
    "license": "MIT",
    "description": "Integrate Master CSS in Next.js way",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/next"
    },
    "keywords": [
        "adapter",
        "integration",
        "next",
        "nextjs",
        "build tools",
        "static",
        "pre-render",
        "css",
        "mastercss"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./adapter": {
            "types": "./dist/adapter.d.mts",
            "import": "./dist/adapter.mjs",
            "default": "./dist/adapter.mjs"
        }
    },
    "files": [
        "empty.css",
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "next": ">=16"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-scanner": "workspace:^",
        "@master/css-integration": "workspace:^",
        "@master/css-project": "workspace:^",
        "@master/css-server": "workspace:^",
        "@master/css-stylesheet": "workspace:^",
        "@master/css-schema": "workspace:^",
        "@master/css-lexer": "workspace:^"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "next": "^16.2.9",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    }
}
