{
  "name": "@master/css-next",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "dev:build": "bun run --cwd playground build",
    "e2e": "node ../../node_modules/vitest/vitest.mjs run tests/*-e2e.test.ts --no-file-parallelism",
    "lint": "bun --bun eslint",
    "type-check": "bun --bun tsc -b tsconfig.typecheck.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run"
  },
  "license": "MIT",
  "description": "Next.js integration for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/next"
  },
  "keywords": [
    "adapter",
    "integration",
    "next",
    "nextjs",
    "build tools",
    "static",
    "pre-render",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    }
  },
  "files": [
    "empty.css",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "dependencies": {
    "@master/css": "workspace:*",
    "@master/css-compiler": "workspace:*",
    "@master/css-tooling": "workspace:*",
    "@master/css-runtime": "workspace:*",
    "@master/css-server": "workspace:*",
    "@master/css-schema": "workspace:*"
  },
  "devDependencies": {
    "@master/css-internal": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
