{
    "name": "@master/css.vite",
    "type": "module",
    "scripts": {
        "build": "techor build \"src/**/*.ts\" --formats esm",
        "dev": "pnpm build --watch",
        "type-check": "tsc --noEmit",
        "lint": "eslint",
        "test": "vitest"
    },
    "license": "MIT",
    "description": "Integrate Master CSS in Vite way",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/vite"
    },
    "keywords": [
        "plugin",
        "integration",
        "vite",
        "build tools",
        "static extraction",
        "static",
        "runtime",
        "css runtime",
        "css",
        "mastercss",
        "vite-plugin"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./client": {
            "types": "./client.d.ts"
        }
    },
    "files": [
        "client.d.ts",
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "vite": ">=6"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-compiler": "workspace:^",
        "@master/css-explore-config": "workspace:^",
        "@master/css-extractor": "workspace:^",
        "@master/css-runtime": "workspace:^",
        "@master/css-server": "workspace:^",
        "@master/normal.css": "^3.2.0",
        "fast-glob": "^3.3.3",
        "magic-string": "^0.30.21",
        "source-map": "^0.7.6"
    },
    "devDependencies": {
        "shared": "workspace:^"
    }
}
