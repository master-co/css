{
  "name": "@master/css-vite",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Vite plugin for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/vite"
  },
  "keywords": [
    "plugin",
    "integration",
    "vite",
    "build tools",
    "static rendering",
    "static",
    "runtime",
    "css runtime",
    "css",
    "mastercss",
    "vite-plugin"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "dependencies": {
    "@master/css": "workspace:*",
    "@master/css-compiler": "workspace:*",
    "@master/css-tooling": "workspace:*",
    "@master/css-runtime": "workspace:*",
    "@master/css-server": "workspace:*",
    "magic-string": "^0.30.21",
    "@master/css-schema": "workspace:*"
  },
  "devDependencies": {
    "@master/css-build-internal": "workspace:*",
    "@master/css-preset": "workspace:*"
  }
}
