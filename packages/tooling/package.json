{
  "name": "@master/css-tooling",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "cargo xtask build-native && cargo xtask build-wasm tooling && vitest"
  },
  "license": "MIT",
  "description": "Rust-backed extraction, scanning, linting, language, validation, and diagnostics sessions for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/tooling"
  },
  "keywords": [
    "tooling",
    "scanner",
    "lint",
    "language-service",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "import": "./dist/builtins.js",
      "default": "./dist/builtins.js"
    },
    "./lexer": {
      "types": "./dist/lexer/index.d.ts",
      "import": "./dist/lexer/index.js",
      "default": "./dist/lexer/index.js"
    },
    "./lexer/node": {
      "types": "./dist/lexer/node.d.ts",
      "import": "./dist/lexer/node.js",
      "default": "./dist/lexer/node.js"
    },
    "./source": {
      "types": "./dist/source/index.d.ts",
      "import": "./dist/source/index.js",
      "default": "./dist/source/index.js"
    },
    "./source/node": {
      "types": "./dist/source/node.d.ts",
      "import": "./dist/source/node.js",
      "default": "./dist/source/node.js"
    },
    "./scanner/node": {
      "types": "./dist/scanner/node.d.ts",
      "import": "./dist/scanner/node.js",
      "default": "./dist/scanner/node.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.js",
      "default": "./dist/validator/index.js"
    },
    "./validator/node": {
      "types": "./dist/validator/node.d.ts",
      "import": "./dist/validator/node.js",
      "default": "./dist/validator/node.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js",
      "default": "./dist/lint/index.js"
    },
    "./lint/node": {
      "types": "./dist/lint/node.d.ts",
      "import": "./dist/lint/node.js",
      "default": "./dist/lint/node.js"
    },
    "./language": {
      "types": "./dist/language/index.d.ts",
      "import": "./dist/language/index.js",
      "default": "./dist/language/index.js"
    },
    "./language/node": {
      "types": "./dist/language/node.d.ts",
      "import": "./dist/language/node.js",
      "default": "./dist/language/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css-binding": "workspace:*",
    "@master/css-schema": "workspace:*",
    "consola": "^3.4.2",
    "css-tree": "^3.2.1",
    "defu": "^6.1.7",
    "mdn-data": "^2.28.1",
    "minimatch": "^10.2.5"
  },
  "peerDependencies": {
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "svelte": "^5.56.3",
    "vue": "^3.5.38"
  }
}
