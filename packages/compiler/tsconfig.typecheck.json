{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tsbuild/typecheck",
    "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
  },
  "references": [
    {
      "path": "../integration/tsconfig.typecheck.json"
    },
    {
      "path": "../native/tsconfig.typecheck.json"
    },
    {
      "path": "../preset/tsconfig.typecheck.json"
    },
    {
      "path": "../schema/tsconfig.typecheck.json"
    },
    {
      "path": "../tooling/tsconfig.typecheck.json"
    },
    {
      "path": "../wasm-compiler/tsconfig.typecheck.json"
    }
  ],
  "include": [
    "src/**/*.ts",
    "tests/**/*.test.ts",
    "tests/helpers/**/*.ts"
  ]
}
