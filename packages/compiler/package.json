{
  "name": "@master/css-compiler",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "cargo xtask build-native && cargo xtask build-wasm compiler && vitest"
  },
  "license": "MIT",
  "description": "Compile Master CSS stylesheet directives",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/compiler"
  },
  "keywords": [
    "compiler",
    "directives",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./project": {
      "types": "./dist/project/manifest.d.ts",
      "import": "./dist/project/manifest.js",
      "default": "./dist/project/manifest.js"
    },
    "./project/sync": {
      "types": "./dist/project/manifest-sync.d.ts",
      "import": "./dist/project/manifest-sync.js",
      "default": "./dist/project/manifest-sync.js"
    },
    "./stylesheet": {
      "types": "./dist/stylesheet/index-public.d.ts",
      "import": "./dist/stylesheet/index-public.js",
      "default": "./dist/stylesheet/index-public.js"
    },
    "./stylesheet/browser": {
      "types": "./dist/stylesheet/browser.d.ts",
      "import": "./dist/stylesheet/browser.js",
      "default": "./dist/stylesheet/browser.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js",
      "default": "./dist/diagnostics/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css-backend": "workspace:*",
    "@master/css-wasm-compiler": "workspace:*",
    "@master/css-wasm-tooling": "workspace:*",
    "@master/css-schema": "workspace:*",
    "@master/css-tooling": "workspace:*",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@master/css": "workspace:*",
    "@master/css-build-internal": "workspace:*",
    "@master/css-preset": "workspace:*"
  }
}
