{
    "name": "@master/css-compiler",
    "type": "module",
    "scripts": {
        "build": "tsdown --config ../../shared/tsdown-package.config.ts",
        "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
        "lint": "eslint",
        "type-check": "tsc -b tsconfig.typecheck.json",
        "test": "vitest"
    },
    "license": "MIT",
    "description": "Compile Master CSS stylesheet directives",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/compiler"
    },
    "keywords": [
        "compiler",
        "directives",
        "css",
        "mastercss"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./browser": {
            "types": "./dist/browser.d.mts",
            "import": "./dist/browser.mjs",
            "default": "./dist/browser.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@master/css-engine": "workspace:^",
        "@master/css-lexer": "workspace:^",
        "css-tree": "^3.2.1",
        "csstype": "^3.2.3",
        "lightningcss": "^1.32.0",
        "lightningcss-wasm": "^1.32.0",
        "@master/css-schema": "workspace:^"
    },
    "devDependencies": {
        "@master/css-preset": "workspace:^",
        "@types/css-tree": "^2.3.11"
    }
}
