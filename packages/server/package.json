{
  "name": "@master/css-server",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts && node scripts/restore-json-import-attributes.js",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "cargo xtask build-native && vitest"
  },
  "license": "MIT",
  "description": "Server-side HTML renderer for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/server"
  },
  "keywords": [
    "server",
    "static",
    "html",
    "markup",
    "dom",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css": "workspace:*",
    "@master/css-tooling": "workspace:*",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "@master/css-schema": "workspace:*"
  },
  "devDependencies": {
    "@master/css-backend": "workspace:*",
    "@master/css": "workspace:*",
    "@master/css-compiler": "workspace:*"
  }
}
