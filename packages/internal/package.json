{
  "name": "@master/css-internal",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Private Master CSS integration kernel, virtual module protocols, and official host helpers.",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/internal"
  },
  "keywords": [
    "integration",
    "virtual-module",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./manifest-module": {
      "types": "./dist/manifest-module.d.ts",
      "import": "./dist/manifest-module.js",
      "default": "./dist/manifest-module.js"
    },
    "./manifest-facade": {
      "types": "./dist/manifest-facade.d.ts",
      "import": "./dist/manifest-facade.js",
      "default": "./dist/manifest-facade.js"
    },
    "./manifest-loader": {
      "types": "./dist/manifest-loader.d.ts",
      "import": "./dist/manifest-loader.js",
      "default": "./dist/manifest-loader.js"
    },
    "./manifest-virtual-module": {
      "types": "./dist/manifest-virtual-module.d.ts",
      "import": "./dist/manifest-virtual-module.js",
      "default": "./dist/manifest-virtual-module.js"
    },
    "./style-module": {
      "types": "./dist/style-module.d.ts",
      "import": "./dist/style-module.js",
      "default": "./dist/style-module.js"
    },
    "./emitted-globals-module": {
      "types": "./dist/emitted-globals-module.d.ts",
      "import": "./dist/emitted-globals-module.js",
      "default": "./dist/emitted-globals-module.js"
    },
    "./runtime-bootstrap": {
      "types": "./dist/runtime-bootstrap.d.ts",
      "import": "./dist/runtime-bootstrap.js",
      "default": "./dist/runtime-bootstrap.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js",
      "default": "./dist/project.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./workspace-directories": {
      "types": "./dist/workspace-directories.d.ts",
      "import": "./dist/workspace-directories.js",
      "default": "./dist/workspace-directories.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@master/css-preset": "workspace:*",
    "@master/css-schema": "workspace:*"
  }
}
