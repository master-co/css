{
  "name": "@master/css-nuxt",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build && node scripts/normalize-module-build.js",
    "dev": "nuxt-module-build prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && node scripts/normalize-module-build.js && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "license": "MIT",
  "description": "Nuxt module for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "nitro",
    "vue",
    "server",
    "hooks",
    "css",
    "nuxt",
    "mastercss",
    "server-side-rendering",
    "ssr"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css-compiler": "workspace:*",
    "@master/css-runtime": "workspace:*",
    "@master/css-server": "workspace:*",
    "@master/css-schema": "workspace:*",
    "@master/css-vite": "workspace:*",
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@master/css-internal": "workspace:*",
    "@master/css-preset": "workspace:*",
    "@nuxt/devtools": "4.0.0-alpha.17",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@vue/test-utils": "^2.5.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "nuxt": "^4.5.2",
    "playwright-core": "^1.63.0",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  }
}
