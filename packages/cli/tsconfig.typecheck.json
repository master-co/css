{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tsbuild/typecheck",
    "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
  },
  "references": [
    {
      "path": "../facade/tsconfig.typecheck.json"
    },
    {
      "path": "../diagnostics/tsconfig.typecheck.json"
    },
    {
      "path": "../lexer/tsconfig.typecheck.json"
    },
    {
      "path": "../project/tsconfig.typecheck.json"
    },
    {
      "path": "../scanner/tsconfig.typecheck.json"
    },
    {
      "path": "../stylesheet/tsconfig.typecheck.json"
    }
  ],
  "include": [
    "src/**/*.ts",
    "tests/**/*.test.ts",
    "tests/**/test.ts",
    "package.json",
    "tests/helpers/**/*.ts"
  ]
}
