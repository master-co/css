    "@master/css-native": "workspace:*",
    "bytes": "^3.1.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.5",
    "upath": "^2.0.1"
