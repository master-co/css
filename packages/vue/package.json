{
    "name": "@master/css.vue",
    "type": "module",
    "scripts": {
        "build:main": "vite build",
        "build:type": "vue-tsc --declaration --emitDeclarationOnly --project tsconfig.prod.json",
        "build": "pnpm run \"/^build:/\"",
        "dev": "pnpm run build:main --watch",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint",
        "e2e": "playwright test -c playwright-ct.config.ts"
    },
    "license": "MIT",
    "description": "Integrate Master CSS in Vue way",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/vue"
    },
    "keywords": [
        "component",
        "element",
        "vue",
        "hooks",
        "use",
        "css",
        "mastercss",
        "class-name",
        "vuejs",
        "nuxtjs"
    ],
    "sideEffects": false,
    "main": "./dist/index.js",
    "jsnext:main": "./dist/index.js",
    "esnext": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./runtime-provider": {
            "types": "./dist/runtime-provider.d.ts",
            "import": "./dist/runtime-provider.js",
            "default": "./dist/runtime-provider.js"
        },
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.js",
            "default": "./dist/adapter.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js",
            "default": "./dist/vite.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "vue": ">= 3.0.0"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-integration": "workspace:^",
        "@master/css-runtime": "workspace:^",
        "@master/css-source": "workspace:^",
        "@master/css.vite": "workspace:^",
        "@techor/extend": "^3.2.5"
    },
    "devDependencies": {
        "@master/css-preset": "workspace:^",
        "@playwright/experimental-ct-vue": "1.61.0",
        "@playwright/test": "1.61.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/compiler-dom": "^3.5.38",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/server-renderer": "^3.5.38",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "eslint-plugin-vue": "^10.9.2",
        "typescript": "6.0.3",
        "vite": "^8.0.16",
        "vue-tsc": "^3.3.5",
        "@master/css-schema": "workspace:^"
    }
}
