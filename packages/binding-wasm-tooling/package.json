{
  "name": "@master/css-binding-wasm-tooling",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts",
    "build:artifacts": "cargo xtask build-wasm tooling",
    "dev": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "test": "bun --bun vitest run",
    "type-check": "bun --bun tsc -b tsconfig.typecheck.json",
    "lint": "bun --bun eslint"
  },
  "license": "MIT",
  "description": "Internal Master CSS tooling Wasm binding provider.",
  "sideEffects": false,
  "types": "./dist/provider.d.ts",
  "exports": {
    ".": {
      "types": "./dist/provider.d.ts",
      "browser": "./dist/provider.js",
      "node": "./dist/provider-node.js",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./wasm": "./artifacts/mastercss_binding_wasm_tooling_bg.wasm"
  },
  "files": [
    "dist",
    "artifacts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css-schema": "workspace:*"
  }
}
