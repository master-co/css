{
  "name": "@master/css-stylesheet",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Stylesheet entry pipeline for Master CSS static rendering",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/stylesheet"
  },
  "keywords": [
    "stylesheet",
    "static",
    "build tools",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./directives": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/directives.js",
      "default": "./dist/directives.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "./browser": [
        "./dist/browser.d.ts"
      ],
      "./directives": [
        "./dist/directives.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css": "workspace:^",
    "@master/css-compiler": "workspace:^",
    "@master/css-engine": "workspace:^",
    "@master/css-integration": "workspace:^",
    "@master/css-lexer": "workspace:^",
    "@master/css-source": "workspace:^",
    "@master/css-validator": "workspace:^",
    "fast-glob": "^3.3.3",
    "@master/css-schema": "workspace:^"
  },
  "devDependencies": {
    "@master/css-scanner": "workspace:^",
    "@master/css-preset": "workspace:^"
  }
}
