{
  "name": "@master/css-engine-js",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts",
    "test": "bun run differential",
    "type-check": "bun --bun tsc -b tsconfig.typecheck.json",
    "differential": "bun scripts/differential.mts",
    "check:size": "bun scripts/check-size.mjs",
    "bench:baseline": "node scripts/bench-baseline.mjs",
    "verify:program": "bun scripts/verify-program.mts",
    "generate:native-properties": "bun scripts/generate-native-properties.mjs"
  },
  "license": "MIT",
  "description": "Internal JS engine that executes compiled Master CSS runtime programs in browsers.",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@master/css-binding-wasm-compiler": "workspace:*",
    "@master/css-binding-wasm-engine": "workspace:*"
  }
}
