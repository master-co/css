// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`comp -> comp -> var > badge with common strong comp 1`] = `"@layer theme{@media (prefers-color-scheme:light){:root{--primary:var(--color-black);--primary-active:var(--gray);--primary-text:var(--color-white)}}@media (prefers-color-scheme:dark){:root{--primary:var(--color-white);--primary-active:var(--color-white);--primary-text:var(--color-black)}}:root{--color-black:oklch(0% 0 none);--color-white:oklch(100% 0 none)}}@layer main{.badge-primary{background:var(--primary)}.badge-primary{outline:0.0625rem var(--primary-active) solid}.badge-primary{color:var(--primary-text)}}"`;
