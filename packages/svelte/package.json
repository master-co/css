{
  "name": "@master/css-svelte",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && tsdown --config ../../shared/tsdown-package.config.ts && publint --pack false",
    "prepublishOnly": "pnpm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "Svelte and SvelteKit integration for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./hooks.server": {
      "types": "./dist/hooks.server.d.ts",
      "import": "./dist/hooks.server.js",
      "default": "./dist/hooks.server.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "dependencies": {
    "@master/css": "workspace:*",
    "@master/css-preset": "workspace:*",
    "@master/css-server": "workspace:*",
    "@master/css-vite": "workspace:*",
    "@master/css-schema": "workspace:*"
  },
  "devDependencies": {
    "@master/css-internal": "workspace:*",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-svelte": "^1.58.2",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
