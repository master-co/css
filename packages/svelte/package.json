{
    "name": "@master/css.svelte",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && pnpm run package",
        "preview": "vite preview",
        "package": "svelte-kit sync && svelte-package && publint --pack false",
        "prepublishOnly": "pnpm run package",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest",
        "lint": "eslint"
    },
    "license": "MIT",
    "description": "Integrate Master CSS in Svelte way",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/svelte"
    },
    "keywords": [
        "svelte",
        "providers",
        "css",
        "mastercss"
    ],
    "sideEffects": false,
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./runtime-provider": {
            "types": "./dist/runtime-provider.d.ts",
            "svelte": "./dist/runtime-provider.js"
        },
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.js",
            "default": "./dist/adapter.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js",
            "default": "./dist/vite.js"
        },
        "./hooks.server": {
            "types": "./dist/hooks.server.d.ts",
            "import": "./dist/hooks.server.js",
            "default": "./dist/hooks.server.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "svelte": ">=4"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-integration": "workspace:^",
        "@master/css-preset": "workspace:^",
        "@master/css-runtime": "workspace:^",
        "@master/css-server": "workspace:^",
        "@master/css-source": "workspace:^",
        "@master/css.vite": "workspace:^"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@playwright/experimental-ct-svelte": "^1.58.2",
        "@playwright/test": "^1.61.0",
        "@sveltejs/adapter-vercel": "^6.3.4",
        "@sveltejs/kit": "^2.66.0",
        "@sveltejs/package": "^2.5.8",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "publint": "^0.3.21",
        "shared": "workspace:^",
        "svelte": "^5.56.3",
        "svelte-check": "^4.6.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.9"
    }
}
