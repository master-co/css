{
  "name": "@master/css-language-service",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts && node scripts/restore-json-import-attributes.js",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint",
    "test": "cargo xtask build-native && vitest"
  },
  "description": "Master CSS Language Service",
  "author": "Aoyue Design LLC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/language-service"
  },
  "dependencies": {
    "@master/css-preset": "workspace:*",
    "@master/css-schema": "workspace:*",
    "@master/css-tooling": "workspace:*",
    "colorjs.io": "^0.6.1",
    "defu": "^6.1.7",
    "js-beautify": "^1.15.4",
    "minimatch": "^10.2.5",
    "vscode-languageserver-protocol": "^3.18.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "shiki": "^4.2.0",
    "vscode-languageserver": "^10.0.0"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "default": "./dist/common.js"
    },
    "./shiki": {
      "types": "./dist/shiki.d.ts",
      "import": "./dist/shiki.js",
      "default": "./dist/shiki.js"
    },
    "./syntaxes/master-css.tmLanguage.json": "./syntaxes/master-css.tmLanguage.json"
  },
  "files": [
    "dist",
    "syntaxes"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
