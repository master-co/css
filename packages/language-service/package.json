{
    "name": "@master/css-language-service",
    "type": "module",
    "scripts": {
        "build": "tsdown --config ../../shared/tsdown-package.config.ts",
        "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
        "type-check": "tsc --noEmit",
        "lint": "eslint",
        "test": "vitest"
    },
    "description": "Master CSS Language Service",
    "author": "Aoyue Design LLC.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/language-service"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-engine": "workspace:^",
        "@master/css-language": "workspace:^",
        "@techor/extend": "^3.2.5",
        "colorjs.io": "^0.6.1",
        "js-beautify": "^1.15.4",
        "minimatch": "^10.2.5",
        "vscode-languageserver-protocol": "^3.18.0",
        "vscode-languageserver-textdocument": "^1.0.12"
    },
    "devDependencies": {
        "@types/vscode": "^1.125.0",
        "vscode-languageserver": "^10.0.0",
        "@master/css-schema": "workspace:^"
    },
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./common": {
            "types": "./dist/common.d.mts",
            "import": "./dist/common.mjs",
            "default": "./dist/common.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
