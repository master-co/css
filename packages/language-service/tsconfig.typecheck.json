{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tsbuild/typecheck",
    "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
  },
  "references": [
    {
      "path": "../schema/tsconfig.typecheck.json"
    },
    {
      "path": "../tooling/tsconfig.typecheck.json"
    }
  ],
  "include": [
    "src/**/*.ts",
    "syntaxes/**/*.json",
    "tests/**/*.test.ts",
    "tests/**/test.ts",
    "tests/helpers/**/*.ts",
    "tests/**/helper.ts"
  ]
}
