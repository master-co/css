{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tsbuild/typecheck",
    "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
  },
  "references": [
    { "path": "../schema/tsconfig.typecheck.json" }
  ],
  "include": ["src/**/*.ts", "tests/**/*.test.ts"]
}
