  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tsbuild/typecheck",
    "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
  },
  "references": [
    {
      "path": "../preset/tsconfig.typecheck.json"
    },
    {
      "path": "../schema/tsconfig.typecheck.json"
    },
    {
      "path": "../validator/tsconfig.typecheck.json"
    },
    {
      "path": "../wasm-tooling/tsconfig.typecheck.json"
    }
  ]
}
