{
    "name": "@master/css-runtime",
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "bench": "node scripts/benchmark-runtime.mjs",
        "dev": "tsdown --watch",
        "e2e": "playwright test",
        "e2e:watch": "nodemon -e js,mjs,ts,html,css --watch dist --watch e2e --watch tests --exec playwright test",
        "type-check": "tsc -b tsconfig.typecheck.json",
        "lint": "eslint"
    },
    "license": "MIT",
    "description": "Run Master CSS right in the browser",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/runtime"
    },
    "keywords": [
        "utility",
        "css",
        "lightweight",
        "mastercss",
        "master",
        "runtime",
        "cdn"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "browser": "./dist/global.min.js",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": {
                "development": "./dist/index.development.mjs",
                "default": "./dist/index.mjs"
            },
            "default": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@master/css-engine": "workspace:^",
        "@master/css-preset": "workspace:^",
        "@master/css-schema": "workspace:^"
    },
    "devDependencies": {
        "@master/css": "workspace:^",
        "@master/css-compiler": "workspace:^",
        "@master/css-integration": "workspace:^",
        "@playwright/test": "1.61.0"
    }
}
