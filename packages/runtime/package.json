{
  "name": "@master/css-runtime",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown",
    "bench": "node scripts/benchmark-runtime.js",
    "dev": "tsdown --watch",
    "e2e": "playwright test",
    "e2e:watch": "nodemon -e js,ts,html,css --watch dist --watch e2e --watch tests --exec playwright test",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "Browser runtime for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "utility",
    "css",
    "lightweight",
    "mastercss",
    "master",
    "runtime",
    "cdn"
  ],
  "sideEffects": false,
  "browser": "./dist/global.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "artifacts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css": "workspace:*",
    "@master/css-preset": "workspace:*",
    "@master/css-schema": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  }
}
