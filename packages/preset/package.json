{
    "name": "@master/css-preset",
    "type": "module",
    "scripts": {
        "build": "techor build \"src/**/*.ts\" --formats esm",
        "dev": "pnpm build --watch",
        "generate": "tsx scripts/generate-default-plan.ts",
        "lint": "eslint",
        "type-check": "tsc --noEmit",
        "test": "vitest"
    },
    "license": "MIT",
    "description": "The default Master CSS preset source and compiled plan.",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/preset"
    },
    "keywords": [
        "preset",
        "css",
        "mastercss"
    ],
    "sideEffects": [
        "./src/*.css"
    ],
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "style": "./src/index.css",
    "exports": {
        ".": {
            "style": "./src/index.css",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./default-plan": {
            "types": "./dist/default-plan.d.ts",
            "import": "./dist/default-plan.mjs",
            "default": "./dist/default-plan.mjs"
        },
        "./index.css": "./src/index.css",
        "./base.css": "./src/base.css",
        "./theme.css": "./src/theme.css",
        "./syntax.css": "./src/syntax.css"
    },
    "files": [
        "dist",
        "src/*.css"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@master/css-engine": "workspace:^"
    },
    "devDependencies": {
        "@master/css-compiler": "workspace:^",
        "tsx": "^4.21.0",
        "shared": "workspace:^"
    }
}
