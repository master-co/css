{
    "name": "@master/css-preset",
    "type": "module",
    "scripts": {
        "build": "pnpm generate && techor build \"src/**/!(*.d).ts\" --formats esm",
        "dev": "pnpm build --watch",
        "generate": "node --import tsx scripts/generate-default-manifest.ts",
        "lint": "eslint",
        "type-check": "tsc --noEmit",
        "test": "vitest"
    },
    "license": "MIT",
    "description": "The default Master CSS preset source and compiled manifest.",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/preset"
    },
    "keywords": [
        "preset",
        "css",
        "mastercss"
    ],
    "sideEffects": [
        "./src/*.css"
    ],
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "style": "./src/index.css",
    "exports": {
        ".": {
            "style": "./src/index.css",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./default-manifest.json": {
            "types": "./src/default-manifest.json.d.ts",
            "import": "./src/default-manifest.json",
            "default": "./src/default-manifest.json"
        },
        "./index.css": "./src/index.css",
        "./base.css": "./src/base.css",
        "./theme.css": "./src/theme.css",
        "./variants.css": "./src/variants.css",
        "./utilities.css": "./src/utilities.css"
    },
    "files": [
        "dist",
        "src/*.css",
        "src/default-manifest.json",
        "src/default-manifest.json.d.ts"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "devDependencies": {
        "tsx": "^4.22.4"
    }
}
