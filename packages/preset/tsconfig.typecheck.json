{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": false,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "rootDir": ".",
        "outDir": ".tsbuild/typecheck",
        "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
    },
    "references": [],
    "include": [
        "scripts/**/*.ts",
        "src/**/*.ts",
        "tests/**/*.test.ts",
        "src/**/*.json"
    ]
}
