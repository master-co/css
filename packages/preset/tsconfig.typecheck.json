{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".tsbuild/typecheck",
    "tsBuildInfoFile": ".tsbuild/typecheck/tsconfig.tsbuildinfo"
  },
  "references": [
    { "path": "../native/tsconfig.typecheck.json" },
    { "path": "../schema/tsconfig.typecheck.json" }
  ],
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.test.ts",
    "src/**/*.json"
  ]
}
