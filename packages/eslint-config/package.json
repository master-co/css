{
  "name": "@master/eslint-config-css",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "type-check": "bun --bun tsc -b tsconfig.typecheck.json",
    "test": "bun --bun vitest run",
    "lint": "bun --bun eslint src *.js"
  },
  "keywords": [
    "mastercss",
    "eslint",
    "eslintconfig"
  ],
  "license": "MIT",
  "description": "Official Master CSS flat ESLint configuration",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/eslint-config"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/eslint-plugin-css": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.6.0",
    "eslint": "^10.13.0"
  }
}
