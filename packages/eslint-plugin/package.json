{
  "name": "@master/eslint-plugin-css",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "bun --bun tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "test": "bun --bun vitest run",
    "type-check": "bun --bun tsc -b tsconfig.typecheck.json",
    "lint": "bun --bun eslint"
  },
  "keywords": [
    "mastercss",
    "eslint",
    "eslintplugin"
  ],
  "license": "MIT",
  "description": "Master CSS ESLint Plugin",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/eslint-plugin"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css": "workspace:*",
    "@master/css-compiler": "workspace:*",
    "@master/css-tooling": "workspace:*",
    "@master/css-preset": "workspace:*",
    "@typescript-eslint/utils": "^8.72.0",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.6.0",
    "@master/css-internal": "workspace:*",
    "@master/css-schema": "workspace:*",
    "@angular/compiler": "^22.2.3",
    "@typescript-eslint/rule-tester": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-mdx": "^3.8.2",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-mdx": "^3.8.2",
    "svelte-eslint-parser": "^1.10.0",
    "ts-node": "^10.9.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
