{
    "name": "@master/css.react",
    "type": "module",
    "scripts": {
        "build": "tsdown --config ../../shared/tsdown-package.config.ts",
        "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
        "type-check": "tsc --noEmit",
        "lint": "eslint",
        "e2e": "playwright test -c playwright-ct.config.ts"
    },
    "license": "MIT",
    "description": "Integrate Master CSS in React way",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/react"
    },
    "keywords": [
        "component",
        "element",
        "react",
        "hooks",
        "use",
        "css",
        "mastercss",
        "class-name",
        "reactjs",
        "nextjs",
        "solidjs"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./runtime-provider": {
            "types": "./dist/runtime-provider.d.mts",
            "import": "./dist/runtime-provider.mjs",
            "default": "./dist/runtime-provider.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "@types/react": ">=16",
        "react": ">=16"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-integration": "workspace:^",
        "@master/css-runtime": "workspace:^"
    },
    "devDependencies": {
        "@master/css-preset": "workspace:^",
        "@playwright/experimental-ct-react": "1.61.0",
        "@playwright/test": "1.61.0",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "@master/css-schema": "workspace:^"
    }
}
