{
  "name": "@master/css-schema",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Public Master CSS schema and wire-format contracts.",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/schema"
  },
  "keywords": [
    "schema",
    "manifest",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest-json": {
      "types": "./dist/manifest-json.d.ts",
      "import": "./dist/manifest-json.js",
      "default": "./dist/manifest-json.js"
    },
    "./hydration-manifest": {
      "types": "./dist/hydration-manifest.d.ts",
      "import": "./dist/hydration-manifest.js",
      "default": "./dist/hydration-manifest.js"
    },
    "./css-directives": {
      "types": "./dist/css-directives.d.ts",
      "import": "./dist/css-directives.js",
      "default": "./dist/css-directives.js"
    },
    "./css-syntax": {
      "types": "./dist/css-syntax.d.ts",
      "import": "./dist/css-syntax.js",
      "default": "./dist/css-syntax.js"
    },
    "./utility-type": {
      "types": "./dist/utility-type.d.ts",
      "import": "./dist/utility-type.js",
      "default": "./dist/utility-type.js"
    },
    "./runtime-style": {
      "types": "./dist/runtime-style.d.ts",
      "import": "./dist/runtime-style.js",
      "default": "./dist/runtime-style.js"
    },
    "./emitted-globals": {
      "types": "./dist/emitted-globals.d.ts",
      "import": "./dist/emitted-globals.js",
      "default": "./dist/emitted-globals.js"
    },
    "./native-css-shorthand": {
      "types": "./dist/native-css-shorthand.d.ts",
      "import": "./dist/native-css-shorthand.js",
      "default": "./dist/native-css-shorthand.js"
    },
    "./css-common": {
      "types": "./dist/css-common.d.ts",
      "import": "./dist/css-common.js",
      "default": "./dist/css-common.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "csstype": "^3.2.3"
  }
}
