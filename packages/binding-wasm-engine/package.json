{
  "name": "@master/css-binding-wasm-engine",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "test": "cargo xtask build-wasm && vitest",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint"
  },
  "license": "MIT",
  "description": "Internal Master CSS engine Wasm binding provider.",
  "sideEffects": false,
  "types": "./dist/provider.d.ts",
  "exports": {
    ".": {
      "types": "./dist/provider.d.ts",
      "browser": "./dist/provider.js",
      "node": "./dist/provider-node.js",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./wasm": "./artifacts/mastercss_binding_wasm_engine_bg.wasm"
  },
  "files": ["dist", "artifacts"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css-schema": "workspace:*"
  }
}
