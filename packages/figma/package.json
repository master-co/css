{
  "name": "@master/css-figma",
  "version": "1.0.0",
  "description": "Figma plugin for Master CSS variables and modes",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "bun run build:plugin & bun run build:ui",
    "build:plugin": "bun --bun tsdown",
    "build:ui": "concurrently \"bun run build:ui:export-variables\" \"bun run build:ui:import-variables\"",
    "build:ui:export-variables": "bun --bun vite build --mode export-variables",
    "build:ui:import-variables": "bun --bun vite build --mode import-variables",
    "lint": "bun --bun eslint",
    "type-check": "bun --bun tsc -b tsconfig.typecheck.json",
    "test": "bun --bun vitest run"
  },
  "author": "Aoyue Design LLC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/figma"
  },
  "exports": {},
  "files": [
    "dist",
    "out",
    "manifest.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.142.0",
    "@master/css": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "colorjs.io": "^0.7.1",
    "dot-prop": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^7.0.2",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "copy-to-clipboard": "^4.0.2",
    "petite-vue": "^0.4.1",
    "preact": "^11.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
