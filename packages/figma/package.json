{
    "name": "@master/css.figma",
    "version": "1.0.0",
    "description": "Master CSS Figma Plugin",
    "main": "./dist/plugin.min.mjs",
    "type": "module",
    "scripts": {
        "build": "pnpm build:plugin & pnpm build:ui",
        "build:plugin": "techor build",
        "build:ui": "concurrently \"pnpm:build:ui:*\"",
        "build:ui:export-variables": "vite build --mode export-variables",
        "build:ui:import-variables": "vite build --mode import-variables",
        "lint": "eslint",
        "type-check": "tsc --noEmit",
        "test": "vitest"
    },
    "author": "Aoyue Design LLC.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/figma"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "devDependencies": {
        "@figma/eslint-plugin-figma-plugins": "^1.0.0",
        "@figma/plugin-typings": "^1.125.0",
        "@master/css": "workspace:^",
        "@master/normal.css": "^3.2.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "colorjs.io": "^0.6.1",
        "dot-prop": "^10.1.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "typescript": "^6.0.3",
        "vite-plugin-singlefile": "^2.3.3"
    },
    "dependencies": {
        "copy-to-clipboard": "^4.0.2",
        "petite-vue": "^0.4.1",
        "preact": "^10.29.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    }
}