{
    "name": "@master/css-source",
    "type": "module",
    "scripts": {
        "build": "tsdown --config ../../shared/tsdown-package.config.ts",
        "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
        "lint": "eslint",
        "type-check": "tsc --noEmit",
        "test": "vitest"
    },
    "license": "MIT",
    "description": "Source class extraction helpers for Master CSS tooling",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/source"
    },
    "keywords": [
        "source",
        "scanner",
        "classes",
        "adapters",
        "css",
        "mastercss"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "jsnext:main": "./dist/index.mjs",
    "esnext": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./adapters": {
            "types": "./dist/adapters/index.d.mts",
            "import": "./dist/adapters/index.mjs",
            "default": "./dist/adapters/index.mjs"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "./dist/index.d.mts"
            ],
            "./adapters": [
                "./dist/adapters/index.d.mts"
            ]
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@master/css-lexer": "workspace:^",
        "htmlparser2": "^12.0.0",
        "oxc-parser": "^0.137.0"
    }
}
