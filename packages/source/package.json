{
  "name": "@master/css-source",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "lint": "eslint",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "test": "vitest"
  },
  "license": "MIT",
  "description": "Source class extraction helpers for Master CSS tooling",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/source"
  },
  "keywords": [
    "source",
    "scanner",
    "classes",
    "adapters",
    "css",
    "mastercss"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./adapters/astro": {
      "types": "./dist/adapters/astro.d.ts",
      "import": "./dist/adapters/astro.js",
      "default": "./dist/adapters/astro.js"
    },
    "./adapters/svelte": {
      "types": "./dist/adapters/svelte.d.ts",
      "import": "./dist/adapters/svelte.js",
      "default": "./dist/adapters/svelte.js"
    },
    "./adapters/vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/adapters/vue.js",
      "default": "./dist/adapters/vue.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "./adapters": [
        "./dist/adapters/index.d.ts"
      ],
      "./adapters/astro": [
        "./dist/adapters/astro.d.ts"
      ],
      "./adapters/svelte": [
        "./dist/adapters/svelte.d.ts"
      ],
      "./adapters/vue": [
        "./dist/adapters/vue.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@master/css-lexer": "workspace:^",
    "htmlparser2": "^12.0.0",
    "oxc-parser": "^0.137.0"
  },
  "peerDependencies": {
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "svelte": "^5.56.3",
    "vue": "^3.5.38"
  }
}
