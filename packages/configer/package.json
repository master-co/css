{
    "name": "@master/css-configer",
    "type": "module",
    "scripts": {
        "build": "techor build \"src/**/*.ts\" --formats esm",
        "dev": "pnpm build --watch",
        "lint": "eslint",
        "type-check": "tsc --noEmit",
        "test": "vitest"
    },
    "license": "MIT",
    "description": "Master CSS config resolution and loading utilities.",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/configer"
    },
    "keywords": [
        "config",
        "configer",
        "css",
        "mastercss"
    ],
    "sideEffects": false,
    "types": "./dist/load.d.ts",
    "exports": {
        "./load": {
            "types": "./dist/load.d.ts",
            "import": "./dist/load.mjs",
            "default": "./dist/load.mjs"
        },
        "./load-sync": {
            "types": "./dist/load-sync.d.ts",
            "import": "./dist/load-sync.mjs",
            "default": "./dist/load-sync.mjs"
        },
        "./module": {
            "types": "./dist/module.d.ts",
            "import": "./dist/module.mjs",
            "default": "./dist/module.mjs"
        },
        "./css": {
            "types": "./dist/css.d.ts",
            "import": "./dist/css.mjs",
            "default": "./dist/css.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "devDependencies": {
        "shared": "workspace:^"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-compiler": "workspace:^"
    }
}
