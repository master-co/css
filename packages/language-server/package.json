{
    "name": "@master/css-language-server",
    "type": "module",
    "scripts": {
        "build": "tsdown --config ../../shared/tsdown-package.config.ts",
        "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
        "type-check": "tsc -b tsconfig.typecheck.json",
        "lint": "eslint",
        "test": "vitest"
    },
    "description": "Master CSS Language Server",
    "author": "Aoyue Design LLC.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/language-server"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-compiler": "workspace:^",
        "@master/css-language": "workspace:^",
        "@master/css-language-service": "workspace:^",
        "@master/css-project": "workspace:^",
        "defu": "^6.1.7",
        "fast-glob": "^3.3.3",
        "js-beautify": "^1.15.4",
        "nanoid": "^5.1.15",
        "vscode-languageserver": "^10.0.0",
        "vscode-languageserver-textdocument": "^1.0.12",
        "vscode-uri": "^3.1.0",
        "@master/css-schema": "workspace:^"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "jsnext:main": "./dist/index.js",
    "esnext": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "default": "./dist/server.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
