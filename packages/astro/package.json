{
    "name": "@master/css.astro",
    "type": "module",
    "scripts": {
        "build": "tsdown --config ../../shared/tsdown-package.config.ts",
        "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
        "test": "vitest",
        "type-check": "tsc -b tsconfig.typecheck.json",
        "lint": "eslint"
    },
    "license": "MIT",
    "description": "Astro integration for Master CSS",
    "author": "Aoyue Design LLC.",
    "funding": "https://rc.css.master.co/sponsor",
    "homepage": "https://css.master.co",
    "bugs": {
        "url": "https://github.com/master-co/css/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/master-co/css.git",
        "directory": "packages/astro"
    },
    "keywords": [
        "plugin",
        "integration",
        "astro",
        "build tools",
        "static rendering",
        "static",
        "runtime",
        "css runtime",
        "css",
        "mastercss",
        "astro-plugin"
    ],
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "jsnext:main": "./dist/index.js",
    "esnext": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./middleware": {
            "types": "./dist/middleware.d.ts",
            "import": "./dist/middleware.js",
            "default": "./dist/middleware.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "astro": ">=5",
        "vite": ">=6"
    },
    "dependencies": {
        "@master/css": "workspace:^",
        "@master/css-integration": "workspace:^",
        "@master/css-server": "workspace:^",
        "@master/css.vite": "workspace:^",
        "@master/css-schema": "workspace:^"
    },
    "devDependencies": {
        "@master/css-preset": "workspace:^"
    }
}
