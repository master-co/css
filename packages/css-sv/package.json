{
  "name": "@master/css-svelte-addon",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "dev": "bun --bun tsdown --watch",
    "lint": "bun --bun eslint",
    "test": "bun --bun vitest run"
  },
  "license": "MIT",
  "description": "Svelte CLI add-on for Master CSS",
  "author": "Aoyue Design LLC.",
  "funding": "https://rc.css.master.co/sponsor",
  "homepage": "https://css.master.co",
  "bugs": {
    "url": "https://github.com/master-co/css/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/css-sv"
  },
  "keywords": [
    "sv",
    "sv-add",
    "svelte",
    "sveltekit",
    "css",
    "mastercss"
