{
    "$schema": "https://json.schemastore.org/tmLanguage",
    "name": "master-css",
    "scopeName": "source.master-css.injection-css",
    "injectionSelector": "L:source.css -comment -string",
    "patterns": [
        {
            "include": "#master-css-block"
        },
        {
            "include": "#master-css-managed-layer-block"
        },
        {
            "include": "#master-css-extractor-directives"
        }
    ],
    "repository": {
        "master-css-block": {
            "begin": "((@)master)(\\s*)(\\{)",
            "end": "(\\})",
            "name": "meta.at-rule.master-css.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "punctuation.section.master-css.begin.bracket.curly.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.master-css.end.bracket.curly.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-nested-block-body"
                }
            ]
        },
        "master-css-extractor-directives": {
            "patterns": [
                {
                    "include": "#master-css-shake-directive"
                },
                {
                    "include": "#master-css-no-shake-directive"
                },
                {
                    "include": "#master-css-source-directive"
                },
                {
                    "include": "#master-css-class-directive"
                }
            ]
        },
        "master-css-shake-directive": {
            "begin": "((@)master)(\\s+)(shake)(?=\\s|;)",
            "end": "(;)|(?=\\})",
            "name": "meta.at-rule.master-css.shake.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "support.type.property-name.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "source.css#comment-block"
                }
            ]
        },
        "master-css-no-shake-directive": {
            "begin": "((@)master)(\\s+)(no-shake)(?=\\s|;)",
            "end": "(;)|(?=\\})",
            "name": "meta.at-rule.master-css.no-shake.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "support.type.property-name.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "source.css#comment-block"
                }
            ]
        },
        "master-css-source-directive": {
            "begin": "((@)master)(\\s+)(source)(?=\\s)",
            "end": "(;)|(?=\\})",
            "name": "meta.at-rule.master-css.source.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "support.type.property-name.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "source.css#comment-block"
                },
                {
                    "match": "\\b(exclude|force)\\b",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.master-css.css"
                        }
                    }
                },
                {
                    "include": "#master-css-directive-string-double"
                },
                {
                    "include": "#master-css-directive-string-single"
                }
            ]
        },
        "master-css-class-directive": {
            "begin": "((@)master)(\\s+)(class)(?=\\s)",
            "end": "(;)|(?=\\})",
            "name": "meta.at-rule.master-css.class.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "support.type.property-name.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "source.css#comment-block"
                },
                {
                    "match": "\\b(exclude)\\b",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.master-css.css"
                        }
                    }
                },
                {
                    "include": "#master-css-class-string-double"
                },
                {
                    "include": "#master-css-class-string-single"
                }
            ]
        },
        "master-css-directive-string-double": {
            "begin": "(\")",
            "end": "(\")",
            "name": "string.quoted.double.css",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.string.begin.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.string.end.css"
                }
            }
        },
        "master-css-directive-string-single": {
            "begin": "(')",
            "end": "(')",
            "name": "string.quoted.single.css",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.string.begin.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.string.end.css"
                }
            }
        },
        "master-css-class-string-double": {
            "begin": "(\")",
            "end": "(\")",
            "contentName": "meta.embedded.block.master-css.class",
            "beginCaptures": {
                "1": {
                    "name": "string.quoted.double.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "string.quoted.double.css"
                }
            },
            "patterns": [
                {
                    "include": "source.master-css"
                },
                {
                    "match": "(\\S)",
                    "captures": {
                        "1": {
                            "name": "string.quoted.double.css"
                        }
                    }
                }
            ]
        },
        "master-css-class-string-single": {
            "begin": "(')",
            "end": "(')",
            "contentName": "meta.embedded.block.master-css.class",
            "beginCaptures": {
                "1": {
                    "name": "string.quoted.single.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "string.quoted.single.css"
                }
            },
            "patterns": [
                {
                    "include": "source.master-css"
                },
                {
                    "match": "(\\S)",
                    "captures": {
                        "1": {
                            "name": "string.quoted.single.css"
                        }
                    }
                }
            ]
        },
        "master-css-block-body": {
            "patterns": [
                {
                    "include": "source.css#comment-block"
                },
                {
                    "include": "#master-css-standalone-directives"
                },
                {
                    "include": "#master-css-root-important"
                },
                {
                    "include": "#master-css-root-option-declaration"
                },
                {
                    "include": "#master-css-custom-property-declaration"
                },
                {
                    "include": "#master-css-keyframe-selector"
                },
                {
                    "include": "#master-css-native-at-rule-block"
                },
                {
                    "include": "#master-css-nested-block"
                },
                {
                    "include": "source.css"
                }
            ]
        },
        "master-css-standalone-directives": {
            "patterns": [
                {
                    "include": "#master-css-compose"
                },
                {
                    "include": "#master-css-mode-block"
                },
                {
                    "include": "#master-css-at-block"
                },
                {
                    "include": "#master-css-custom-at"
                },
                {
                    "include": "#master-css-custom-selector"
                }
            ]
        },
        "master-css-mode-block": {
            "begin": "\\s*([_a-zA-Z][-_a-zA-Z0-9]*)(\\s*)(\\{)",
            "end": "(\\})",
            "name": "meta.block.mode.master-css.css",
            "beginCaptures": {
                "1": {
                    "name": "support.constant.property-value.css"
                },
                "3": {
                    "name": "punctuation.section.property-list.begin.bracket.curly.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.property-list.end.bracket.curly.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-nested-block-body"
                }
            ]
        },
        "master-css-compose": {
            "begin": "((@)compose)(?=\\s)",
            "end": "(;)|(?=\\})",
            "name": "meta.at-rule.compose.master-css.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.compose.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "source.css#comment-block"
                },
                {
                    "include": "#master-css-compose-string-double"
                },
                {
                    "include": "#master-css-compose-string-single"
                }
            ]
        },
        "master-css-compose-string-double": {
            "begin": "(\")",
            "end": "(\")",
            "contentName": "meta.embedded.block.master-css.class",
            "beginCaptures": {
                "1": {
                    "name": "string.quoted.double.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "string.quoted.double.css"
                }
            },
            "patterns": [
                {
                    "include": "source.master-css"
                },
                {
                    "match": "(\\S)",
                    "captures": {
                        "1": {
                            "name": "string.quoted.double.css"
                        }
                    }
                }
            ]
        },
        "master-css-compose-string-single": {
            "begin": "(')",
            "end": "(')",
            "contentName": "meta.embedded.block.master-css.class",
            "beginCaptures": {
                "1": {
                    "name": "string.quoted.single.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "string.quoted.single.css"
                }
            },
            "patterns": [
                {
                    "include": "source.master-css"
                },
                {
                    "match": "(\\S)",
                    "captures": {
                        "1": {
                            "name": "string.quoted.single.css"
                        }
                    }
                }
            ]
        },
        "master-css-at-block": {
            "begin": "((@)at)(\\s+)([^\\s{;]+)(\\s*)(\\{)",
            "end": "(\\})",
            "name": "meta.at-rule.at.master-css.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.at.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "support.constant.property-value.css"
                },
                "6": {
                    "name": "punctuation.section.at-rule.begin.bracket.curly.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.at-rule.end.bracket.curly.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-nested-block-body"
                }
            ]
        },
        "master-css-custom-at": {
            "begin": "((@)custom-at)(\\s+)([^\\s;]+)(\\s+)((@)(?:media|supports|container|layer|starting-style|keyframes))?",
            "end": "(;)|(?=\\})",
            "name": "meta.at-rule.custom-at.master-css.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.custom-at.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "variable.parameter.master-css.at-token.css"
                },
                "6": {
                    "name": "keyword.control.at-rule.css"
                },
                "7": {
                    "name": "punctuation.definition.keyword.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "source.css#comment-block"
                },
                {
                    "match": "(@)(media|supports|container|layer|starting-style|keyframes)\\b",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.keyword.css"
                        },
                        "2": {
                            "name": "keyword.control.at-rule.css"
                        }
                    }
                },
                {
                    "include": "source.css#media-query-list"
                },
                {
                    "include": "source.css#feature-query"
                }
            ]
        },
        "master-css-custom-selector": {
            "begin": "((@)custom-selector)(\\s+)((::[^\\s;]+)|(:[^\\s;]+))",
            "end": "(;)|(?=\\})",
            "name": "meta.at-rule.custom-selector.master-css.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.custom-selector.master-css.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "5": {
                    "name": "entity.other.attribute-name.pseudo-element.css"
                },
                "6": {
                    "name": "entity.other.attribute-name.pseudo-class.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "source.css#comment-block"
                },
                {
                    "include": "source.css#selector-innards"
                }
            ]
        },
        "master-css-native-at-rule-block": {
            "begin": "((@)(?:media|supports|container|layer|starting-style|keyframes))([^{};]*)(\\{)",
            "end": "(\\})",
            "name": "meta.at-rule.master-css.nested.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "3": {
                    "patterns": [
                        {
                            "include": "source.css#media-query-list"
                        },
                        {
                            "include": "source.css#feature-query"
                        },
                        {
                            "include": "source.css#selector-innards"
                        }
                    ]
                },
                "4": {
                    "name": "punctuation.section.at-rule.begin.bracket.curly.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.at-rule.end.bracket.curly.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-block-body"
                }
            ]
        },
        "master-css-nested-block": {
            "begin": "\\s*([^{};@\\s][^{};@]*?)(\\{)",
            "end": "(\\})",
            "name": "meta.block.master-css.css",
            "beginCaptures": {
                "1": {
                    "patterns": [
                        {
                            "include": "#master-css-keyframe-selector"
                        },
                        {
                            "match": "&",
                            "name": "entity.name.tag.css"
                        },
                        {
                            "include": "source.css#selector-innards"
                        },
                        {
                            "include": "#master-css-selector-token"
                        },
                        {
                            "match": "\\b[-\\w]+\\b",
                            "name": "entity.name.tag.css"
                        }
                    ]
                },
                "2": {
                    "name": "punctuation.section.property-list.begin.bracket.curly.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.property-list.end.bracket.curly.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-nested-block-body"
                },
                {
                    "include": "source.css#rule-list-innards"
                }
            ]
        },
        "master-css-managed-layer-block": {
            "begin": "((@)layer)(\\s+)(preset|components|utilities)(\\s*)(\\{)",
            "end": "(\\})",
            "name": "meta.at-rule.layer.master-css.css",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.css"
                },
                "2": {
                    "name": "punctuation.definition.keyword.css"
                },
                "4": {
                    "name": "entity.name.section.css"
                },
                "6": {
                    "name": "punctuation.section.at-rule.begin.bracket.curly.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.at-rule.end.bracket.curly.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-nested-block-body"
                }
            ]
        },
        "master-css-nested-block-body": {
            "patterns": [
                {
                    "include": "source.css#comment-block"
                },
                {
                    "include": "#master-css-standalone-directives"
                },
                {
                    "include": "#master-css-root-important"
                },
                {
                    "include": "#master-css-root-option-declaration"
                },
                {
                    "include": "#master-css-custom-property-declaration"
                },
                {
                    "include": "#master-css-keyframe-selector"
                },
                {
                    "include": "#master-css-native-at-rule-block"
                },
                {
                    "include": "#master-css-nested-block"
                },
                {
                    "include": "source.css#rule-list-innards"
                },
                {
                    "include": "source.css"
                }
            ]
        },
        "master-css-selector-token": {
            "patterns": [
                {
                    "match": "(::)([-_a-zA-Z][-_a-zA-Z0-9]*)",
                    "captures": {
                        "1": {
                            "name": "entity.other.attribute-name.pseudo-element.css punctuation.definition.entity.css"
                        },
                        "2": {
                            "name": "entity.other.attribute-name.pseudo-element.css"
                        }
                    }
                },
                {
                    "match": "(:)([-_a-zA-Z][-_a-zA-Z0-9]*)",
                    "captures": {
                        "1": {
                            "name": "entity.other.attribute-name.pseudo-class.css punctuation.definition.entity.css"
                        },
                        "2": {
                            "name": "entity.other.attribute-name.pseudo-class.css"
                        }
                    }
                }
            ]
        },
        "master-css-root-important": {
            "match": "(?<![-\\w])(!?important)(\\s*)(;)",
            "captures": {
                "1": {
                    "name": "keyword.other.important.css"
                },
                "3": {
                    "name": "punctuation.terminator.rule.css"
                }
            }
        },
        "master-css-root-option-declaration": {
            "begin": "(?<![-\\w])(root-size|base-unit|default-mode|mode-trigger|scope|modes)(\\s*)(:)",
            "end": "(;)|(?=\\})",
            "name": "meta.property-list.master-css.option.css",
            "beginCaptures": {
                "1": {
                    "name": "support.type.property-name.css"
                },
                "3": {
                    "name": "punctuation.separator.key-value.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-property-value"
                }
            ]
        },
        "master-css-custom-property-declaration": {
            "begin": "(?<![-\\w])(--[-\\w]+)(\\s*)(:)",
            "end": "(;)|(?=\\})",
            "name": "meta.property-list.master-css.variable.css",
            "beginCaptures": {
                "1": {
                    "name": "variable.css"
                },
                "3": {
                    "name": "punctuation.separator.key-value.css"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.rule.css"
                }
            },
            "patterns": [
                {
                    "include": "#master-css-property-value"
                }
            ]
        },
        "master-css-property-value": {
            "patterns": [
                {
                    "include": "#master-css-variable-reference"
                },
                {
                    "include": "source.css#property-values"
                }
            ]
        },
        "master-css-variable-reference": {
            "match": "(\\$)([-\\w]+)((/)(\\d*\\.\\d+|\\d+))?",
            "captures": {
                "1": {
                    "name": "punctuation.definition.variable.css"
                },
                "2": {
                    "name": "variable.other.master-css.css"
                },
                "4": {
                    "name": "keyword.operator.css"
                },
                "5": {
                    "name": "constant.numeric.css"
                }
            }
        },
        "master-css-keyframe-selector": {
            "patterns": [
                {
                    "match": "(?i)\\b(from|to)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.other.keyframe-offset.css"
                        }
                    }
                },
                {
                    "match": "\\b\\d+(?:\\.\\d+)?%",
                    "name": "entity.other.keyframe-offset.percentage.css"
                }
            ]
        }
    }
}
