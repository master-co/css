{
  "name": "@master/css-language",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ../../shared/tsdown-package.config.ts && node scripts/restore-json-import-attributes.js",
    "dev": "tsdown --config ../../shared/tsdown-package.config.ts --watch",
    "type-check": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint",
    "test": "cargo xtask build-native && vitest"
  },
  "description": "Master CSS language primitives",
  "author": "Aoyue Design LLC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/css.git",
    "directory": "packages/language"
  },
  "dependencies": {
    "@master/css": "workspace:^",
    "@master/css-engine": "workspace:^",
    "@master/css-lexer": "workspace:^",
    "@master/css-native": "workspace:^",
    "@master/css-preset": "workspace:^",
    "lodash.escaperegexp": "^4.1.2",
    "mdn-data": "^2.28.1",
    "oxc-parser": "^0.137.0",
    "vscode-languageserver-protocol": "^3.18.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "@master/css-schema": "workspace:^",
    "@master/css-wasm-tooling": "workspace:^"
  },
  "devDependencies": {
    "@types/lodash.escaperegexp": "^4.1.9",
    "shiki": "^4.2.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "jsnext:main": "./dist/index.js",
  "esnext": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./shiki": {
      "types": "./dist/shiki.d.ts",
      "import": "./dist/shiki.js",
      "default": "./dist/shiki.js"
    },
    "./syntaxes/master-css.tmLanguage.json": "./syntaxes/master-css.tmLanguage.json"
  },
  "files": [
    "dist",
    "syntaxes"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
